@*
    Universal FinRiskLens AI chatbot — include once per layout. Pages give the
    bot their screen data by setting (before this partial renders its script):

        window.frlChatContext = {
            pageKey:  'UdyamDetails',                    // unique per screen
            pageName: 'Udyam Verification',              // used in the greeting
            context:  { ...full screen data object... }  // sent once, on first question
        };

    Pages that don't set it still get the generic assistant.
*@
<link rel="stylesheet" href="~/css/Chatbot.css" />

<div id="frlChatbot" class="frl-chatbot">

    <button id="frlChatLauncher" class="frl-chat-launcher" type="button" aria-label="Chat with FinRiskLens AI">
        <img src="~/ChatBot.gif" alt="" class="frl-chat-launcher-img" />
    </button>

    <div id="frlChatPanel" class="frl-chat-panel" role="dialog" aria-label="FinRiskLens AI Assistant">
        <div class="frl-chat-header">
            <div class="frl-chat-avatar"><i class="bi bi-robot"></i></div>
            <div class="frl-chat-head-text">
                <div class="frl-chat-title">FinRiskLens AI Assistant</div>
                <div class="frl-chat-status"><span class="frl-status-dot"></span>Online</div>
            </div>
            <button id="frlChatClose" class="frl-chat-close" type="button" aria-label="Close chat">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div id="frlChatMessages" class="frl-chat-messages"></div>

        <div class="frl-chat-input">
            <input id="frlChatText" type="text" maxlength="500" autocomplete="off"
                   placeholder="Ask about this page…" />
            <button id="frlChatSend" type="button" aria-label="Send">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>

<script src="~/FRLScripts/Common/Chatbot.js"></script>
