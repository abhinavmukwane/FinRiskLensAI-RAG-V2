        hasData: @Json.Serialize(Model.HasData),
        uan: @Json.Serialize(uan),      // masked — raw identifiers never reach the client
        gstin: @Json.Serialize(gstin),  // masked
        filingPeriod: @Json.Serialize(Model.FilingPeriod),
        createdDate: @Json.Serialize(Model.CreatedDate),
        gstr2BResponseData: @Json.Serialize(Model.GSTR2BResponseData),
        gstr3BResponseData: @Json.Serialize(Model.GSTR3BResponseData)
    };

    // The page's single sample dataset (defined at the top of this view) for GSTAnalysis.js charts.
    window.frlGstDemo = {
        months: @Json.Serialize(sMonths),
        salesLakh: @Json.Serialize(sSales),
        purchasesLakh: @Json.Serialize(sPurchases),
        taxLakh: @Json.Serialize(sTax),
        suppliers: @Json.Serialize(sSuppliers.Select(s => new { name = s.Item1, share = Math.Round(s.Item2 * 100) })),
        outlookMonths: @Json.Serialize(sOutlookMonths),
        outlookLakh: @Json.Serialize(sOutlook),
        outlookUpperLakh: @Json.Serialize(sOutlookUpper),
        gstScore: @sScore,
        itcUtilization: @Json.Serialize(Math.Round(sItcUtil * 100, 1))
    };

    // Universal chatbot context: the same sample figures the page shows, labelled as sample.
    window.frlChatContext = {
        pageKey: 'GSTAnalysis',
        pageName: 'GST Analysis (Tax & Sales Compliance) page',
        context: {
            dataNote: 'All figures on this page are illustrative sample data for the demo, not this business\'s GST returns. No live GST API is connected, and nothing here has been validated.',
            gstin: @Json.Serialize(gstin),
            samplePeriod: 'Jan–Jun (sample year)',
            sampleMonthlySalesLakh: @Json.Serialize(sMonths.Zip(sSales).ToDictionary(x => x.First, x => x.Second)),
            sampleAnnualisedTurnoverLakh: @Json.Serialize(Math.Round(sAnnualised, 1)),
            sampleSalesGrowthVsLastYear: @Json.Serialize(P(sSalesGrowth, "0.0")),
            sampleFilingCompliance: @Json.Serialize($"{sReturnsFiled} of {sReturnsDue} returns filed, {sLateReturns} late"),
            sampleItcUtilization: @Json.Serialize(P(sItcUtil)),
            sampleTaxPaidLakh: @Json.Serialize(new { total = sTaxTotal, cash = sTaxCash, itc = sTaxItc }),
            sampleTopSupplierShare: @Json.Serialize(P(sSuppliers[0].Item2)),
            sampleTop5SupplierShare: @Json.Serialize(P(sTop5))
        }
