@model FinRiskLensAI.Core.Models.GST.GSTAnalysisViewModel
@using FinRiskLensAI.Core.Common
@*
    Shared GST analysis body. Rendered by the customer page
    (Views/Dashboard/GSTAnalysis) and the bank portal Customer 360, so both
    show identical data. Identity is read from the model first so the view
    also renders for a bank officer, whose session holds no MSME user.
*@
<style>
    .stat-box {
        width: 100%;
        max-width: 150px;
        min-height: 90px;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        /* padding: 1rem; */
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .dash-table {
        table-layout: fixed;
        width: 100%;
    }

        .dash-table th,
        .dash-table td {
            white-space: normal;
            word-wrap: break-word;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #198754; /* bootstrap success green, matches text-success */
        display: inline-block;
        animation: blink-dot 1.5s ease-in-out infinite;
    }

    @@keyframes blink-dot {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.25;
    }

    }
</style>
@{

    // Prefer the model (set per-UAN by CustomerProfileBuilder) so this view also
    // renders for a bank officer, whose session holds no MSME user.
    var user = Context.Session.GetCurrentUser();
    var enterpriseName = Model.EnterpriseName ?? user?.NameOfEnterprise ?? "Not available";

    // Sensitive identifiers are always rendered masked (Universal maskers —
    // the same helpers UdyamController uses; never show the raw values here).
    var gstin = Universal.MaskGstin(Model.Gstin ?? user?.GstinNumber ?? "27AAAAA1111A1Z1");
    var pan = Universal.MaskPan(Model.PanNumber ?? user?.PanNumber ?? "AAAAA1111A");
    var uan = Universal.MaskUdyam(Model.Uan ?? "UDYAM-MH-20-0033382");

    // ── One illustrative sample dataset for the whole page (no live GST API yet) ──
    // Every card, chart and sentence reads from here, so the figures stay consistent.
    // Amounts are ₹ lakh; the period is Jan–Jun of one financial year.
    string[] sMonths = { "Jan", "Feb", "Mar", "Apr", "May", "Jun" };
    double[] sSales = { 84, 90, 105, 112, 122, 130 };           // outward supplies (GSTR-3B)
    double[] sPurchases = { 62, 65, 78, 80, 85, 92 };           // inward supplies (GSTR-2B)
    double[] sTax = { 4.2, 4.5, 5.2, 5.6, 6.1, 6.5 };           // tax liability (GSTR-3B), paid in full
    const double sPriorSales = 543, sPriorPurchases = 412.5;    // same months of the previous year
    const double sCashShare = 0.29;                             // tax paid directly in cash
    const double sRcm = 1.2;                                    // reverse charge, paid in cash
    const double sItcAvailable = 23.5;                          // ITC available in GSTR-2B
    const int sReturnsDue = 12, sReturnsFiled = 12, sLateReturns = 0;   // GSTR-1 + GSTR-3B, 6 months
    const int sB2bCustomers = 126, sActiveSuppliers = 82;
    const double sR1Vs3bMatch = 0.992;
    const double sOutlookGrowth = 0.16;                         // illustrative: June sales to next June
    const int sScore = 94;                                      // illustrative GST score (no formula behind it)
    var sSuppliers = new[] { ("Supplier A (sample)", 0.28), ("Supplier B (sample)", 0.18), ("Supplier C (sample)", 0.13),
                             ("Supplier D (sample)", 0.06), ("Supplier E (sample)", 0.04) };

    var sSalesTotal = sSales.Sum();
    var sPurchaseTotal = sPurchases.Sum();
    var sAnnualised = sSalesTotal / sSales.Length * 12;
    var sSalesGrowth = sSalesTotal / sPriorSales - 1;
    var sPurchaseGrowth = sPurchaseTotal / sPriorPurchases - 1;
    var sMonthsUp = sSales.Zip(sSales.Skip(1), (a, b) => b > a).Count(up => up);
    var sTaxTotal = sTax.Sum();
    var sTaxCash = Math.Round(sTaxTotal * sCashShare, 1);
    var sTaxItc = Math.Round(sTaxTotal - sTaxCash, 1);          // ITC used = ITC claimed
    var sItcUtil = sTaxItc / sItcAvailable;
    var sItcUnclaimed = Math.Round(sItcAvailable - sTaxItc, 1);
    var sFiling = (double)sReturnsFiled / sReturnsDue;
    var sTop5 = sSuppliers.Sum(s => s.Item2);
    var sOutlook = Enumerable.Range(1, 12).Select(k => Math.Round(sSales[^1] * (1 + sOutlookGrowth * k / 12), 1)).ToArray();
    var sOutlookUpper = sOutlook.Select(v => Math.Round(v * 1.06, 1)).ToArray();
    string[] sOutlookMonths = { "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar", "Apr", "May", "Jun" };

    string L(double lakh) => lakh >= 100 ? $"₹{lakh / 100:0.0} Cr" : $"₹{lakh:0.0} Lakh";
    string P(double v, string fmt = "0") => (v * 100).ToString(fmt) + "%";
    string Signed(double v, string fmt = "0") => (v >= 0 ? "+" : "") + P(v, fmt);
}


@*
