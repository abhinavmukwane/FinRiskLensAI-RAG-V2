@* Compact theme toggle — sits beside the Bhashini translation button.
   Clicking switches Theme 1 (IDBI teal/orange) <-> Theme 2 (classic maroon).
   Requires ~/css/theme.css and ~/js/theme.js (linked in the layout <head>). *@
<button type="button" class="frl-theme-toggle" data-frl-theme-toggle
        title="Switch colour theme" aria-label="Switch colour theme">
    <span class="frl-theme-dot"></span>
</button>
