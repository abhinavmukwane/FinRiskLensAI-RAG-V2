@model FinRiskLensAI.Core.Models.Admin.BankCustomerDetailViewModel
@using FinRiskLensAI.Core.Models.Cases
@using FinRiskLensAI.Fraud.Credit
@*
    Risk Lens — one customer's fraud and risk assessment, section by section
    (Doc/12_CUSTOMER_RISK_LENS.md §4). Findings come from the customer's one assessment; the
    section summaries from the same source data the other tabs show.
*@
@{
    var risk = Model.Risk;
    var app = risk?.Application;
    var findings = risk?.Findings ?? Array.Empty<Finding>();
    var open = findings.Where(f => f.ReviewStatus == ReviewStatus.Open).ToList();
    var standing = findings.Where(f => f.ReviewStatus != ReviewStatus.Dismissed).ToList();   // open or confirmed
    int Open(FindingSeverity s) => open.Count(f => f.Severity == s);
    var assessing = app != null && (app.Status == CaseStatus.Processing || app.Documents.Any(d => d.ExtractStatus == ExtractStatus.Pending));
    var verdict = app == null ? RiskVerdict.AwaitingData : RiskSummary.Of(app, findings);
    var docsById = app?.Documents.ToDictionary(d => d.CaseDocumentID) ?? new Dictionary<int, CaseDocument>();
    var back = Url.Action("Customer", "BankAdmin", new { uan = Model.Uan, tab = "risk" });

    static string Chip(RiskVerdict v) => v switch
    {
        RiskVerdict.Clear => "bp-case-clear", RiskVerdict.Review => "bp-case-review", RiskVerdict.HighRisk => "bp-case-hold",
        RiskVerdict.Assessing => "bp-case-processing", _ => "bp-case-new"
    };
    string Money(decimal v) => "₹" + v.ToString("N0", new System.Globalization.CultureInfo("en-IN"));

    // Section status: Flag on a standing High, Watch on any other standing finding, otherwise what the data allows
    (string Label, string Css) Status(string key, bool shared)
    {
        var mine = standing.Where(f => RiskSections.Of(f.Type) == key).ToList();
        if (mine.Any(f => f.Severity == FindingSeverity.High)) return ("Flag", "bp-case-hold");
        if (mine.Count > 0) return ("Watch", "bp-case-review");
        return shared ? ("No findings", "bp-case-clear") : ("Not shared", "bp-case-new");
    }

    var aa = Model.Aa; var mca = Model.Mca; var udyam = Model.Udyam;
    var sections = new List<(string Key, string Icon, string Title, string Tab, bool Shared, string Summary)>
    {
        (RiskSections.Identity, "bi-person-vcard", "Identity", "udyam", udyam?.HasData == true,
            udyam?.HasData == true
                ? $"{udyam.EnterpriseName} · {udyam.OrganizationType} · Udyam since {udyam.RegistrationDate:MMM yyyy}"
                  + (mca == null || !mca.IsApplicable ? "" : mca.HasData ? $" · MCA: {mca.Status}" : " · MCA not fetched")
                : "Udyam profile not available"),
        (RiskSections.Gst, "bi-receipt", "GST", "gst", Model.Gst?.HasData == true,
            Model.Gst?.HasData == true ? $"Returns shared{(string.IsNullOrWhiteSpace(Model.Gst.FilingPeriod) ? "" : $" · period {Model.Gst.FilingPeriod}")}" : "GST returns not shared yet"),
        (RiskSections.Bank, "bi-bank", "Bank conduct", "aa", aa?.HasData == true || app?.Documents.Any(d => d.DocType == CaseDocType.BankStatement) == true,
            aa?.HasData == true
                ? $"Account Aggregator: {aa.MonthsCovered} months, {aa.TransactionCount} transactions, average monthly credit {Money(aa.AvgMonthlyCredit)}"
                : "Account Aggregator not linked — uploaded statements only"),
        (RiskSections.Itr, "bi-file-earmark-text", "ITR", "itr", Model.Itr?.HasData == true || app?.Documents.Any(d => d.DocType == CaseDocType.Itr) == true,
            Model.Itr?.HasData == true
                ? $"{Model.Itr.FormType} · assessment year {Model.Itr.AssessmentYear}" + (app?.Documents.Any(d => d.DocType == CaseDocType.Itr) == true ? " · ITR copy uploaded" : "")
                : (app?.Documents.Any(d => d.DocType == CaseDocType.Itr) == true ? "Uploaded ITR copy on file · registry return not fetched" : "ITR not shared yet")),
        (RiskSections.Network, "bi-diagram-3", "Network", "", true,
            findings.Any(f => f.Type == "FRAUD_RING") ? "Linked to other customers — see the finding below" : "No links to other customers")
    };
}

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
        <div>@err</div>
    </div>
}

@* ── Verdict ─────────────────────────────────────────────────────────────── *@
<div class="bp-card rl-verdict">
    <div class="rl-verdict-main">
        <span class="bp-case-status @Chip(verdict) rl-verdict-chip">@RiskSummary.Label(verdict)</span>
        <div>
            @if (app == null)
            {
                <div class="bp-strong">Not assessed yet</div>
                <div class="bp-muted">Assessments start on their own when the customer shares data or uploads documents. Data shared earlier can be assessed now.</div>
            }
            else
            {
                <div class="bp-strong">
                    @(open.Count == 0 ? "No open findings" : $"{Open(FindingSeverity.High)} High · {Open(FindingSeverity.Medium)} Medium · {Open(FindingSeverity.Low)} Low open")
                    <span class="bp-muted">· @(findings.Count - open.Count) reviewed · @app.Documents.Count document@(app.Documents.Count == 1 ? "" : "s")</span>
                </div>
                <div class="bp-muted">
                    @if (verdict == RiskVerdict.Clear)
                    {
                        <span><i class="bi bi-check2-circle"></i> No open risk — this customer can go forward to a loan case.</span>
                    }
                    else if (verdict == RiskVerdict.AwaitingData)
                    {
                        <span><i class="bi bi-bank"></i> No bank evidence yet — the customer shares bank data through Account Aggregator or uploads statements.</span>
                    }
                    else if (verdict == RiskVerdict.Assessing)
                    {
                        <span><i class="bi bi-hourglass-split"></i> Reading and checking the latest documents — this page refreshes until done.</span>
                    }
                    else
                    {
                        <span><i class="bi bi-slash-circle"></i> A loan case waits until every finding is reviewed — a confirmed finding blocks it, a dismissed one does not.</span>
                    }
                    @if (app.InvestigatedAt != null)
                    {
                        <span> · AI investigation @app.InvestigatedAt.Value.ToString("dd MMM yyyy HH:mm") UTC by @app.InvestigatedBy</span>
                    }
                </div>
            }
        </div>
    </div>
    @if (app == null)
    {
        <form method="post" asp-controller="BankAdmin" asp-action="Assess" asp-route-uan="@Model.Uan">
            <button type="submit" class="bp-btn bp-btn-sm"><i class="bi bi-play-circle"></i> Assess shared data</button>
        </form>
    }
    else
    {
        <div class="bp-findings-actions">
            <form method="post" asp-controller="RiskLens" asp-action="RunChecks" asp-route-id="@app.LoanApplicationID">
                <input type="hidden" name="returnUrl" value="@back" />
                <button type="submit" class="bp-btn bp-btn-ghost bp-btn-sm"><i class="bi bi-arrow-repeat"></i> Re-run checks</button>
            </form>
            <form method="post" asp-controller="RiskLens" asp-action="Investigate" asp-route-id="@app.LoanApplicationID">
                <input type="hidden" name="returnUrl" value="@back" />
                <button type="submit" class="bp-btn bp-btn-sm" @(assessing ? "disabled" : "")><i class="bi bi-robot"></i> Run investigation</button>
            </form>
        </div>
    }
</div>
@if (assessing)
{
    <meta http-equiv="refresh" content="8" />
}

@* ── Loan case: the AI credit decision, once Clear (Doc/13_TEAM_WORK_PLAN.md T9) ── *@
@if (verdict == RiskVerdict.Clear)
{
    var d = Model.Decision;
    var web = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
    var outcomeCss = d?.Outcome switch { CreditOutcome.Approve => "bp-case-clear", CreditOutcome.Decline => "bp-case-hold", _ => "bp-case-review" };
    <section class="bp-card rl-section" id="rl-loan">
        <div class="rl-section-head">
            <span class="bp-strong"><i class="bi bi-cash-stack"></i> Loan case</span>
            @if (d != null) { <span class="bp-case-status @outcomeCss">@d.Outcome</span> }
        </div>
        <p class="bp-muted rl-summary">The AI decides within the credit capacity computed from bank and ITR data under the credit policy. Every figure is checked against that capacity before it is shown.</p>
        @if (TempData["CreditError"] is string creditError)
        {
            <div class="bp-alert"><i class="bi bi-exclamation-triangle-fill"></i>@creditError</div>
        }
        <form method="post" asp-controller="BankAdmin" asp-action="DecideCredit" asp-route-uan="@Model.Uan" class="bp-form-grid rl-loan-form">
            <label><span>Product</span>
                <select name="product" class="bp-select">
                    <option value="WorkingCapital">Working capital</option>
                    <option value="TermLoan" selected="@(d?.Product == LoanProduct.TermLoan)">Term loan</option>
                </select>
            </label>
            <label><span>Amount (₹)</span><input name="amount" type="number" min="1" step="1" required class="bp-select" value="@d?.RequestedAmount.ToString("0")" /></label>
            <label><span>Tenure (months)</span><input name="tenureMonths" type="number" min="1" max="360" required class="bp-select" value="@(d?.TenureMonths ?? 36)" /></label>
            <label><span>Rate (% a year)</span><input name="ratePct" type="number" min="0.01" max="50" step="0.01" required class="bp-select" value="@((d?.RatePct ?? 11m).ToString("0.##"))" /></label>
            <div class="bp-form-actions"><button type="submit" class="bp-btn bp-btn-sm"><i class="bi bi-stars"></i> @(d == null ? "Generate" : "Regenerate") credit decision</button></div>
        </form>

        @if (d != null)
        {
            var cap = System.Text.Json.JsonSerializer.Deserialize<CreditCapacity>(d.Capacity, web);
            var reasons = System.Text.Json.JsonSerializer.Deserialize<List<DecisionReason>>(d.Reasons, web) ?? new();
            var conditions = System.Text.Json.JsonSerializer.Deserialize<List<string>>(d.Conditions, web) ?? new();
            var dropped = System.Text.Json.JsonSerializer.Deserialize<List<DroppedReason>>(d.Dropped, web) ?? new();
            <div class="rl-decision">
                <div class="bp-strong">
                    @(d.Outcome == CreditOutcome.Decline ? "Decline" : $"{d.Outcome} · {Money(d.RecommendedAmount)}")
                    <span class="bp-muted">· @(d.Product == LoanProduct.TermLoan ? "Term loan" : "Working capital"), @d.TenureMonths months at @d.RatePct.ToString("0.##")% · requested @Money(d.RequestedAmount)</span>
                </div>
                <div class="bp-muted bp-investigated">@d.Model · @d.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC by @d.CreatedBy</div>
                @if (cap != null)
                {
                    <dl class="rl-figures">
                        <div><dt>Bank monthly income</dt><dd>@Money(cap.BankMonthlyIncome)</dd></div>
                        <div><dt>ITR monthly income</dt><dd>@Money(cap.ItrMonthlyIncome)</dd></div>
                        <div><dt>Assessed monthly income</dt><dd>@Money(cap.AssessedMonthlyIncome)</dd></div>
                        <div><dt>FOIR limit</dt><dd>@cap.MaxFoirPct.ToString("0.#")%</dd></div>
                        <div><dt>Existing EMIs</dt><dd>@Money(cap.ExistingMonthlyEmi)</dd></div>
                        <div><dt>Room for a new EMI</dt><dd>@Money(cap.MaxNewMonthlyEmi)</dd></div>
                        <div><dt>EMI of the request</dt><dd>@Money(cap.RequestedMonthlyEmi)</dd></div>
                        <div><dt>FOIR with the request</dt><dd>@cap.FoirWithRequestedPct.ToString("0.#")%</dd></div>
                        <div><dt>Eligible amount</dt><dd>@Money(cap.EligibleAmount)</dd></div>
                        <div><dt>Maximum loan</dt><dd>@Money(cap.MaxLoanAmount)@(cap.AuditCapAmount != null ? " (tax audit cap)" : "")</dd></div>
                    </dl>
                    @if (cap.PolicyClauses.Count > 0)
                    {
                        <div class="bp-muted bp-investigated">Credit policy applied: @string.Join(", ", cap.PolicyClauses)</div>
                    }
                }
                @if (reasons.Count > 0)
                {
                    <ul class="rl-reasons">
                        @foreach (var r in reasons)
                        {
                            <li>@r.Text @if (r.Sources.Count > 0) { <span class="bp-policy">— @string.Join("; ", r.Sources)</span> }</li>
                        }
                    </ul>
                }
                @if (conditions.Count > 0)
                {
                    <div class="bp-strong">Conditions</div>
                    <ul class="rl-reasons">@foreach (var c in conditions) { <li>@c</li> }</ul>
                }
                @if (dropped.Count > 0)
                {
                    <details class="bp-rejected">
                        <summary><i class="bi bi-shield-x"></i> @dropped.Count AI point@(dropped.Count == 1 ? "" : "s") removed by grounding verification</summary>
                        <ul>@foreach (var x in dropped) { <li>@x.Text — <span class="bp-muted">@x.Why</span></li> }</ul>
                    </details>
                }

                @if (d.AcceptedAt != null)
                {
                    <div class="rl-accept">
                        <span class="bp-case-status bp-case-clear"><i class="bi bi-check2-circle"></i> Accepted</span>
                        <span>@Money(d.AcceptedAmount ?? 0) by @d.AcceptedBy on @d.AcceptedAt.Value.ToString("dd MMM yyyy HH:mm") UTC — ready to push to LOS / ULI / ONDC.</span>
                    </div>
                }
                else if (d.Outcome == CreditOutcome.Approve)
                {
                    <form method="post" asp-controller="BankAdmin" asp-action="AcceptCredit" asp-route-uan="@Model.Uan" class="rl-accept">
                        <input type="hidden" name="creditDecisionId" value="@d.CreditDecisionID" />
                        <label class="bp-muted" for="rl-accept-amount">Sanction amount (₹, up to the recommended)</label>
                        <input id="rl-accept-amount" name="amount" type="number" min="1" max="@d.RecommendedAmount.ToString("0")" step="1" required class="bp-select" value="@d.RecommendedAmount.ToString("0")" />
                        <button type="submit" class="bp-btn bp-btn-sm"><i class="bi bi-check2"></i> Accept decision</button>
                    </form>
                }
            </div>
        }
    </section>
}

@* ── Sources ───────────────────────────────────────────────────────────────── *@
<div class="rl-grid">
    @foreach (var s in sections)
    {
        var (label, css) = Status(s.Key, s.Shared);
        var mine = findings.Where(f => RiskSections.Of(f.Type) == s.Key).ToList();
        <section class="bp-card rl-section @(mine.Count > 0 ? "rl-has-findings" : "")" id="rl-@s.Key">
            <div class="rl-section-head">
                <span class="bp-strong"><i class="bi @s.Icon"></i> @s.Title</span>
                <span class="bp-case-status @css">@label</span>
            </div>
            <p class="bp-muted rl-summary">@s.Summary</p>
            @if (!string.IsNullOrEmpty(s.Tab))
            {
                <a class="bp-link rl-more" href="@Url.Action("Customer", "BankAdmin", new { uan = Model.Uan, tab = s.Tab })">Details <i class="bi bi-arrow-right-short"></i></a>
            }
            @foreach (var f in mine)
            {
                @await Html.PartialAsync("_FindingCard", new FindingCardModel(f, docsById, app!.LoanApplicationID, back))
            }
        </section>
    }
</div>

@* ── Uploaded documents: the checks on the documents themselves ─────────────── *@
<section class="bp-card rl-section" id="rl-documents">
    <div class="rl-section-head">
        <span class="bp-strong"><i class="bi bi-files"></i> Uploaded documents</span>
        @{ var (dLabel, dCss) = Status(RiskSections.Documents, app?.Documents.Count > 0); }
        <span class="bp-case-status @dCss">@dLabel</span>
    </div>
    @if (app == null || app.Documents.Count == 0)
    {
        <p class="bp-muted rl-summary">No documents uploaded by the customer yet.</p>
    }
    else
    {
        <div class="bp-table-wrap">
            <table class="bp-table">
                <thead><tr><th>File</th><th>Type</th><th>Pages</th><th>Reading</th></tr></thead>
                <tbody>
                    @foreach (var d in app.Documents)
                    {
                        <tr>
                            <td>
                                <a class="bp-link bp-strong" target="_blank" rel="noopener"
                                   href="@Url.Action("Document", "RiskLens", new { id = app.LoanApplicationID, docId = d.CaseDocumentID })">
                                    <i class="bi @(d.ContentType == "application/pdf" ? "bi-file-earmark-pdf" : "bi-file-earmark-image")"></i> @d.FileName
                                </a>
                            </td>
                            <td>@d.DocType</td>
                            <td>@(d.PageCount?.ToString() ?? "—")</td>
                            <td>
                                @if (d.ExtractStatus == ExtractStatus.Pending) { <span class="bp-case-status bp-case-processing">Reading</span> }
                                else if (d.ExtractStatus == ExtractStatus.Done) { <span class="bp-case-status bp-case-clear">Read</span> }
                                else { <span class="bp-case-status bp-case-hold" title="@d.ExtractError">Unreadable</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var f in findings.Where(f => RiskSections.Of(f.Type) == RiskSections.Documents))
        {
            @await Html.PartialAsync("_FindingCard", new FindingCardModel(f, docsById, app.LoanApplicationID, back))
        }
    }
</section>

@* ── What the AI was not allowed to claim ──────────────────────────────────── *@
@if (risk?.RejectedClaims.Count > 0)
{
    <details class="bp-rejected bp-card">
        <summary>
            <i class="bi bi-shield-x"></i>
            @risk.RejectedClaims.Count AI claim@(risk.RejectedClaims.Count == 1 ? "" : "s") rejected by grounding verification
        </summary>
        <p class="bp-muted">
            Proposed by the investigator and discarded before anyone could act on them, because they could not be
            traced to this customer's data. Shown for transparency; they are not findings.
        </p>
        <ul>
            @foreach (var d in risk.RejectedClaims)
            {
                <li class="bp-muted">@d.Reason</li>
            }
        </ul>
    </details>
}
