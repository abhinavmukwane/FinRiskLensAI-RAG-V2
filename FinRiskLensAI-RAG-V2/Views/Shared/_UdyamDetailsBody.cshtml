@model FinRiskLensAI.Core.Models.Onboarding.UdyamDetailsViewModel
@*
    Shared Udyam "Business Identity & Trust Analysis" body. Rendered by the
    customer page (Views/Udyam/UdyamDetails) and the bank portal Customer 360,
    so both show identical data. Caller supplies layout and page chrome.
*@

@*
    Presentation view. The score and parsed fields are computed in
    UdyamController.BuildAnalysis from the Udyam response cached in
    m_StaticResponces. The labels here (strengths, timeline legend,
    de-duplicated plant list) are derived only from fields the record
    carries, so nothing reads as verified that isn't. Page behavior lives
    in ~/FRLScripts/Udyam/UdyamDetails.js.
*@

@if (!Model.HasData)
{
    <div class="container-fluid py-4 udyam-dashboard">
        <div class="alert alert-danger rounded-4">
            @(Model.LoadError ?? "No Udyam data is available for your account.")
        </div>
    </div>
    return;
}

@{
    // Presentation only: every label below is derived from fields the Udyam record
    // actually carries. The score formula itself lives in UdyamController.BuildAnalysis.
    string Fmt(DateTime d) => d == default ? "Not available" : d.ToString("d MMM yyyy");

    var history = Model.EnterpriseTypeHistory;
    var historyUnchanged = history.Count > 1 && history.Select(e => e.Type).Distinct().Count() == 1;

    // A unit repeated with the same name and address is one location, not two
    var plants = Model.PlantLocations
        .GroupBy(l => (l.UnitName, l.City, l.District, l.State))
        .Select(g => g.First())
        .ToList();
    var duplicatePlants = Model.PlantLocations.Count - plants.Count;

    var strengths = new List<string>();
    if (Model.IsRegistered) strengths.Add($"Business registration (Udyam) on record (registered {Fmt(Model.RegistrationDate)})");
    if (Model.DateOfCommencement != default) strengths.Add($"Operating since {Model.DateOfCommencement.Year} ({Model.BusinessAgeYears} years)");
    if (historyUnchanged) strengths.Add($"Same enterprise classification ({Model.LatestEnterpriseType}) in all {history.Count} recorded years");
    if (plants.Count > 1) strengths.Add($"{plants.Count} registered business locations");
    if (Model.OrganizationType.Equals("Public Limited Company", StringComparison.OrdinalIgnoreCase)) strengths.Add("Public limited company");
    if (Model.DistinctNicCodes > 1) strengths.Add($"{Model.DistinctNicCodes} distinct NIC activity codes registered");

    // Listed on the record but not checked against GST or PAN records: shown apart from the strengths
    var listedOnly = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Gstin)) listedOnly.Add("GSTIN listed on the Udyam record");
    if (!string.IsNullOrWhiteSpace(Model.Pan)) listedOnly.Add("PAN listed on the Udyam record");
}

<div class="container-fluid py-4 udyam-dashboard">

    <!-- ===== PAGE HEADER — MCA's layout (score, then text, buttons last),
         GST/AA's light card+gauge colors ===== -->
    <div class="info-header-card info-header-dark d-flex flex-column flex-lg-row align-items-lg-center gap-4">
        <div class="hero-score-ring" title="Registration profile score: rule-based points for business age, classification history, plant locations, NIC activities, organization type, and a GSTIN and PAN on the Udyam record. Not a credit score.">

            <svg viewBox="0 0 120 120">
                <circle class="gauge-track" cx="60" cy="60" r="54"></circle>
                <circle class="gauge-progress" cx="60" cy="60" r="54"
                        style="stroke-dasharray:339; stroke-dashoffset:@(339 - 339 * Model.BusinessIdentityScore / 100);"></circle>
            </svg>
            <div class="score-value">
                <span>@Model.BusinessIdentityScore</span>
                <small>/ 100</small>
            </div>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 verified-tag mb-1">
                @* <i class="bi bi-patch-check-fill"></i>
                <span>UDYAM REGISTRATION @Model.RegistrationStatus.ToUpper()</span> *@
                <span style="font-size:12px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; opacity:0.7;">
                    @if (Model.IsRegistered)
                    {
                        <i class="bi bi-file-earmark-text me-1"></i><text>BUSINESS REGISTRATION (UDYAM) ON RECORD</text>
                    }
                    else
                    {
                        <i class="bi bi-dash-circle me-1"></i><text>REGISTRATION DATE NOT AVAILABLE</text>
                    }
                </span>
            </div>

            @* The customer page sets its own heading; the bank's Customer 360 keeps the default *@
            <h3 class="fhc-title mb-1">@(ViewData["UdyamHeading"] as string ?? "Udyam Registration Profile")</h3>
            <p class="fhc-sub mb-0">@Model.EnterpriseName &middot; Udyam Registration Number: <span id="udyamRegNumber">@Model.Uan</span></p>
            <p class="fhc-sub mb-0 mt-1" style="font-size:12px; opacity:.85;">
                Registration profile score, rule-based, from the Udyam record (India's Government MSME Business Registry) only. It confirms business identity and registration context, not creditworthiness.
            </p>
        </div>
        @* <div class="d-flex flex-column gap-2 flex-shrink-0">
            <button id="btnDownloadReport" type="button" class="btn" style="background:#fff; color:var(--theme-maroon); border:1px solid #fff; border-radius:10px; padding:9px 18px; font-weight:600;">
                <i class="bi bi-download me-1"></i> Download Report
            </button>
            <button id="btnRefreshData" type="button" class="btn" style="background:var(--brand-primary-deep); color:#fff; border:1px solid rgba(255,255,255,.35); border-radius:10px; padding:9px 18px; font-weight:600;">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
        </div> *@
    </div>

    <div class="row g-4">

        <!-- Business Identity, Strengths, Timeline Grouped — was alongside a
             "Business Identity Score" card, removed since the header's own
             gauge already shows the score. -->
        <div class="col-12 d-flex flex-column gap-4">
            <div class="row g-4">
                <!-- Business Identity Card -->
                <div class="col-12 col-md-6">
                    <div class="dash-card h-100">
                        <h6 class="card-heading"><i class="bi bi-building me-2"></i>Business Identity</h6>
                        <ul class="profile-list list-unstyled mb-0">
                            <li><span>Business Name</span><strong class="text-end">@Model.EnterpriseName</strong></li>
                            <li><span>Enterprise Classification</span><strong>@(Model.LatestEnterpriseType == "-" ? "Not available" : Model.LatestEnterpriseType)</strong></li>
                            <li>
                                <span>Business Age</span>
                                <strong class="text-end" title="Counted from the date of commencement on the Udyam record, or the date of incorporation when commencement is missing. Not from the registration date.">
                                    @(Model.DateOfCommencement == default
                                        ? "Not available"
                                        : $"{Model.BusinessAgeYears} years (since {Fmt(Model.DateOfCommencement)})")
                                </strong>
                            </li>
                            <li><span>Registration Date</span><strong>@Fmt(Model.RegistrationDate)</strong></li>
                            <li><span>Organization Type</span><strong class="text-end">@Model.OrganizationType</strong></li>
                            <li class="no-border"><span>Primary Business Activity</span><strong>@Model.MajorActivity</strong></li>
                        </ul>
                    </div>
                </div>

                <!-- Strengths -->
                <div class="col-12 col-md-6">
                    <div class="dash-card h-100">
                        <div class="fhc-section-label mb-0" style="padding-bottom: 12px;"><i class="bi bi-shield-check me-2"></i>Identified Strengths</div>
                        @* <h6 class="card-heading"><i class="bi bi-shield-check me-2"></i>Identified Strengths</h6> *@
                        <p class="small text-muted mb-2">From the Udyam record. GSTIN and PAN are listed, not independently verified here.</p>
                        <ul class="signal-list list-unstyled mb-0">
                            @foreach (var s in strengths)
                            {
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <div><p class="signal-title mb-0">@s</p></div>
                                </li>
                            }
                            @if (strengths.Count == 0)
                            {
                                <li><div><p class="signal-title mb-0 text-muted">No strengths can be confirmed from the Udyam record.</p></div></li>
                            }
                            @foreach (var s in listedOnly)
                            {
                                <li>
                                    <i class="bi bi-info-circle text-muted" aria-hidden="true"></i>
                                    <div><p class="signal-title mb-0">@s <span class="text-muted fw-normal">· not checked</span></p></div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Classification Timeline -->
            <div class="dash-card glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    @* <div class="fhc-section-label mb-0"><i class="bi bi-bank me-1"></i>Bank Lending Assessment</div> *@
                    <div class="fhc-section-label mb-0"><i class="bi bi-calendar3 me-2"></i>Enterprise Classification Timeline</div>
                    <span class="legend"><span class="legend-dot"></span>
                        @(history.Count == 0 ? "No history on record"
                          : history.Count == 1 ? "Current classification only"
                          : historyUnchanged ? $"Unchanged across {history.Count} records"
                          : "Classification changed")
                    </span>
                </div>
                <div class="classification-timeline">
                    @foreach (var entry in history)
                    {
                        <div class="timeline-step">
                            <div class="timeline-dot"></div>
                            <div class="timeline-year">@entry.Year</div>
                            <div class="timeline-type">@entry.Type</div>
                        </div>
                    }
                </div>
                @if (history.Count <= 1)
                {
                    <p class="small text-muted mb-0 mt-3">
                        @(history.Count == 0
                            ? "The Udyam record has no classification entries."
                            : "The Udyam record holds only the current classification. Earlier years aren't available, so stability can't be assessed.")
                    </p>
                }
            </div>
        </div>

        <!-- Location Summary -->
        <div class="col-12 col-md-6">
            <div class="dash-card compliance-card h-100">
                <div class="fhc-section-label">Location Summary</div>
                <ul class="mini-list">
                    <li><span>State</span><strong>@(Model.State == "-" ? "Not available" : Model.State)</strong></li>
                    <li><span>District (first plant)</span><strong>@(Model.District == "-" ? "Not available" : Model.District)</strong></li>
                    <li><span>City</span><strong>@(Model.City == "-" ? "Not available" : Model.City)</strong></li>
                    <li><span>PIN</span><strong>@(Model.Pin == "-" ? "Not available" : Model.Pin)</strong></li>
                    <li><span>Registered Business Locations</span><strong>@plants.Count</strong></li>
                </ul>
                <p class="small text-muted mb-0 mt-2">Address as listed in the Udyam record. Not geolocation-verified.</p>
            </div>
        </div>

        <!-- Compliance Summary -->
        <div class="col-12 col-md-6">
            <div class="dash-card compliance-card h-100">
                <div class="fhc-section-label">Compliance Summary</div>
                <ul class="mini-list">
                    <li><span title="Tax & Sales Compliance (GST): Indian Goods and Services Tax records">GSTIN (listed on Udyam)</span><strong>@(string.IsNullOrWhiteSpace(Model.GstinMasked) ? "Not available" : Model.GstinMasked)</strong></li>
                    <li><span title="Taxpayer / Business Identity (PAN): Indian tax identity identifier">PAN (listed on Udyam)</span><strong>@(string.IsNullOrWhiteSpace(Model.PanMasked) ? "Not available" : Model.PanMasked)</strong></li>
                    <li><span>GST / PAN verification</span><strong>Not checked on this page</strong></li>
                    @if (Model.IsRegistered)
                    {
                        @* IsRegistered means the record carries a registration date; no live status check is made *@
                        <li><span>Business Registration (Udyam)</span><strong>On record</strong></li>
                    }
                    else
                    {
                        <li><span>Business Registration (Udyam)</span><strong>Not available</strong></li>
                    }
                </ul>
            </div>
        </div>

        <!-- Plant Location Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <div class="fhc-section-label mb-0"><i class="bi bi-geo-alt-fill me-2"></i>Registered Business Locations (@plants.Count)</div>
                <p class="small text-muted mb-2 mt-1">
                    Locations listed in the Udyam record. Not geolocation-verified.@(duplicatePlants > 0 ? $" {duplicatePlants} repeated entr{(duplicatePlants == 1 ? "y" : "ies")} hidden." : "")
                </p>
                @* <h6 class="card-heading"><i class="bi bi-geo-alt-fill me-2"></i>Registered Plant Locations (@Model.PlantLocations.Count)</h6> *@
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th>Unit Name</th><th>City</th><th>District</th><th>State</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var loc in plants)
                            {
                                <tr>
                                    <td>@loc.UnitName</td>
                                    <td>@loc.City</td>
                                    <td>@loc.District</td>
                                    <td>@loc.State</td>
                                </tr>
                            }
                            @if (plants.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No plant locations on the Udyam record.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- NIC Activities Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <div class="fhc-section-label mb-0"><i class="bi bi-diagram-3-fill me-2"></i>NIC Activities (@Model.NicActivities.Count)</div>
                <p class="small text-muted mb-2 mt-1">NIC: India's National Industrial Classification of business activities.</p>
                @* <h6 class="card-heading"><i class="bi bi-diagram-3-fill me-2"></i>NIC Activities (@Model.NicActivities.Count)</h6> *@
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th style="width:75px !important">NIC Code</th><th>Activity</th><th>Type</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var nic in Model.NicActivities)
                            {
                                <tr>
                                    <td>@nic.Code</td>
                                    <td style="white-space:normal; overflow-wrap:anywhere; min-width:160px;">@nic.Activity</td>
                                    <td><span class="pill-type">@nic.ActivityType</span></td>
                                </tr>
                            }
                            @if (Model.NicActivities.Count == 0)
                            {
                                <tr><td colspan="3" class="text-muted">No NIC activities on the Udyam record.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@* ================================================================
   Preserved verification modals (GST / Account Aggregator / ITR).
   Not currently triggered from this view since the launcher cards
   were replaced by the analysis dashboard above, but kept in place
   with existing IDs/markup intact for reuse (e.g. "Refresh Data",
   re-verification flows, or future wiring) without breaking any
   JS hooks already built against them.
   ================================================================ *@

<div class="modal fade" id="verificationModal" tabindex="-1"
     aria-labelledby="verificationModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title " id="verificationModalLabel">
                        Fetch GSTR Details
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label fw-semibold">User ID</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter User ID">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>Udyam Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="aaConsentModal" tabindex="-1" aria-labelledby="aaConsentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="aaConsentModalLabel">
                    Account Aggregator Consent
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mobile Number</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter Mobile Number">
                </div>
                <div class="consent-box">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize sharing of my bank account information for
                            verification purposes.
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="itrModal" tabindex="-1" aria-labelledby="itrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title" id="itrModalLabel">
                    <i class="bi bi-file-earmark-text-fill text-warning me-2"></i>
                    Income Tax Return Verification
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label fw-semibold">User ID</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter User ID">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>

<script>
    // Hand this screen's full analysis to the universal chatbot — it is sent
    // to the server only once, together with the first question.
    // Masked identifiers only, and the same source-backed strengths the page shows —
    // never the full PAN/GSTIN or the controller's free-text observation.
    window.frlChatContext = {
        pageKey: 'UdyamDetails',
        pageName: 'Udyam Registration Profile page',
        context: @Html.Raw(Json.Serialize(new
        {
            Model.Uan,
            Model.EnterpriseName,
            Model.OrganizationType,
            Model.MajorActivity,
            EnterpriseType = Model.LatestEnterpriseType,
            RegistrationDate = Fmt(Model.RegistrationDate),
            CommencementOrIncorporationDate = Fmt(Model.DateOfCommencement),
            Model.BusinessAgeYears,
            RegistrationOnRecord = Model.IsRegistered,
            RegistrationProfileScore = Model.BusinessIdentityScore,
            ScoreNote = "Rule-based registration profile score from the Udyam record only; not a credit score.",
            Model.GstinMasked,
            Model.PanMasked,
            GstPanVerification = "Not checked on this page; GSTIN and PAN are only listed on the Udyam record.",
            ClassificationHistory = history.Select(e => new { e.Year, e.Type }),
            PlantLocations = plants,
            Model.NicActivities,
            Strengths = strengths,
            ListedNotChecked = listedOnly,
            Model.State,
            Model.City,
            Model.Pin
        }))
    };
</script>
<script src="~/FRLScripts/Udyam/UdyamDetails.js"></script>
