                        </div>
                        <h4 class="h5 text-primary font-heading fw-bold">Findings in Seconds</h4>
                        <p class="small text-secondary mb-0">
                            The Gemini investigation agent reviews a customer's data and returns its findings with
                            evidence, measured on the synthetic demo set.
                        </p>
                    </div>
                    <div class="pt-4 border-top border-light mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="font-data small uppercase text-secondary">AI Investigation</span>
                            <span class="font-data small fw-bold text-secondary">12–43 s per customer</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-secondary" role="progressbar" style="width: 80%;"
                                 aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Explainable -->
