                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuB7gb6ryYHbGR6Uw8WjxXUV38px-69zbd-891aCZIOKJgoGpQstTGxZo-xXCA9bwDURZ-vOYJZpcVIpTeH6o5nokorKnekQgClS_ZykGYgtPMWd8apiiUYLVxiLD9UVs3bem3Yzm3o24WMRumpyy83t4xKDTqP3jkkqr0L48JjPpOtbixTt6Ymjos8Ds9nKAFVJPJB313Xp46XkkRfMO_B9PKLEHDAehsufcVumOKGU_AOjo0gg9LVNa23GCK32gtXM9OkEYo0FhjE"
                             alt="Network of connected data points" loading="lazy" />
