@{
    ViewBag.Title = "Evidence-based fraud detection";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="hero-bg position-relative">

    <!-- Hero -->
    <section class="mx-auto px-margin-desktop py-5" style="max-width: 1440px;">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-pill mb-3">
                    <i class="bi bi-patch-check-fill text-success" style="font-size:1rem;"></i>
                    <span class="font-data uppercase tracking-wider text-success" style="font-size: 10px; font-weight: 700;">
                        Google AI Builder Cup 2026 · BFSI
                    </span>
                </div>
                <h2 class="display-4 text-primary font-heading fw-bold mb-3" style="line-height: 1.15;">
                    Evidence-based <br />
                    <span class="text-secondary">fraud detection</span>
                </h2>
                <p class="text-secondary lead mb-4" style="max-width: 520px;">
                    FinRiskLens brings fraud detection and risk analysis to every loan application. It reads
                    the bank statements, salary slips and ITRs submitted, and returns findings that explain each
                    risk in rupees and point to the exact row, field or page behind it.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a class="btn btn-primary-maroon px-4 py-3 rounded-3 d-flex align-items-center justify-content-center gap-2 font-heading"
                       href="/Auth/BankLogin">
                        Open the bank portal <i class="bi bi-arrow-right"></i>
                    </a>
                    <a class="btn btn-outline-maroon px-4 py-3 rounded-3 font-heading" href="/Onboarding/CustOnboarding">
                        MSME: share your data
                    </a>
                </div>
            </div>

            <!-- A real finding from the demo set: what the officer sees -->
            <div class="col-lg-6">
                <div class="card-premium p-4 mx-auto" style="max-width: 480px;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <span class="badge bg-danger">High · Tampering</span>
                        <span class="font-data small text-secondary text-break">STATEMENT_VS_AA_MISMATCH</span>
                    </div>
                    <h4 class="h6 text-primary font-heading fw-bold mb-2">Statement disagrees with the bank's own record</h4>
                    <p class="small text-secondary mb-3">
                        91 of 93 rows agree with what the bank reported through Account Aggregator, with
                        2 amounts changed and 4 loan EMIs left out. Net effect: the PDF shows ₹3,65,800 more
                        in credits and ₹1,30,000 less in debits. Every balance and page total on the PDF adds up.
                    </p>
                    <ul class="list-unstyled small mb-0 font-data">
                        <li class="py-1 border-top"><i class="bi bi-file-earmark-text me-2"></i>Page 2, row 28 · credit ₹3,28,500 — bank recorded ₹1,09,500</li>
                        <li class="py-1 border-top"><i class="bi bi-file-earmark-text me-2"></i>Page 3, row 54 · credit ₹2,20,200 — bank recorded ₹73,400</li>
                        <li class="py-1 border-top"><i class="bi bi-bank2 me-2"></i>05 Jun · NACH EMI ₹32,500 — not on the statement</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Pipeline -->
    <section class="mx-auto px-margin-desktop py-5" style="max-width: 1440px;">
        <div class="text-center mb-5">
            <h3 class="h2 text-primary font-heading fw-bold mb-2">Every claim traced to its evidence</h3>
            <p class="text-secondary mx-auto" style="max-width: 640px;">
                Arithmetic first, then the bank's own record, then AI judgement — with every AI claim
                backed by rows of the case.
            </p>
        </div>
        <div class="row g-4">
            @foreach (var (icon, title, text) in new[]
            {
                ("bi-cloud-upload", "Ingest", "File type from the bytes, SHA-256, PDF producer and edit history. Stored in Cloud Storage, Mumbai."),
                ("bi-file-earmark-text", "Extract", "Gemini Flash in Mumbai reads every page in parallel and copies numbers exactly as printed — never corrected."),
                ("bi-calculator", "Check", "Nine deterministic checks: running balances, page totals, slip arithmetic, round-tripping, window dressing, pass-through, metadata, and the bank's Account Aggregator record."),
                ("bi-diagram-3", "Link", "A network lens across every application: a shared file, a shared template or one salary account behind different employers exposes a fraud ring."),
                ("bi-search", "Investigate", "A Gemini Pro agent with tools scoped to one application: its rows, its counterparties, its registry facts and the lender's policy."),
                ("bi-shield-check", "Verify", "An AI claim that cites nothing in the case, or quotes a rupee amount it cannot trace, is dropped — and the drop is shown."),
                ("bi-person-check", "Review", "The credit officer confirms or dismisses each finding, with the evidence and the policy clause one click away.")
            })
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-premium p-4 h-100">
                        <h4 class="h6 text-primary font-heading fw-bold mb-2"><i class="bi @icon me-2"></i>@title</h4>
                        <p class="small text-secondary mb-0">@text</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Measured -->
    <section class="mx-auto px-margin-desktop py-5" style="max-width: 1440px;">
        <div class="text-center mb-5">
            <h3 class="h2 text-primary font-heading fw-bold mb-2">Measured, not assumed</h3>
            <p class="text-secondary mx-auto" style="max-width: 640px;">
                Live Gemini against synthetic cases whose ground truth is known, row by row.
            </p>
        </div>
        <div class="row g-4 text-center">
            @foreach (var (value, label) in new[]
            {
                ("99.8–100%", "of 1,298 statement rows read exactly, in two consecutive runs"),
                ("14 / 14", "demo cases raise exactly their expected findings"),
                ("0", "false alarms on genuine applicants"),
                ("Mumbai", "where documents are stored, read and embedded")
            })
            {
                <div class="col-6 col-lg-3">
                    <div class="card-premium p-4 h-100">
                        <div class="h3 text-primary font-heading fw-bold mb-1">@value</div>
                        <div class="small text-secondary">@label</div>
                    </div>
                </div>
            }
        </div>
    </section>

</main>
