                        <img class="w-100 h-100" style="object-fit: cover;"
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuDx6bsCOWHZAuyTwX8FpSlyOdrmGvZVySCwK4NRUWV79Kl5YnqJb02fn8xBOYugxWgQCzodeJOtaO0HKKxGdbtqa7Sv5FvYISSgD94F3XzT-W2Dvu7_04LTJJG78-FxQQ2fvtRikAUp5vTeWqhOQpxjerAyVp95-mKcLd1aV7xf_z2ejB0A3TdGGcJL5S8jVjisA4IREYGC7F2QXPdtrMEQboajRmETnPDZx8Plix88-7Ia3oAirdwWsEclpAPXUw8zIAsyFktdC8o"
                             alt="Gold bar chart on a pedestal" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>
