                <div class="card-premium p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="bg-success bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center border border-success border-opacity-25 mb-3"
                             style="width: 3.5rem; height: 3.5rem;">
