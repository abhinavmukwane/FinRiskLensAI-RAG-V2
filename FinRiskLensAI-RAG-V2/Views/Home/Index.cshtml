@{
    ViewBag.Title = "AI-Powered Credit Intelligence for MSMEs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="hero-bg position-relative">

    <!-- Hero -->
    <section class="mx-auto px-margin-desktop py-5" style="max-width: 1440px;">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-pill mb-3">
                    <i class="bi bi-patch-check-fill text-success" style="font-size:1rem;"></i>
                    <span class="font-data uppercase tracking-wider text-success" style="font-size: 10px; font-weight: 700;">
                        Google AI Builder Cup 2026 · BFSI
                    </span>
                </div>
                <h2 class="display-4 text-primary font-heading fw-bold mb-3" style="line-height: 1.15;">
                    AI-Powered Credit Intelligence <br />
                    <span class="text-secondary">for MSMEs</span>
                </h2>
                <p class="text-secondary lead mb-4" style="max-width: 520px;">
                    Verify business identity and analyze tax, banking and corporate data to understand
                    financial health and credit risk.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a class="btn btn-primary-maroon px-4 py-3 rounded-3 d-flex align-items-center justify-content-center gap-2 font-heading"
                       href="/Onboarding/CustOnboarding">
                        Start MSME Assessment <i class="bi bi-arrow-right"></i>
                    </a>
                    <a class="btn btn-outline-maroon px-4 py-3 rounded-3 font-heading" href="#how-it-works">
                        How It Works
                    </a>
                </div>
            </div>

            @* Decorative animated mockup (demo values only). dont-translate + bhashini-skip-mutation
               keep the translation plugin from re-hitting its API on every animation frame. *@
            <div class="col-lg-6 position-relative d-none d-lg-block hero-cluster dont-translate bhashini-skip-mutation"
                 translate="no" style="height: 520px;">
                <!-- Main preview panel -->
                <div class="position-absolute top-50 start-50 translate-middle w-100 card-premium overflow-hidden"
                     style="max-width: 440px; z-index: 10;">
                    <div class="bg-light border-bottom p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex gap-1">
                            <div class="rounded-circle bg-danger bg-opacity-50" style="width: 8px; height: 8px;"></div>
                            <div class="rounded-circle bg-warning bg-opacity-75" style="width: 8px; height: 8px;"></div>
                            <div class="rounded-circle bg-success bg-opacity-75" style="width: 8px; height: 8px;"></div>
                        </div>
                        <span class="font-data text-secondary uppercase opacity-50" style="font-size: 8px; font-weight: 700;">BANKING_HEALTH_CHECK · DEMO</span>
                    </div>

                    <div class="p-4 row g-3">
                        <div class="col-7">
                            <div class="bg-light rounded mb-3" style="height: 12px; width: 80%;"></div>
                            <div class="bg-white border rounded-3 p-3 d-flex flex-column align-items-center justify-content-center">
                                <!-- Dial: per-source 0–100 score -->
                                <div class="position-relative d-flex align-items-center justify-content-center rounded-circle risk-gauge-gradient p-1"
                                     style="width: 100px; height: 100px;">
                                    <div class="w-100 h-100 rounded-circle bg-white d-flex flex-column align-items-center justify-content-center">
                                        <span id="heroScore" class="h4 text-primary font-heading mb-0 fw-bold dont-translate" translate="no">88</span>
                                        <span id="heroBand" class="font-data text-secondary uppercase dont-translate" translate="no"
                                              style="font-size: 6px; letter-spacing: 1px;">LOW RISK</span>
                                    </div>
                                    <div id="heroNeedle" class="position-absolute top-50 start-50 translate-middle w-100 h-100"
                                         style="transform: rotate(189deg); transition: transform 1.4s cubic-bezier(.34,1.56,.64,1);">
                                        <div class="bg-primary rounded-circle mx-auto" style="width: 3px; height: 8px; margin-top: -3px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-5 pt-3 d-flex flex-column justify-content-center gap-2">
                            <div class="bg-light rounded w-100" style="height: 8px;"></div>
                            <div class="bg-light rounded w-75" style="height: 8px;"></div>
                            <div class="bg-light rounded w-50" style="height: 8px;"></div>
                            <div class="row g-2 pt-3">
                                <div class="col-6">
                                    <div class="bg-primary bg-opacity-10 rounded hero-pulse" style="height: 36px;"></div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-success bg-opacity-10 rounded hero-pulse" style="height: 36px; animation-delay: .8s;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating identity card -->
                <div class="position-absolute top-0 end-0 glass-card-float p-3 rounded-3 hero-float hero-float-id"
                     style="width: 190px; z-index: 20;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-shield-check text-primary" style="font-size:1.25rem;"></i>
                        <span class="font-data small text-secondary" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">
                            Business Registry · Udyam
                        </span>
                    </div>
                    <div class="h4 font-heading text-dark mb-0 fw-bold">Identity ✓</div>
                </div>

                <!-- Floating chart card -->
                <div class="position-absolute bottom-0 start-0 glass-card-float p-3 rounded-3 hero-float hero-float-chart"
                     style="width: 220px; z-index: 20;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-graph-up-arrow text-secondary" style="font-size:1.25rem;"></i>
                        <span class="font-data small text-secondary" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">
                            Monthly Cash Flow
                        </span>
                    </div>
                    <div id="heroBars" class="d-flex align-items-end gap-1" style="height: 60px;">
                        <div class="bg-secondary bg-opacity-25 rounded-top hero-bar" style="flex: 1;"></div>
                        <div class="bg-secondary bg-opacity-50 rounded-top hero-bar" style="flex: 1;"></div>
                        <div class="bg-secondary bg-opacity-25 rounded-top hero-bar" style="flex: 1;"></div>
                        <div class="bg-secondary bg-opacity-75 rounded-top hero-bar" style="flex: 1;"></div>
                        <div class="bg-secondary rounded-top hero-bar" style="flex: 1;"></div>
                    </div>
                </div>
            </div>

            @* Cycles the dial through demo 0–100 scores; bands follow CONTENT_GUIDELINES.md §3 *@
            <script>
                (function () {
                    var scoreEl = document.getElementById('heroScore');
                    var bandEl = document.getElementById('heroBand');
                    var needleEl = document.getElementById('heroNeedle');
                    var barsWrap = document.getElementById('heroBars');
                    if (!scoreEl) return;

                    var bars = barsWrap ? Array.prototype.slice.call(barsWrap.querySelectorAll('.hero-bar')) : [];
                    var scenarios = [88, 74, 91, 62, 81];
                    var idx = 0, current = 88;

                    function bandFor(s) {
                        if (s >= 85) return 'LOW RISK';
                        if (s >= 65) return 'MODERATE';
                        return 'HIGH RISK';
                    }

                    function tweenTo(target) {
                        var start = current, startT = performance.now(), dur = 1200;
                        var lastVal = null, lastBand = null;
                        function step(now) {
                            var p = Math.min(1, (now - startT) / dur);
                            var eased = 1 - Math.pow(1 - p, 3);
                            var val = Math.round(start + (target - start) * eased);
                            // Only touch the DOM when the value actually changes
                            if (val !== lastVal) { scoreEl.textContent = val; lastVal = val; }
                            var band = bandFor(val);
                            if (band !== lastBand) { bandEl.textContent = band; lastBand = band; }
                            if (p < 1) requestAnimationFrame(step); else current = target;
                        }
                        requestAnimationFrame(step);
                        if (needleEl) needleEl.style.transform = 'rotate(' + (-40 + (target / 100) * 260) + 'deg)';
                        randomizeBars();
                    }

                    function randomizeBars() {
                        bars.forEach(function (b, i) {
                            setTimeout(function () { b.style.height = (30 + Math.random() * 70) + '%'; }, i * 90);
                        });
                    }

                    randomizeBars();
                    setInterval(function () {
                        idx = (idx + 1) % scenarios.length;
                        tweenTo(scenarios[idx]);
                    }, 3200);
                })();
            </script>
        </div>
    </section>

    <!-- Pipeline -->
    <section id="how-it-works" class="mx-auto px-margin-desktop py-5" style="max-width: 1440px; scroll-margin-top: 90px;">
        <div class="text-center mb-5">
            <h3 class="h2 text-primary font-heading fw-bold mb-2">Every claim traced to its evidence</h3>
            <p class="text-secondary mx-auto" style="max-width: 640px;">
                Arithmetic first, then the bank's own record, then AI judgment. Every AI claim is
                backed by the customer's own data.
            </p>
        </div>
        <div class="row g-4">
            @foreach (var (icon, title, text) in new[]
            {
                ("bi-cloud-upload", "Ingest", "Detects file type from the bytes and records the SHA-256 hash, PDF producer and edit history. Stored in Cloud Storage, Mumbai."),
                ("bi-file-earmark-text", "Extract", "Gemini Flash in Mumbai reads every page in parallel and copies numbers exactly as printed, never corrected."),
                ("bi-calculator", "Check", "Nine rule-based checks: running balances, page totals, salary-slip arithmetic, round-tripping, window dressing, pass-through, metadata and the bank's Account Aggregator record."),
                ("bi-diagram-3", "Link", "Looks across all customers. A shared director, mobile, email, address or document, or GST invoices that go round in a loop, links customers to review together."),
                ("bi-search", "Investigate", "A Gemini Pro agent works within one customer: their rows, counterparties, registry facts and the lender's policy."),
                ("bi-shield-check", "Verify", "An AI claim that cites nothing in the customer's data, or quotes an amount it can't trace, is dropped, and the drop is shown."),
                ("bi-person-check", "Review", "The credit officer confirms or dismisses each finding on the customer's Risk Lens, with the evidence and policy clause one click away."),
                ("bi-cash-stack", "Decide", "A Clear customer gets an AI credit decision within the capacity the credit policy allows, then the loan case goes to the LOS, ULI or ONDC.")
            })
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-premium p-4 h-100">
                        <h4 class="h6 text-primary font-heading fw-bold mb-2"><i class="bi @icon me-2"></i>@title</h4>
                        <p class="small text-secondary mb-0">@text</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Features bento -->
