@model FinRiskLensAI.Core.Models.Admin.BankDashboardViewModel
@using FinRiskLensAI.Common
@{
    ViewBag.Title = "Portfolio Dashboard";
    Layout = "~/Views/Shared/_BankAdminLayout.cshtml";
    var s = Model.Stats;
    var bankUser = Context.Session.GetCurrentBankUser();
}

<div class="bp-page-head">
    <div>
        <div class="bp-eyebrow">Portfolio Overview</div>
        <h1>Welcome, @(bankUser?.FullName ?? "Bank User")</h1>
        <div class="bp-welcome-meta">
            <span><i class="bi bi-bank2"></i>@(bankUser?.BankName ?? "—")</span>
            <span><i class="bi bi-geo-alt"></i>@(bankUser?.BranchName ?? "—")</span>
            <span><i class="bi bi-upc-scan"></i>@(bankUser?.IfscCode ?? "—")</span>
        </div>
    </div>
    <a class="bp-btn" href="@Url.Action("Customers", "BankAdmin")">
        <i class="bi bi-people"></i> View all customers
    </a>
</div>

@if (Model.LoadError != null)
{
    <div class="bp-alert"><i class="bi bi-exclamation-triangle-fill"></i>@Model.LoadError</div>
}
else if (s.TotalOnboarded == 0)
{
    <div class="bp-empty">
        <i class="bi bi-inbox"></i>
        <h2>No onboarded MSMEs yet</h2>
        <p>Once enterprises complete Udyam onboarding they will appear here.</p>
    </div>
}
else
{
    <!-- ===================== KPI tiles ===================== -->
    <div class="bp-kpi-grid">
        <div class="bp-kpi">
            <div class="bp-kpi-ic"><i class="bi bi-buildings"></i></div>
            <div class="bp-kpi-v">@s.TotalOnboarded</div>
            <div class="bp-kpi-k">Onboarded MSMEs</div>
        </div>
        <div class="bp-kpi">
            <div class="bp-kpi-ic"><i class="bi bi-calendar-plus"></i></div>
            <div class="bp-kpi-v">@s.NewThisMonth</div>
            <div class="bp-kpi-k">New This Month</div>
            <div class="bp-kpi-d">@DateTime.UtcNow.ToString("MMMM yyyy")</div>
        </div>
    </div>

    <!-- ===================== Charts ===================== -->
    <div class="bp-chart-grid">
        <div class="bp-card">
            <div class="bp-card-label"><i class="bi bi-graph-up"></i>Onboarding Trend &mdash; last 12 months</div>
            <div class="bp-chart-box"><canvas id="trendChart"></canvas></div>
        </div>

        <div class="bp-card">
            <div class="bp-card-label"><i class="bi bi-geo-alt"></i>Top States</div>
            <div class="bp-chart-box"><canvas id="stateChart"></canvas></div>
        </div>

        <div class="bp-card">
            <div class="bp-card-label"><i class="bi bi-diagram-3"></i>Industry Mix</div>
            <div class="bp-chart-box"><canvas id="activityChart"></canvas></div>
        </div>
    </div>

    <!-- ===================== Recent customers ===================== -->
    <div class="bp-card mt-3">
        <div class="bp-card-label"><i class="bi bi-clock-history"></i>Recently Onboarded</div>
        <div class="bp-table-wrap">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Enterprise</th>
                        <th>Udyam Number</th>
                        <th>State</th>
                        <th>Onboarded</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in s.RecentCustomers)
                    {
                        <tr>
                            <td class="bp-strong">@c.EnterpriseName</td>
                            <td class="bp-mono">@c.Uan</td>
                            <td>@(c.State ?? "—")</td>
                            <td>@c.OnboardedOn.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a class="bp-link" href="@Url.Action("Customer", "BankAdmin", new { uan = c.Uan })">
                                    View <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    @if (Model.LoadError == null && s.TotalOnboarded > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            // Brand colours follow the active theme (see ~/css/theme.css).
            // Re-read on each call: a CSS variable captured into a JS string is
            // a snapshot, so the data-theme flip never reaches a colour already
            // baked into a chart. See the frl-theme-changed hook at the bottom.
            const palette = () => {
                const css = getComputedStyle(document.documentElement);
                return {
                    brand: (css.getPropertyValue('--brand-btn-bg') || '#F37021').trim(),
                    primary: (css.getPropertyValue('--brand-primary') || '#00836C').trim()
                };
            };
            let { brand: BRAND, primary: PRIMARY } = palette();

            const trend = @Html.Raw(Json.Serialize(s.OnboardingTrend));
            const states = @Html.Raw(Json.Serialize(s.TopStates));
            const activity = @Html.Raw(Json.Serialize(s.ActivityMix));

            const charts = {};

            const noLegend = { legend: { display: false } };
            const intAxis = { y: { beginAtZero: true, ticks: { precision: 0 } } };

            const monthLabel = k => {
                const [y, m] = k.split('-');
                return new Date(y, m - 1).toLocaleString('en', { month: 'short' }) + " '" + y.slice(2);
            };
            charts.trendChart = new Chart(document.getElementById('trendChart'), {
                type: 'line',
                data: {
                    labels: Object.keys(trend).map(monthLabel),
                    datasets: [{
                        data: Object.values(trend), borderColor: BRAND, backgroundColor: BRAND + '25',
                        fill: true, tension: .35, pointRadius: 3
                    }]
                },
                options: { maintainAspectRatio: false, plugins: noLegend, scales: intAxis }
            });

            charts.stateChart = new Chart(document.getElementById('stateChart'), {
                type: 'bar',
                data: {
                    labels: Object.keys(states),
                    datasets: [{ data: Object.values(states), backgroundColor: PRIMARY, borderRadius: 6 }]
                },
                options: {
                    indexAxis: 'y', maintainAspectRatio: false, plugins: noLegend,
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            charts.activityChart = new Chart(document.getElementById('activityChart'), {
                type: 'doughnut',
                data: {
                    labels: Object.keys(activity),
                    datasets: [{
                        data: Object.values(activity),
                        backgroundColor: [PRIMARY, BRAND, '#7fae5e', '#c98a2b', '#8a6d00', '#5c8a99'],
                        borderColor: '#fff', borderWidth: 2
                    }]
                },
                options: {
                    maintainAspectRatio: false, cutout: '58%',
                    plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } } }
                }
            });

            // Theme switch — recolour in place, no page refresh. Only the two
            // brand-driven colours move; the activity palette's fixed entries stay put.
            document.addEventListener('frl-theme-changed', function () {
                ({ brand: BRAND, primary: PRIMARY } = palette());

                if (charts.trendChart) {
                    const ds = charts.trendChart.data.datasets[0];
                    ds.borderColor = BRAND;
                    ds.backgroundColor = BRAND + '25';
                    charts.trendChart.update();
                }
                if (charts.stateChart) {
                    charts.stateChart.data.datasets[0].backgroundColor = PRIMARY;
                    charts.stateChart.update();
                }
                if (charts.activityChart) {
                    const ds = charts.activityChart.data.datasets[0];
                    ds.backgroundColor = [PRIMARY, BRAND, '#7fae5e', '#c98a2b', '#8a6d00', '#5c8a99'];
                    charts.activityChart.update();
                }
            });
        </script>
    }
}
