@{
    ViewBag.Title = "CustOnboarding";
    Layout = "~/Views/Shared/_CustOnboardingLayout.cshtml";
}

@* Added By Sourabh 2026-07-03 YMD *@
<script src="~/frlscripts/onboarding/custonboarding.js"></script>

    <div class="container py-4 py-md-1">
        <div id="onboardingFlow">

            <div class="rail-wrap">
                <div class="rail" id="rail">
                    <div class="rail-line"></div>
                    <div class="rail-line-fill" id="railFill"></div>

                    <div class="rail-step active" data-step="1">
                        <div class="node"><i class="bi bi-fingerprint"></i></div>
                        <div class="label">Udyam Number</div>
                        <div class="sub">Verify enterprise</div>
                    </div>
                    <div class="rail-step" data-step="2">
                        <div class="node"><i class="bi bi-clipboard2-check"></i></div>
                        <div class="label">Review & Proceed</div>
                        <div class="sub">Confirm details</div>
                    </div>
                    <div class="rail-step" data-step="3">
                        <div class="node"><i class="bi bi-shield-check"></i></div>
                        <div class="label">OTP Verification</div>
                        <div class="sub">Confirm it's you</div>
                    </div>

                </div>
            </div>

            <div class="mx-auto" style="max-width:760px;">

                <!-- ============ STEP 1 : UDYAM NUMBER ============ -->
                <div class="stage-card fade-step" id="step1">
                    <div class="stage-head">
                        <div class="stage-icon"><i class="bi bi-fingerprint"></i></div>
                        <div>
                            <div class="eyebrow">Step 01</div>
                            <h2 class="stage-title">Enter your Udyam Registration Number</h2>

                        </div>
                    </div>
                    <div class="stage-body">
                        <label class="form-label" for="udyamInput">Udyam Registration Number</label>
                        <div class="input-group input-group-lg mb-2">
                            <span class="input-group-text bg-white" style="border-color:var(--line);">
                                <i class="bi bi-upc-scan text-muted"></i>
                            </span>
                            <input type="text" id="udyamInput" class="form-control input-udyam"
                                   placeholder="UDYAM-XX-00-0000000" maxlength="19" autocomplete="off">
                        </div>
                        <div class="help-text mb-4">
                            <i class="bi bi-info-circle-fill"></i> Format: UDYAM-State
                            Code-District
                            Code-Registration Number. Find it on your Udyam certificate.
                        </div>

                        <div class="d-flex justify-content-end align-items-center">
                            <button class="btn btn-maroon btn-lg px-4" id="btnFetch">
                                <span id="fetchBtnLabel">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    Fetch & Continue
                                </span>
                            </button>
                        </div>
                        <div class="alert alert-danger d-none mt-3 py-2 small" id="udyamError">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> <span></span>
                        </div>
                    </div>
                </div>


            <!-- ============ FETCH LOADER ============ -->
            <div id="fetchLoader">
                <div class="spinner-cv"></div>

                <div class="screen-title"
                     style="font-family:var(--font-display);font-size:1.15rem;font-weight:700;color:var(--maroon-deep);">
                    Verifying Udyam details...
                </div>

                <div class="loading-steps">
                    <div class="li" id="ls1">
                        <i class="bi bi-check-circle-fill"></i>
                        Validating Udyam number
                    </div>

                    <div class="li" id="ls2">
                        <i class="bi bi-check-circle-fill"></i>
                        Fetching enterprise information
                    </div>

                    <div class="li" id="ls3">
                        <i class="bi bi-check-circle-fill"></i>
                        Preparing verification details
                    </div>
                </div>
            </div>

                <!-- ============ STEP 2 : REVIEW & PROCEED ============ -->
                <div class="fade-step d-none" id="step2">
                    <!-- Step heading -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="stage-icon"><i class="bi bi-clipboard2-check"></i></div>
                        <div>
                            <div class="eyebrow">Step 02</div>
                            <h2 class="stage-title mb-0">Review &amp; Proceed</h2>
                        </div>
                    </div>
                    <!-- === Enterprise Details Card === -->
                    <div class="rv-card mb-3">
                        <div class="rv-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-building-fill rv-card-icon"></i>
                                <span class="rv-card-title">Enterprise Details</span>
                            </div>

                        </div>
                        <div class="rv-card-body">
                            <div class="row g-0">
                                <div class="col-md-6 rv-field rv-border-end">
                                    <div class="rv-field-label">Legal Name</div>
                                    <div class="rv-field-value" id="rv_entName">Sharma Precision Engineering Works</div>
                                </div>
                                <div class="col-md-6 rv-field">
                                    <div class="rv-field-label">Constitution</div>
                                    <div class="rv-field-value" id="rv_orgType">Proprietorship</div>
                                </div>
                                <div class="col-12">
                                    <div class="rv-divider"></div>
                                </div>
                                <div class="col-md-6 rv-field rv-border-end">
                                    <div class="rv-field-label">Date of Incorporation</div>
                                    <div class="rv-field-value" id="rv_dob">14 Jun 2019</div>
                                </div>
                                <div class="col-md-6 rv-field">
                                    <div class="rv-field-label">Enterprise Type</div>
                                    <div class="rv-field-value" id="rv_msme">Micro Enterprise (Manufacturing)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="rv-card mb-3">
                        <div class="rv-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-building-fill rv-card-icon"></i>
                                <span class="rv-card-title">Personal Details</span>
                            </div>
                        <input type="hidden" id="hdnMsmeEnquiryID" />
                        </div>
                        <div class="rv-card-body">
                            <div class="row g-0">
                                <div class="col-md-6 rv-field rv-border-end">
                                    <div class="rv-field-label">Udyam Number</div>
                                    <div class="rv-field-value" id="rv_udyam_number"></div>
                                </div>
                                <div class="col-md-6 rv-field">
                                    <div class="rv-field-label">GSTN Number</div>
                                    <div class="rv-field-value" id="rv_gstnNumber"></div>
                                </div>
                                <div class="col-12">
                                    <div class="rv-divider"></div>
                                </div>
                                <div class="col-md-6 rv-field rv-border-end">
                                    <div class="rv-field-label">PAN Number</div>
                                    <div class="rv-field-value" id="rv_panNo"></div>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    <!-- === Location + Contact row === -->
                    <div class="row g-3 mb-3">
                        <!-- Registered Location -->
                        <div class="col-md-6">
                            <div class="rv-card h-100">
                                <div class="rv-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-geo-alt-fill rv-card-icon"></i>
                                        <span class="rv-card-title">Registered Location</span>
                                    </div>
                                    
                                </div>
                                <div class="rv-card-body">
                                    <p class="rv-address mb-3" id="rv_address">
                                        Plot 22, MIDC Industrial Area, Hingna
                                        Road, Nagpur – 440016, Maharashtra
                                    </p>
                                    <div class="rv-map-box">
                                        <div class="rv-map-gradient"></div>
                                        <div class="rv-map-pin"><i class="bi bi-geo-alt-fill"></i></div>
                                        <div class="rv-map-badge">
                                            <i class="bi bi-grid-3x3-gap-fill me-1"></i>VERIFIED
                                            GEOTAG
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Contact Details -->
                        <div class="col-md-6">
                            <div class="rv-card h-100">
                                <div class="rv-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-lines-fill rv-card-icon"></i>
                                        <span class="rv-card-title">Contact Details</span>
                                    </div>
                                </div>
                            <div class="rv-card-body">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="rv-field-label">Email Address</div>
                                        <span class="rv-badge rv-badge-required">REQUIRED</span>
                                    </div>

                                    <div class="rv-mobile-input-wrap">
                                        <span class="rv-mobile-prefix">
                                            <i class="bi bi-envelope-fill"></i>
                                        </span>
                                        <input type="email"
                                               class="rv-mobile-input"
                                               id="rv_email"
                                               placeholder="Enter Email Address"
                                               readonly>
                                        <!-- Real value never appears here — only the masked display
                                             string from GetUdyamDetails. The actual value travels
                                             encrypted in #rv_email_enc and is decrypted server-side
                                             only at the point GenerateOtp sends/saves it. -->
                                        <input type="hidden" id="rv_email_enc" />
                                    </div>
                                </div>

                                <div style="margin-top: 20px;">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="rv-field-label">Primary Mobile Number</div>
                                            <span class="rv-badge rv-badge-required">REQUIRED</span>
                                        </div>
                                        <div class="rv-mobile-input-wrap">
                                            <span class="rv-mobile-prefix">+91</span>
                                            <input type="text" class="rv-mobile-input" id="mobileInput"
                                                   placeholder="98xxxxxxxx" maxlength="10" readonly>
                                            <!-- Same as email above — masked here, real value encrypted in #mobileInput_enc. -->
                                            <input type="hidden" id="mobileInput_enc" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                    </div>
                    <div class="rv-card">
                        <div class="rv-card-body">
                           <div class=" mb-3" style="padding-left: 5px;">
                            <input class="form-check-input rv-checkbox" type="checkbox" id="consentCheck">
                            <label class="form-check-label small text-muted" for="consentCheck">
                                I confirm the above details are correct and consent to FinRiskLens AI accessing my
                                MSME credit profile.
                            </label>
                             </div>
                            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
                               
                                <button class="btn btn-maroon btn-lg px-5" id="btnProceedToOtp" disabled>
                                    <i class="bi bi-send me-1"></i> Register
                                </button>
                            </div>
                            <div class="alert alert-danger d-none mt-3 py-2 small" id="reviewError">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> <span></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ============ STEP 3 : OTP ============ -->
            <div class="stage-card fade-step d-none mx-auto" id="step3" style="max-width: 650px;">
                <div class="stage-head d-flex align-items-center">
                    <div class="stage-icon"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="eyebrow">Step 03</div>
                        <h2 class="stage-title">Verify with OTP</h2>
                        <p class="stage-desc mb-0">
                            We've sent a 6-digit code to <span class="fw-semibold" id="otpEmailTarget" style="color:var(--maroon-dark)"></span>
                        </p>
                    </div>
                </div>
                <div class="stage-body text-center">
                    <div class="otp-row mb-3">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                    </div>
                    <div class="alert alert-danger d-none py-2 small mx-auto" style="max-width:380px;" id="otpError">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Incorrect code. Please try again.
                    </div>

                    <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
                        <span class="timer-chip">
                            <i class="bi bi-clock-history"></i> <span id="otpTimer">00:60</span>
                        </span>
                        <a href="#" class="btn-link-gold" id="resendOtp">
                            <i class="bi bi-arrow-repeat me-1"></i>Resend
                            code
                        </a>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-maroon px-4" id="btnVerifyOtp">
                            <i class="bi bi-check-circle me-1"></i>
                            Verify &amp; Continue
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div> 

    <div class="text-center mt-5">
        <footer class="brand-footer">
            <i class="bi bi-lock-fill"></i> Your data is processed in compliance with RBI data protection guidelines
            · FinRiskLens AI © 2026
        </footer>
    </div>

    <!-- Toasts -->
    <div class="toast-custom">
        <div class="toast align-items-center text-bg-success border-0" id="liveToast" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i><span id="toastMsg">Done</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>


    
<div class="modal fade" id="otpDisplayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-shield-lock-fill"></i>
                    Your one-time password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-2">Use this OTP to continue:</p>

                <div class="otp-display-box">
                    <h2 id="otpDisplayValue" class="fw-bold"></h2>
                    <button type="button" class="otp-copy-btn" id="copyOtpBtn" title="Copy OTP" aria-label="Copy OTP">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <div class="otp-dev-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>This OTP is shown here for development purposes only and won't appear once email delivery is live.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-maroon" data-bs-dismiss="modal">
                    <i class="bi bi-check2"></i>
                    <span>Got it</span>
                </button>
            </div>
        </div>
    </div>
</div>
