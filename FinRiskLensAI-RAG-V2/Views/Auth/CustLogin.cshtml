@{
    ViewBag.Title = "CustLogin";
    Layout = "~/Views/Shared/_CustOnboardingLayout.cshtml";
}
<script src="~/frlscripts/custlogin/custlogin.js"></script>
<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/custlogin.css" rel="stylesheet" />

<!-- Main -->
<div class="container py-4 py-md-1" style="margin-top:58px">
    <div id="onboardingFlow">
        <div class="mx-auto" style="max-width:500px;">
            <div class="stage-card fade-step" id="step1">

                <div class="stage-head d-flex align-items-center gap-3">
                    <div class="stage-icon">
                        <i class="bi bi-envelope-at"></i>
                    </div>

                    <h2 class="stage-title mb-0">Welcome Back!</h2>
                </div>

                <div class="stage-body">

                    <!-- BOX 1 -->
                    <div class="box-1" id="box1">

                        <label class="form-label">Enter your Email ID</label>

                        <div class="input-group input-group-lg mb-2">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>

                            <input type="email"
                                   id="email"
                                   class="form-control"
                                   placeholder="Enter your registered email">
                        </div>

                        <div class="help-text mb-3" id="emailHelpText">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>We'll send a 6-digit OTP to your registered email.</span>
                        </div>

                        <div class="text-end">
                            <button class="btn btn-maroon btn-sm px-4" id="generateOtpBtn" type="button">
                                <i class="bi bi-send me-1"></i>
                                <span>Generate OTP</span>
                            </button>
                        </div>

                    </div>

                    <!-- BOX 2 -->
                    <div class="box-2 mt-4 d-none" id="box2">
                        <hr />
                        <label class="form-label">Enter OTP</label>

                        <div class="otp-row mb-1" id="otpRow">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-box otp-input">
                        </div>

                        @* <div class="otp-progress"><div class="otp-progress-fill" id="otpProgress"></div></div> *@

                        <div class="otp-meta">
                            <span class="help-text status-sent mb-0">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>OTP sent to your email.</span>
                            </span>
                            <button class="btn-link-resend" id="resendBtn" type="button" disabled>
                                Resend in <span id="resendTimer">30</span>s
                            </button>
                        </div>

                        <div class="text-end">
                            <button type="button"
                                    class="btn btn-brand"
                                    id="submitBtn"
                                    disabled>

                                <i class="bi bi-box-arrow-in-right"></i>
                                <span id="submitLabel">Login to Portal</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- Toasts -->
<div class="toast-custom">
    <div class="toast align-items-center text-bg-success border-0" id="liveToast" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i><span id="toastMsg">Done</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>


<div class="modal fade" id="otpDisplayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-shield-lock-fill"></i>
                    Your one-time password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-2">Use this OTP to continue:</p>

                <div class="otp-display-box">
                    <h2 id="otpDisplayValue" class="fw-bold"></h2>
                    <button type="button" class="otp-copy-btn" id="copyOtpBtn" title="Copy OTP" aria-label="Copy OTP">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <div class="otp-dev-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>This OTP is shown here for development purposes only and won't appear once email delivery is live.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-maroon" data-bs-dismiss="modal">
                    <i class="bi bi-check2"></i>
                    <span>Got it</span>
                </button>
            </div>
        </div>
    </div>
</div>
