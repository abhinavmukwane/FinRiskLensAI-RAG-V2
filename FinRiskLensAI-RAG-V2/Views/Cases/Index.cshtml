@model IReadOnlyList<FinRiskLensAI.Core.Models.Cases.CaseListItem>
@using FinRiskLensAI.Core.Models.Cases
@{
    ViewBag.Title = "Cases";
    Layout = "~/Views/Shared/_BankAdminLayout.cshtml";
}

<div class="bp-page-head">
    <div>
        <div class="bp-eyebrow">FraudLens</div>
        <h1>Cases</h1>
        <div class="bp-welcome-meta">
            <span><i class="bi bi-folder2-open"></i>@Model.Count case@(Model.Count == 1 ? "" : "s")</span>
        </div>
    </div>
    <a class="bp-btn" href="@Url.Action("New", "Cases")"><i class="bi bi-plus-lg"></i> New case</a>
</div>

@if (Model.Count == 0)
{
    <div class="bp-empty">
        <i class="bi bi-inbox"></i>
        <h2>No cases yet</h2>
        <p>Open a case and upload the applicant's statements, slips and ITRs to start an investigation.</p>
    </div>
}
else
{
    <div class="bp-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table-hover">
                <thead>
                    <tr>
                        <th>Case</th>
                        <th>Application no.</th>
                        <th>Product</th>
                        <th>Udyam</th>
                        <th>Documents</th>
                        <th>Status</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr onclick="location.href='@Url.Action("Detail", "Cases", new { id = c.LoanApplicationID })'" style="cursor:pointer">
                            <td class="bp-mono">#@c.LoanApplicationID</td>
                            <td class="bp-strong">@c.ApplicantRef</td>
                            <td>@c.ProductType.Label()</td>
                            <td class="bp-mono">@(c.Uan ?? "—")</td>
                            <td>@c.DocumentCount</td>
                            <td><span class="bp-case-status bp-case-@c.Status.ToString().ToLowerInvariant()">@c.Status</span></td>
                            <td>@c.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
