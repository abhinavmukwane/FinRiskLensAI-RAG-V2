@model FinRiskLensAI.Core.Models.Cases.CaseDetailViewModel
@using FinRiskLensAI.Core.Models.Cases
@{
    var a = Model.Application;
    ViewBag.Title = $"Case #{a.LoanApplicationID}";
    Layout = "~/Views/Shared/_BankAdminLayout.cshtml";

    static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";
    static string Money(decimal? v) => v.HasValue ? "₹" + v.Value.ToString("N0", new System.Globalization.CultureInfo("en-IN")) : "—";
}

<div class="bp-crumb">
    <a href="@Url.Action("Index", "Cases")"><i class="bi bi-arrow-left"></i> All cases</a>
</div>

<div class="bp-profile">
    <div class="bp-profile-main">
        <div class="bp-profile-avatar"><i class="bi bi-folder2-open"></i></div>
        <div>
            <h1>@a.ApplicantRef</h1>
            <div class="bp-profile-meta">
                <span><i class="bi bi-hash"></i>Case @a.LoanApplicationID</span>
                <span><i class="bi bi-briefcase"></i>@a.ProductType.Label()</span>
                @if (a.Uan != null)
                {
                    <span><i class="bi bi-patch-check"></i><a class="bp-link" href="@Url.Action("Customer", "BankAdmin", new { uan = a.Uan })">@a.Uan</a></span>
                }
                <span><i class="bi bi-clock"></i>@a.SubmittedAt.ToString("dd MMM yyyy HH:mm") UTC</span>
                <span class="bp-case-status bp-case-@a.Status.ToString().ToLowerInvariant()">@a.Status</span>
            </div>
        </div>
    </div>
</div>

<div class="bp-fact-grid">
    <div class="bp-fact"><div class="k">Declared income / month</div><div class="v bp-fact-sm">@Money(a.DeclaredIncome)</div></div>
    <div class="bp-fact"><div class="k">Declared EMIs / month</div><div class="v bp-fact-sm">@Money(a.DeclaredEmis)</div></div>
    <div class="bp-fact"><div class="k">Declared employer</div><div class="v bp-fact-sm">@(a.DeclaredEmployer ?? "—")</div></div>
    <div class="bp-fact"><div class="k">Documents</div><div class="v bp-fact-sm">@a.Documents.Count</div></div>
</div>

@{
    var docsById = a.Documents.ToDictionary(d => d.CaseDocumentID);
    var open = Model.Findings.Count(f => f.ReviewStatus == ReviewStatus.Open);
    var pendingExtraction = a.Documents.Any(d => d.ExtractStatus == ExtractStatus.Pending);
    var working = pendingExtraction || a.Status == CaseStatus.Processing;

    // The rejected claim's own title, for the "rejected by grounding" list
    static string ClaimTitle(string raw)
    {
        try
        {
            using var j = System.Text.Json.JsonDocument.Parse(raw);
            var t = j.RootElement.TryGetProperty("title", out var x) ? x.GetString() : null;
            var type = j.RootElement.TryGetProperty("type", out var y) ? y.GetString() : null;
            return $"{type}: {t}";
        }
        catch (System.Text.Json.JsonException) { return "(unreadable claim)"; }
    }
}
@section Styles {
    @* Polls while Gemini reads or investigates; stops by itself once the pipeline is done *@
    @if (working)
    {
        <meta http-equiv="refresh" content="6" />
    }
}
<div class="bp-card mt-3">
    <div class="bp-card-label bp-findings-head">
        <span><i class="bi bi-flag"></i>Findings
            <span class="bp-muted">@open open · @(Model.Findings.Count - open) reviewed</span>
        </span>
        <span class="bp-findings-actions">
            <form method="post" asp-action="RunChecks" asp-route-id="@a.LoanApplicationID">
                <button type="submit" class="bp-btn bp-btn-ghost bp-btn-sm"><i class="bi bi-arrow-repeat"></i> Re-run checks</button>
            </form>
            <form method="post" asp-action="Investigate" asp-route-id="@a.LoanApplicationID">
                <button type="submit" class="bp-btn bp-btn-sm" @(working ? "disabled" : "")><i class="bi bi-robot"></i> Run investigation</button>
            </form>
        </span>
    </div>
    @if (a.InvestigatedAt != null)
    {
        <div class="bp-muted bp-investigated">
            <i class="bi bi-robot"></i> Investigated @a.InvestigatedAt.Value.ToString("dd MMM yyyy HH:mm") UTC by @a.InvestigatedBy —
            every AI finding below passed grounding verification against this case's own rows and fields.
        </div>
    }

    @if (pendingExtraction)
    {
        <div class="bp-alert bp-alert-warn bp-findings-note">
            <i class="bi bi-hourglass-split"></i>
            Gemini is reading the documents. Content checks — balances, totals, round-tripping, window
            dressing — run as soon as it finishes; this page refreshes until then. File checks have run.
        </div>
    }
    else if (working)
    {
        <div class="bp-alert bp-alert-warn bp-findings-note">
            <i class="bi bi-hourglass-split"></i>
            The Investigator is working through this case. This page refreshes until it finishes.
        </div>
    }

    @if (Model.Findings.Count == 0)
    {
        <p class="bp-muted mb-0">No findings.</p>
    }

    @foreach (var f in Model.Findings)
    {
        var reviewed = f.ReviewStatus != ReviewStatus.Open;
        <article id="finding-@f.FindingID" class="bp-finding bp-sev-@f.Severity.ToString().ToLowerInvariant() @(reviewed ? "bp-finding-reviewed" : "")">
            <div class="bp-finding-meta">
                <span class="bp-sev">@f.Severity</span>
                <span>@f.Category</span>
                <span class="bp-mono">@f.Type</span>
                <span>@(f.DetectedBy == FindingSource.Deterministic ? "Deterministic" : "AI · verified")</span>
                @if (reviewed)
                {
                    <span class="bp-review-chip bp-review-@f.ReviewStatus.ToString().ToLowerInvariant()">@f.ReviewStatus by @f.ReviewedBy</span>
                }
            </div>
            <h3>@f.Title</h3>
            <p>@f.Explanation</p>
            @if (f.RecommendedAction != null)
            {
                <p class="bp-finding-action"><i class="bi bi-arrow-return-right"></i> @f.RecommendedAction
                    @if (f.Type == "FRAUD_RING")
                    {
                        <a class="bp-link" href="@Url.Action("Rings", "Cases")">See the ring <i class="bi bi-diagram-3"></i></a>
                    }
                </p>
            }

            @if (f.Evidence.Count > 0)
            {
                <ul class="bp-evidence">
                    @foreach (var e in f.Evidence)
                    {
                        var doc = e.CaseDocumentID is int did && docsById.TryGetValue(did, out var dd) ? dd : null;
                        <li>
                            @if (e.Kind == EvidenceKind.Policy)
                            {
                                <span class="bp-policy"><i class="bi bi-journal-text"></i> @e.Note</span>
                                continue;
                            }
                            @if (doc != null)
                            {
                                <a class="bp-link" target="_blank" rel="noopener"
                                   href="@(Url.Action("Document", "Cases", new { id = a.LoanApplicationID, docId = doc.CaseDocumentID }))@(e.PageNo != null ? $"#page={e.PageNo}" : "")">
                                    <i class="bi bi-box-arrow-up-right"></i> @doc.FileName@(e.PageNo != null ? $", p. {e.PageNo}" : "")
                                </a>
                            }
                            @if (e.Note != null) { <span class="bp-muted">@e.Note</span> }
                        </li>
                    }
                </ul>
            }

            @if (f.ReviewNote != null)
            {
                <p class="bp-review-note"><i class="bi bi-chat-left-text"></i> @f.ReviewNote</p>
            }

            <form class="bp-review-form" method="post" asp-action="Review"
                  asp-route-id="@a.LoanApplicationID" asp-route-findingId="@f.FindingID">
                @if (reviewed)
                {
                    <button type="submit" name="status" value="Open" class="bp-btn bp-btn-ghost bp-btn-sm">Reopen</button>
                }
                else
                {
                    <input type="text" name="note" maxlength="2000" class="bp-select" placeholder="Note for the case file (optional)"
                           aria-label="Review note for this finding" />
                    <button type="submit" name="status" value="Confirmed" class="bp-btn bp-btn-sm"><i class="bi bi-check2"></i> Confirm</button>
                    <button type="submit" name="status" value="Dismissed" class="bp-btn bp-btn-ghost bp-btn-sm"><i class="bi bi-x"></i> Dismiss</button>
                }
            </form>
        </article>
    }

    @if (Model.RejectedClaims.Count > 0)
    {
        <details class="bp-rejected">
            <summary>
                <i class="bi bi-shield-x"></i>
                @Model.RejectedClaims.Count AI claim@(Model.RejectedClaims.Count == 1 ? "" : "s") rejected by grounding verification
            </summary>
            <p class="bp-muted">
                Proposed by the Investigator and discarded before anyone could act on them, because they could not
                be traced to this case's data. Shown for transparency; they are not findings.
            </p>
            <ul>
                @foreach (var d in Model.RejectedClaims)
                {
                    <li><span class="bp-strong">@ClaimTitle(d.RawFinding)</span> <span class="bp-muted">— @d.Reason</span></li>
                }
            </ul>
        </details>
    }
</div>

<div class="bp-card mt-3">
    <div class="bp-card-label"><i class="bi bi-files"></i>Documents</div>
    <div class="bp-table-wrap">
        <table class="bp-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Pages</th>
                    <th>Producer / creator</th>
                    <th>Created / modified</th>
                    <th>Fonts</th>
                    <th>SHA-256</th>
                    <th>Extraction</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in a.Documents)
                {
                    var hex = Convert.ToHexString(d.Sha256).ToLowerInvariant();
                    var fonts = d.FontSet?.Split(',') ?? Array.Empty<string>();
                    var isPdf = d.ContentType == "application/pdf";
                    <tr>
                        <td>
                            <a class="bp-link bp-strong" target="_blank" rel="noopener"
                               href="@Url.Action("Document", "Cases", new { id = a.LoanApplicationID, docId = d.CaseDocumentID })">
                                <i class="bi @(isPdf ? "bi-file-earmark-pdf" : "bi-file-earmark-image")"></i> @d.FileName
                            </a>
                            <div class="bp-muted">@Size(d.SizeBytes) · @d.DocType</div>
                            @if (Model.SharedWith.TryGetValue(d.CaseDocumentID, out var others))
                            {
                                <div class="bp-flag" title="A byte-identical file was uploaded in another application">
                                    <i class="bi bi-link-45deg"></i>Same file in
                                    @foreach (var o in others)
                                    {
                                        <a href="@Url.Action("Detail", "Cases", new { id = o })">#@o</a>
                                    }
                                </div>
                            }
                        </td>
                        <td>@(d.PageCount?.ToString() ?? "—")</td>
                        <td>
                            @if (!isPdf)
                            {
                                <span class="bp-muted">image</span>
                            }
                            else if (d.PageCount == null)
                            {
                                <span class="bp-muted" title="Password-protected or malformed: the PDF could not be opened">unreadable</span>
                            }
                            else
                            {
                                <div>@(d.PdfProducer ?? "—")</div>
                                <div class="bp-muted">@(d.PdfCreator ?? "—")</div>
                            }
                        </td>
                        <td>
                            <div>@(d.PdfCreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                            <div class="bp-muted">@(d.PdfModifiedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                        </td>
                        <td title="@string.Join("\n", fonts)">@(fonts.Length == 0 ? "—" : fonts.Length.ToString())</td>
                        <td class="bp-mono" title="@hex">@hex[..12]…</td>
                        <td>
                            @if (d.ExtractStatus == ExtractStatus.Pending)
                            {
                                <span class="bp-muted"><i class="bi bi-hourglass-split"></i> Reading…</span>
                            }
                            else if (d.ExtractStatus == ExtractStatus.Failed)
                            {
                                <span class="bp-flag" title="@d.ExtractError"><i class="bi bi-exclamation-triangle"></i> Failed</span>
                            }
                            else
                            {
                                <span title="Read by Gemini">@d.ExtractStatus</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
