{
  "Security": {
    // true  = report violations to the browser console only (safe to trial)
    // false = enforce the Content-Security-Policy
    "CspReportOnly": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionStrings": {
      "PostgreSQL": "Host=localhost;Port=5432;Database=finrisklens;Username=postgres;Password=postgres;Include Error Detail=true"
    }
  },
  "EncryptionKey": "your-test-environment-key",
  "Smtp": {
    "Host": "gmail.com",
    "Port": 587,
    "Username": "test@gmail.com",
    "Password": "123456",
    "FromEmail": "test@gmail.com",
    "FromName": "FinRiskLensAI",
    "EnableSsl": true,
    "AllowCertificateNameMismatch": true,
    "TimeoutSeconds": 30
  },
  "Gcp": {
    "ProjectId": "finrisklensai"
  },
  "Gemini": {
    "ExtractModel": "gemini-3.5-flash",
    "ExtractLocation": "asia-south1",
    "FlashModel": "gemini-3.8-flash",
    "FlashLocation": "global",
    "ProModel": "gemini-3.1-pro-preview",
    "ProFallbackModel": "gemini-2.5-pro",
    "ProLocation": "global",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingLocation": "asia-south1",
    "EmbeddingDimensions": 768
  },
  "Gcs": {
    "CasesBucket": "finrisklensai-cases",
    "SourcesBucket": "finrisklensai-sources",
    "KnowledgeBucket": "finrisklensai-knowledge"
  },
  "Finvu": {
    "FinvuApi": "https://dhanaprayoga.fiu.finfactor.in/finsense/API/V2",
    "AaUserId": "channel@test",
    "AaPassword": "7777",
    "FinvuChannelId": "finsense",
    "CallbackUrl": ""
  },
  "Signzy": {
    "BaseUrl": "https://api-ipconfig.app/api/v3",
    "Authorization": "test-keys-for-api",
    "UseApi": false
  },
  "LoanCase": {
    "LenderId": "IBKL",
    "LenderName": "IDBI Bank",
    "OndcSubscriberId": "finrisklensai.com",
    "OndcSubscriberUri": "https://finrisklensai.com/ondc",
    "Endpoints": { "LOS": "", "ULI": "", "ONDC": "" },
    "ApiKeys": { "LOS": "", "ULI": "", "ONDC": "" }
  },
  "Jwt": {
    "Key": "test-jwt-key-to-be-updated",
    "Issuer": "FinRiskLensAI",
    "Audience": "MsmeClients",
    "ExpirySeconds": 3600
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
