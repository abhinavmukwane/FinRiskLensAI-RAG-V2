@model FinRiskLensAI.Models.FinancialReportViewModel
@using FinRiskLensAI.Core.Models.Scoring
@{
    Layout = null;
    var r = Model.Result;
    var u = Model.Udyam;
    var entityName = Model.EnterpriseName ?? Model.Uan ?? "Your Enterprise";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Financial Health Report | @entityName</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<link rel="stylesheet" href="~/css/theme.css" />
<script src="~/js/theme.js"></script>
<link rel="stylesheet" href="~/css/FinancialReport.css" />
</head>
<body>

<!-- ============ Utility bar ============ -->
<div class="print-bar py-2">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2" style="max-width:1220px;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-bar-graph" style="color:var(--maroon-deep);"></i>
            <span class="fhc-sub mb-0" style="font-weight:600;">Financial Health Report</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            @await Html.PartialAsync("_ThemeSwitch")
            <button class="btn btn-sm" style="background:var(--brand-btn-bg);color:var(--brand-btn-fg);border-radius:8px;" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print / Save PDF
            </button>
        </div>
    </div>
</div>

@if (Model.LoadError != null || !Model.HasResult)
{
    <div class="container py-5" style="max-width:720px;">
        <div class="fhc-card text-center py-5">
            <i class="bi bi-hourglass-split" style="font-size:3rem;color:var(--brand-secondary);"></i>
            <h5 class="fhc-title mt-3">Report not available</h5>
            <p class="fhc-sub mb-0">@(Model.LoadError ?? "No score has been computed yet for this account.")</p>
        </div>
    </div>
    return;
}

<!-- ============ Letterhead ============ -->
<div class="report-letterhead">
    <div class="container letterhead-inner" style="max-width:1220px;">
        <div class="brand-row mb-4">
            <div class="brand-mark">FR</div>
            <div>
                <div class="brand-name">FinRiskLens AI</div>
                <div class="brand-tag">MSME Credit Risk Intelligence</div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-4">
            <div>
                <div class="report-eyebrow">Financial Health Report</div>
                <div class="report-entity">@entityName</div>
                <div class="report-meta-line">
                    <span><i class="bi bi-patch-check"></i>@Model.Uan</span>
                    @if (r.Industry != null)
                    {
                        <span><i class="bi bi-broadcast"></i>@r.Industry.SectorName @(string.IsNullOrWhiteSpace(r.Industry.Nic2Digit) ? "" : $"· NIC {r.Industry.Nic2Digit}")</span>
                    }
                    <span><i class="bi bi-clock-history"></i>Generated @r.ComputedAt.ToString("dd MMM yyyy, HH:mm") UTC</span>
                </div>
            </div>
            <div class="score-plate">
                <div class="num">@r.OverallScore.ToString("0")</div>
                <div class="denom">SCORE OUT OF 1000</div>
                <div class="band"><i class="bi bi-patch-check-fill"></i> @r.ScoreBand</div>
            </div>
        </div>

        <div class="row g-3 hero-kpis">
            <div class="col-6 col-md-3">
                <div class="hero-kpi">
                    <div class="ic"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="v">₹@FormatInr(r.Lending?.MonthlySales ?? 0)</div>
                    <div class="k">Avg Monthly GST Sales</div>
                    <div class="d">@(r.GstAnalysis?.MonthlySales.Count ?? 0)-month filing window</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hero-kpi">
                    <div class="ic"><i class="bi bi-bank2"></i></div>
                    <div class="v">₹@FormatInr(r.Lending?.TotalIndicativeEligibility ?? 0)</div>
                    <div class="k">Total Credit Eligibility</div>
                    <div class="d">Working capital + term</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                @{ var compliance = DimByName(r.Dimensions, "Compliance Quotient"); }
                <div class="hero-kpi">
                    <div class="ic"><i class="bi bi-shield-check"></i></div>
                    <div class="v">@(compliance != null ? $"{compliance.Score:0} / {compliance.MaxPoints:0}" : "N/A")</div>
                    <div class="k">Compliance Quotient</div>
                    <div class="d">GST return filing history</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hero-kpi">
                    <div class="ic"><i class="bi bi-database-check"></i></div>
                    <div class="v">@(Model.Status?.FilesPresent.Count ?? 0)</div>
                    <div class="k">Data Files Analyzed</div>
                    <div class="d">GST · Bank · Udyam</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="fhc-wrap">
    <div class="container" style="max-width:1220px;">

        <!-- ===================== Executive Summary ===================== -->
        <div class="fhc-card mb-4">
            <div class="fhc-section-label"><i class="bi bi-stars"></i>Executive Summary</div>
            <p class="exec-summary mb-0">
                <strong>@entityName</strong> earns an overall Financial Health Score of
                <strong>@r.OverallScore.ToString("0") / 1000</strong>, placing it in the <strong>@r.ScoreBand</strong> band.
                @{
                    var strengths = r.Explanations.Where(e => e.Impact == ImpactDirection.Positive)
                        .OrderByDescending(e => e.RelativeWeight).Take(2).ToList();
                    var weakest = r.Dimensions.Where(d => d.MaxPoints > 0)
                        .OrderBy(d => d.Score / d.MaxPoints).FirstOrDefault();
                    var dscr = RatioByName(r.Lending?.Ratios, "DSCR (Debt Service Coverage)");
                    var penetration = RatioByName(r.Lending?.Ratios, "Banking Penetration");
                }
                @if (strengths.Count > 0)
                {
                    <text>The business shows <strong>@strengths[0].Dimension.ToLowerInvariant()</strong> (@strengths[0].ExplanationText.ToLowerInvariant())</text>
                    @if (strengths.Count > 1)
                    {
                        <text>, and <strong>@strengths[1].Dimension.ToLowerInvariant()</strong> (@strengths[1].ExplanationText.ToLowerInvariant())</text>
                    }
                    <text>. </text>
                }
                @if (dscr != null && dscr.Status != RatioStatus.NotAvailable)
                {
                    <text>Debt service coverage stands at <strong>@dscr.Display</strong> against a norm of @dscr.Benchmark. </text>
                }
                @if (weakest != null && weakest.MaxPoints > 0)
                {
                    var pct = Math.Round(weakest.Score / weakest.MaxPoints * 100);
                    <text>The main watch-item is <strong>@weakest.Dimension.ToLowerInvariant()</strong> (@pct% of maximum)@(penetration != null && penetration.Status == RatioStatus.Weak ? " — banking penetration is low relative to declared GST sales, so it's worth confirming the consented account is the primary operating account" : "").</text>
                }
                @if (r.Anomaly.IsAnomalous)
                {
                    <text> A cross-source income mismatch was flagged (anomaly score @r.Anomaly.AnomalyScore.ToString("0.00")) and should be reviewed before finalising limits.</text>
                }
                else
                {
                    <text> No cross-source income mismatch was found.</text>
                }
                @if (r.Financials?.HasFinancials != true)
                {
                    <text> ITR financials were unavailable for this cycle.</text>
                }
            </p>
        </div>

        <!-- ===================== Company Snapshot ===================== -->
        <div class="section-divider" id="snapshot"><span class="num">01</span><span class="txt">Company Snapshot</span><span class="line"></span></div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-building"></i>Entity Details</div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-signpost"></i></div><div><div class="k">Legal Name</div><div class="v">@entityName</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-diagram-2"></i></div><div><div class="k">Constitution</div><div class="v">@(u?.OrganizationType ?? "Not available")</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-patch-check"></i></div><div><div class="k">Udyam Registration</div><div class="v">@Model.Uan</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-broadcast-pin"></i></div><div><div class="k">Industry / NIC Code</div><div class="v">@(r.Industry != null ? $"{r.Industry.SectorName} — NIC {r.Industry.Nic2Digit ?? "n/a"}" : "Not classified")</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-geo-alt"></i></div><div><div class="k">State Jurisdiction</div><div class="v">@(u?.State ?? "Not available")@(!string.IsNullOrWhiteSpace(u?.GstinMasked) && u!.GstinMasked!.Length >= 2 ? $" (GST state code {u.GstinMasked.Substring(0, 2)})" : "")</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-graph-up"></i></div><div><div class="k">Sector Outlook</div><div class="v">@(r.Industry != null ? $"{r.Industry.Outlook} · risk weight {r.Industry.RiskWeight:0.00}" : "Not available")</div></div></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-clipboard-data"></i>Assessment Basis</div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-calendar-range"></i></div><div><div class="k">GST Return Window</div><div class="v">@WindowLabel(r.GstAnalysis?.MonthlySales.Keys)</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-calendar-range"></i></div><div><div class="k">Bank Statement Window</div><div class="v">@WindowLabel(r.BankAnalysis?.MonthlyAvgBalance.Keys)</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-cash-stack"></i></div><div><div class="k">Cumulative Declared GST Sales</div><div class="v">₹@FormatInr(r.GstAnalysis?.MonthlySales.Values.Sum() ?? 0) over @(r.GstAnalysis?.MonthlySales.Count ?? 0)-month window</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-cpu"></i></div><div><div class="k">Scoring Model</div><div class="v">@r.ModelVersion (Rules @r.HeuristicScore.ToString("0") · ML @r.MlCalibratedScore.ToString("0"))</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-hourglass-split"></i></div><div><div class="k">Report Validity</div><div class="v">90 days from generation date</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-fingerprint"></i></div><div><div class="k">Report ID</div><div class="v" style="font-family:var(--font-data);">@Model.ReportId</div></div></div>
                </div>
            </div>
        </div>

        <!-- Data sources -->
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3">
                <div class="source-chip @(r.GstAnalysis == null ? "off" : "")"><i class="bi bi-receipt"></i><div><div style="font-weight:600;">GST Returns</div><div class="fhc-sub" style="font-size:.72rem;">@(r.GstAnalysis != null ? "GSTR-1 & 3B" : "Not available")</div></div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="source-chip @(r.BankAnalysis == null ? "off" : "")"><i class="bi bi-bank"></i><div><div style="font-weight:600;">Bank (Account Aggregator)</div><div class="fhc-sub" style="font-size:.72rem;">@(r.BankAnalysis != null ? $"{r.BankAnalysis.MonthlyAvgBalance.Count} months" : "Not available")</div></div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="source-chip @(u?.HasData != true ? "off" : "")"><i class="bi bi-patch-check"></i><div><div style="font-weight:600;">Udyam Registration</div><div class="fhc-sub" style="font-size:.72rem;">@(u?.HasData == true ? "Verified" : "Not available")</div></div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="source-chip @(r.Financials?.HasFinancials != true ? "off" : "")"><i class="bi bi-file-earmark-text"></i><div><div style="font-weight:600;">ITR Financials</div><div class="fhc-sub" style="font-size:.72rem;">@(r.Financials?.HasFinancials == true ? $"AY {r.Financials.SourceYear}" : "Not available")</div></div></div>
            </div>
        </div>

        <!-- ===================== Score + Dimensions ===================== -->
        <div class="section-divider" id="dimensions"><span class="num">02</span><span class="txt">Score &amp; Dimension Analysis</span><span class="line"></span></div>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="fhc-card text-center">
                    <div class="fhc-section-label justify-content-center"><i class="bi bi-speedometer2"></i>Overall Financial Health Score</div>
                    <div class="gauge-box">
                        <canvas id="scoreGauge"></canvas>
                        <div class="gauge-center">
                            <div class="gauge-score">@r.OverallScore.ToString("0")</div>
                            <div class="gauge-of">out of 1000</div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <span class="band-chip band-@r.ScoreBand"><i class="bi bi-patch-check-fill"></i> @r.ScoreBand</span>
                    </div>
                    <div class="band-legend">
                        <span><i style="background:#c22f3e;"></i>High Risk &lt;350</span>
                        <span><i style="background:#e08a3c;"></i>At Risk 350–500</span>
                        <span><i style="background:#e6c34c;"></i>Fair 500–650</span>
                        <span><i style="background:#7fae5e;"></i>Good 650–800</span>
                        <span><i style="background:#2e7d4f;"></i>Excellent 800+</span>
                    </div>
                    <div class="fhc-sub mt-3">@entityName · computed @r.ComputedAt.ToString("dd MMM yyyy HH:mm") UTC</div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-bar-chart-steps"></i>Score Composition</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@r.HeuristicScore.ToString("0")</div><div class="k">Rules Engine</div></div></div>
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@r.MlCalibratedScore.ToString("0")</div><div class="k">ML Model</div></div></div>
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v" style="color:var(--emerald);">@(r.CashflowTrendSlope >= 0 ? "▲" : "▼") @Math.Abs(r.CashflowTrendSlope).ToString("0.00")</div><div class="k">Cashflow Trend</div></div></div>
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@(Model.Status?.FilesPresent.Count ?? 0)</div><div class="k">Data Files Used</div></div></div>
                    </div>

                    <div class="fhc-section-label mt-2">Six Dimensions</div>
                    @foreach (var d in r.Dimensions)
                    {
                        var pct = d.MaxPoints > 0 ? Math.Round(d.Score / d.MaxPoints * 100) : 0;
                        <div class="dim-row">
                            <div class="dim-name">
                                @d.Dimension
                                @if (d.UsedNeutralDefault) { <i class="bi bi-info-circle text-secondary" title="Neutral default used (New-to-Credit)"></i> }
                            </div>
                            <div class="dim-track"><div class="dim-fill" style="width:@(pct)%;"></div></div>
                            <div class="dim-val">@d.Score.ToString("0") / @d.MaxPoints.ToString("0")</div>
                        </div>
                    }
                    @if (r.ExcludedDimensions.Count > 0)
                    {
                        <div class="fhc-sub mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Score computed without: @string.Join(", ", r.ExcludedDimensions) — weights redistributed.</div>
                    }

                    <div class="row g-4 mt-1">
                        <div class="col-lg-6">
                            <div class="fhc-section-label">Dimension Radar</div>
                            <div class="chart-box" style="height:230px;"><canvas id="radarChart"></canvas></div>
                        </div>
                        <div class="col-lg-6">
                            <div class="fhc-section-label">Points Earned vs Maximum</div>
                            <div class="chart-box" style="height:230px;"><canvas id="barChart"></canvas></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (r.Lending != null)
        {
            var l = r.Lending;
            var dscrRatio = RatioByName(l.Ratios, "DSCR (Debt Service Coverage)");
            var foirRatio = RatioByName(l.Ratios, "FOIR (Obligations / Inflows)");
            var penetrationRatio = RatioByName(l.Ratios, "Banking Penetration");
            var volatilityRatio = RatioByName(l.Ratios, "Inflow Volatility (CV)");

            <div class="section-divider" id="lending"><span class="num">03</span><span class="txt">Bank Lending Assessment</span><span class="line"></span></div>

            <div class="fhc-card">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div class="fhc-section-label mb-0"><i class="bi bi-bank"></i>Lending Eligibility Summary</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (r.Industry != null)
                        {
                            <span class="badge" style="background:#e3f4ea;color:#0f5137;padding:7px 12px;">
                                <i class="bi bi-buildings me-1"></i>@r.Industry.SectorName — @r.Industry.Outlook outlook
                            </span>
                        }
                        <span class="fhc-sub">band factor ×@l.BandAdjustmentFactor.ToString("0.00") (@r.ScoreBand)</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid var(--maroon-deep);">
                            <div class="v">₹@FormatInr(l.WorkingCapitalLimit)</div><div class="k">Working Capital Limit</div>
                            <div class="fhc-sub" style="font-size:.7rem;">turnover method (20%)</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid var(--rose);">
                            <div class="v">₹@FormatInr(l.TermLoanCapacity)</div><div class="k">Term Loan Capacity</div>
                            <div class="fhc-sub" style="font-size:.7rem;">5 yr @@ 11% on EMI headroom</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid #0f5137;">
                            <div class="v">₹@FormatInr(l.TotalIndicativeEligibility)</div><div class="k">Total Indicative Eligibility</div>
                            <div class="fhc-sub" style="font-size:.7rem;">WC + term combined</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid var(--gold);">
                            <div class="v">₹@FormatInr(l.MarginMoneyRequired)</div><div class="k">Borrower Margin Required</div>
                            <div class="fhc-sub" style="font-size:.7rem;">5% of turnover (Nayak)</div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fhc-section-label"><i class="bi bi-calculator"></i>Credit Appraisal Ratios</div>
                        @foreach (var ratio in l.Ratios)
                        {
                            var badge = RatioBadge(ratio.Status);
                            <div class="ratio-row d-flex align-items-center gap-3">
                                <div style="flex:1;">
                                    <div style="font-size:.88rem;font-weight:600;color:#2b2026;">@ratio.Name</div>
                                    <div class="fhc-sub" style="font-size:.74rem;">@ratio.Description</div>
                                </div>
                                <div class="text-end" style="flex:0 0 90px;"><div class="mono" style="font-weight:700;color:var(--maroon-deep);">@ratio.Display</div><div class="fhc-sub" style="font-size:.7rem;">norm @ratio.Benchmark</div></div>
                                <span class="badge" style="flex:0 0 84px;background:@badge.bg;color:@badge.fg;">@badge.label</span>
                            </div>
                        }
                    </div>

                    <div class="col-lg-5">
                        <div class="fhc-section-label"><i class="bi bi-wallet2"></i>Monthly Cashflow &amp; EMI Capacity</div>
                        <div class="chart-box" style="height:230px;"><canvas id="lendingChart"></canvas></div>
                        <div class="lending-notes mt-3">
                            <div class="lending-notes-head"><i class="bi bi-journal-text"></i> How this was calculated</div>
                            @foreach (var note in l.Notes)
                            {
                                var isWarning = note.Contains("verify", StringComparison.OrdinalIgnoreCase)
                                             || note.Contains("No AA", StringComparison.OrdinalIgnoreCase);
                                <div class="lending-note @(isWarning ? "warn" : "")">
                                    <i class="bi @(isWarning ? "bi-exclamation-triangle-fill" : "bi-check2-circle")"></i><span>@note</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-lg-6">
                    <div class="fhc-card">
                        <div class="fhc-section-label"><i class="bi bi-clipboard2-check"></i>Loan &amp; Obligations</div>
                        <div class="oblig-row">
                            <div class="ic"><i class="bi bi-check-lg"></i></div>
                            <div class="name">Existing Loan EMI</div>
                            <div class="amt">₹@FormatInr(l.ExistingMonthlyEmi) / mo</div>
                        </div>
                        <div class="oblig-row">
                            <div class="ic"><i class="bi bi-check-lg"></i></div>
                            <div class="name">Credit Bureau Adverse History</div>
                            @{ var debtSvc = DimByName(r.Dimensions, "Debt Serviceability"); }
                            <div class="amt">@(debtSvc?.UsedNeutralDefault == true ? "New-to-Credit — none on file" : "Not evaluated this cycle")</div>
                        </div>
                        <div class="oblig-row">
                            <div class="ic"><i class="bi bi-check-lg"></i></div>
                            <div class="name">Cheque / ECS-NACH Bounces</div>
                            <div class="amt">@(r.BankAnalysis?.ChequeReturnCount ?? 0) / @(r.BankAnalysis?.EcsNachReturnCount ?? 0)</div>
                        </div>
                        @if (l.ExistingMonthlyEmi <= 0)
                        {
                            <div class="oblig-flag"><i class="bi bi-check-circle-fill"></i> No Existing Loan Obligations</div>
                        }
                        <div class="fhc-sub mt-2" style="font-size:.72rem;">Debt Serviceability used a neutral New-to-Credit default rather than penalising missing bureau history.</div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="fhc-card">
                        <div class="fhc-section-label"><i class="bi bi-shield-exclamation"></i>Risk Indicators</div>

                        @foreach (var (label, ratio) in new[] {
                            ("Banking Penetration", penetrationRatio),
                            ("Inflow Volatility (CV)", volatilityRatio),
                            ("FOIR (Obligations / Inflow)", foirRatio),
                            ("DSCR", dscrRatio)
                        })
                        {
                            if (ratio == null) { continue; }
                            var badge = RatioBadge(ratio.Status);
                            var width = RiskBarPercent(ratio.Status);
                            <div class="risk-row">
                                <div class="risk-row-head"><span class="name">@label</span><span class="val">@ratio.Display</span></div>
                                <div class="risk-track-row">
                                    <div class="risk-track"><div class="risk-fill" style="width:@(width)%;background:@badge.bar;"></div></div>
                                    <span class="risk-chip @badge.css">@badge.label</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (r.BankAnalysis != null)
        {
            var b = r.BankAnalysis;
            <div class="section-divider" id="bank"><span class="num">04</span><span class="txt">Bank Statement Analysis</span><span class="line"></span></div>

            <div class="fhc-card">
                <div class="fhc-section-label"><i class="bi bi-credit-card-2-front"></i>Account Aggregator Summary</div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.AverageMonthlyBalance)</div><div class="k">Avg Monthly Balance</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.PeakBalance)</div><div class="k">Peak Balance</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.CustomerReceiptsMonthly)</div><div class="k">Customer Receipts / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.SupplierPaymentsMonthly)</div><div class="k">Supplier Payments / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.CashDepositsMonthly)</div><div class="k">Cash Deposits / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.SalaryCreditsMonthly)</div><div class="k">Salary Credits / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v" style="color:@(b.ChequeReturnCount + b.EcsNachReturnCount > 0 ? "#8b1020" : "var(--emerald)");">@b.ChequeReturnCount / @b.EcsNachReturnCount</div><div class="k">Cheque / ECS-NACH Returns</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v" style="color:@(b.MinBalanceBreachCount + b.OverdrawnTxnCount > 0 ? "#9c4a00" : "var(--emerald)");">@b.MinBalanceBreachCount / @b.OverdrawnTxnCount</div><div class="k">Min-Bal Breaches / Overdrawn</div><div class="fhc-sub" style="font-size:.68rem;">OD limit ₹@FormatInr(b.OdLimitTotal)</div></div></div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fhc-section-label"><i class="bi bi-graph-up"></i>Monthly Average Balance Trend</div>
                        <div class="chart-box" style="height:230px;"><canvas id="balanceChart"></canvas></div>
                    </div>
                </div>
            </div>
        }

        @if (r.GstAnalysis != null)
        {
            var g = r.GstAnalysis;
            <div class="section-divider" id="gst"><span class="num">05</span><span class="txt">GST Deep-Dive</span><span class="line"></span></div>

            <div class="fhc-card">
                <div class="fhc-section-label"><i class="bi bi-receipt"></i>GST Filing &amp; Trade Concentration</div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v" style="color:@(g.R1Vs3bConsistency >= 0.9 ? "var(--emerald)" : "#9c4a00");">@(g.R1Vs3bConsistency > 0 ? g.R1Vs3bConsistency.ToString("P0") : "N/A")</div><div class="k">GSTR-1 vs 3B Consistency</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@(g.HasTaxPaymentData ? g.CashTaxShare.ToString("P0") : "N/A")</div><div class="k">Tax Paid in Cash</div><div class="fhc-sub" style="font-size:.68rem;">rest settled via ITC</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(g.ItcMonthlyAvg)</div><div class="k">Net ITC / month</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v" style="color:@(g.TopCustomerShare > 0.4 ? "#9c4a00" : "var(--emerald)");">@(g.TopCustomerShare > 0 ? g.TopCustomerShare.ToString("P0") : "N/A")</div><div class="k">Top Customer Share</div><div class="fhc-sub" style="font-size:.68rem;">top vendor @(g.TopVendorShare > 0 ? g.TopVendorShare.ToString("P0") : "N/A")</div></div></div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Monthly GST Sales</div>
                        <div class="chart-box" style="height:230px;"><canvas id="gstSalesChart"></canvas></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Major Customers (share of B2B sales)</div>
                        <div class="chart-box" style="height:230px;"><canvas id="customerChart"></canvas></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Major Vendors (share of purchases)</div>
                        <div class="chart-box" style="height:230px;"><canvas id="vendorChart"></canvas></div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="section-divider" id="risks"><span class="num">06</span><span class="txt">Strengths, Risks &amp; Recommendations</span><span class="line"></span></div>
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-arrow-up-circle-fill" style="color:var(--emerald);"></i>Key Strengths</div>
                    @{ var posExpl = r.Explanations.Where(e => e.Impact == ImpactDirection.Positive).OrderByDescending(e => e.RelativeWeight).ToList(); }
                    @if (posExpl.Count == 0)
                    {
                        <div class="fhc-sub py-3"><i class="bi bi-info-circle me-1"></i>No strengths surfaced by the model this cycle.</div>
                    }
                    @foreach (var e in posExpl)
                    {
                        <div class="expl-item"><i class="bi bi-check-circle-fill" style="color:var(--emerald);"></i><div><div class="expl-dim">@e.Dimension</div>@e.ExplanationText</div></div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="fhc-card mb-4">
                    <div class="fhc-section-label"><i class="bi bi-arrow-down-circle-fill" style="color:#8b1020;"></i>Risk Factors</div>
                    @{ var negExpl = r.Explanations.Where(e => e.Impact == ImpactDirection.Negative).OrderByDescending(e => e.RelativeWeight).ToList(); }
                    @if (negExpl.Count == 0)
                    {
                        <div class="fhc-sub py-3"><i class="bi bi-emoji-smile me-1"></i>No material risk factors surfaced by the model.</div>
                    }
                    @foreach (var e in negExpl)
                    {
                        <div class="expl-item"><i class="bi bi-exclamation-circle-fill" style="color:#9c4a00;"></i><div><div class="expl-dim">@e.Dimension</div>@e.ExplanationText</div></div>
                    }

                    <div class="fhc-section-label mt-2">Cross-Source Income Check</div>
                    <div class="anomaly-box">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <i class="bi @(r.Anomaly.IsAnomalous ? "bi-flag-fill" : "bi-shield-check")"></i>
                            <strong>@(r.Anomaly.IsAnomalous ? "Mismatch flagged for review" : "No cross-source mismatch flagged")</strong>
                            <span class="ms-auto fhc-sub">anomaly score @r.Anomaly.AnomalyScore.ToString("0.00")</span>
                        </div>
                        GST ₹@FormatInr(r.Anomaly.GstMonthlyTurnover)/mo · ITR ₹@FormatInr(r.Anomaly.ItrMonthlyIncome)/mo · Bank credits ₹@FormatInr(r.Anomaly.BankMonthlyCredits)/mo
                        @if (!string.IsNullOrEmpty(r.Anomaly.Note)) { <div class="fhc-sub mt-1">@r.Anomaly.Note</div> }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ============ Report footer ============ -->
<div class="report-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2" style="max-width:1220px;">
        <div class="fhc-sub"><i class="bi bi-shield-lock me-1"></i>Confidential — generated for internal credit assessment use only.</div>
        <div class="fhc-sub">FinRiskLens AI · Model @r.ModelVersion · Report ID @Model.ReportId</div>
    </div>
</div>

<script>
window.addEventListener('load', function () {
    if (typeof Chart === 'undefined') {
        document.querySelectorAll('.chart-box, .gauge-box').forEach(function (box) {
            box.innerHTML = '<div class="text-center text-muted small py-4"><i class="bi bi-wifi-off"></i> Chart library failed to load</div>';
        });
        return;
    }

    const dims = @Html.Raw(Json.Serialize(r.Dimensions.Select(d => new { dimension = d.Dimension, score = d.Score, maxPoints = d.MaxPoints })));
    const score = @r.OverallScore.ToString(System.Globalization.CultureInfo.InvariantCulture);
    // Brand colors follow the active theme (see ~/css/theme.css)
    const frlBrand = getComputedStyle(document.documentElement);
    const maroon = frlBrand.getPropertyValue('--brand-btn-bg').trim() || '#f37021';
    const rose = frlBrand.getPropertyValue('--brand-secondary').trim() || '#974354';

    const bandColors = ['#c22f3e', '#e08a3c', '#e6c34c', '#7fae5e', '#2e7d4f'];
    const needle = {
        id: 'needle',
        afterDatasetsDraw(chart) {
            const { ctx } = chart;
            const meta = chart.getDatasetMeta(0).data[0];
            const cx = meta.x, cy = meta.y, r = meta.outerRadius;
            const angle = Math.PI + (score / 1000) * Math.PI;
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(angle);
            ctx.beginPath();
            ctx.moveTo(0, -4); ctx.lineTo(r * 0.82, 0); ctx.lineTo(0, 4);
            ctx.fillStyle = maroon; ctx.fill();
            ctx.beginPath(); ctx.arc(0, 0, 8, 0, Math.PI * 2); ctx.fill();
            ctx.restore();
        }
    };
    if (document.getElementById('scoreGauge')) {
        new Chart(document.getElementById('scoreGauge'), {
            type: 'doughnut',
            data: { datasets: [{
                data: [350, 150, 150, 150, 200],
                backgroundColor: bandColors, borderWidth: 2, borderColor: '#fff'
            }]},
            options: {
                responsive: true,
                rotation: -90, circumference: 180, cutout: '72%',
                aspectRatio: 1.9,
                layout: { padding: { bottom: 4 } },
                plugins: { legend: { display: false }, tooltip: { enabled: false } },
                animation: { animateRotate: true }
            },
            plugins: [needle]
        });
    }

    if (document.getElementById('radarChart')) {
        new Chart(document.getElementById('radarChart'), {
            type: 'radar',
            data: {
                labels: dims.map(d => d.dimension.replace(' ', '\n')),
                datasets: [{
                    label: '% of maximum',
                    data: dims.map(d => d.maxPoints > 0 ? Math.round(d.score / d.maxPoints * 100) : 0),
                    backgroundColor: maroon + '2e', borderColor: maroon,
                    pointBackgroundColor: maroon, borderWidth: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: { r: { min: 0, max: 100, ticks: { stepSize: 20, backdropColor: 'transparent' }, pointLabels: { font: { size: 11 } } } },
                plugins: { legend: { display: false } }
            }
        });
    }

    if (document.getElementById('barChart')) {
        new Chart(document.getElementById('barChart'), {
            type: 'bar',
            data: {
                labels: dims.map(d => d.dimension),
                datasets: [
                    { label: 'Earned', data: dims.map(d => d.score), backgroundColor: maroon, borderRadius: 6 },
                    { label: 'Maximum', data: dims.map(d => d.maxPoints), backgroundColor: frlBrand.getPropertyValue('--brand-tint-bg-2').trim() || '#f2e6ea', borderRadius: 6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                indexAxis: 'y',
                scales: { x: { beginAtZero: true, max: 260 } },
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }

    const lendingEl = document.getElementById('lendingChart');
    if (lendingEl) {
        const lend = @Html.Raw(Json.Serialize(r.Lending == null ? null : new {
            inflow = r.Lending.MonthlyBankInflow,
            outflow = r.Lending.MonthlyBankOutflow,
            surplus = Math.Max(0, r.Lending.MonthlySurplus),
            existingEmi = r.Lending.ExistingMonthlyEmi,
            affordableEmi = r.Lending.AffordableMonthlyEmi
        }));
        if (lend) {
            new Chart(lendingEl, {
                type: 'bar',
                data: {
                    labels: ['Bank Inflow', 'Bank Outflow', 'Surplus', 'Existing EMI', 'EMI Headroom'],
                    datasets: [{
                        data: [lend.inflow, lend.outflow, lend.surplus, lend.existingEmi, lend.affordableEmi],
                        backgroundColor: ['#2e7d4f', '#c22f3e', '#7fae5e', '#e08a3c', maroon],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => '₹' + new Intl.NumberFormat('en-IN').format(Math.round(c.parsed.y)) + '/mo' } }
                    },
                    scales: { y: { beginAtZero: true, ticks: { callback: v => '₹' + new Intl.NumberFormat('en-IN', { notation: 'compact' }).format(v) } } }
                }
            });
        }
    }

    const monthLabel = k => {
        const names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        return names[parseInt(k.substring(4)) - 1] + ' ' + k.substring(2, 4);
    };
    const inr = v => '₹' + new Intl.NumberFormat('en-IN', { notation: 'compact' }).format(v);

    const bank = @Html.Raw(Json.Serialize(r.BankAnalysis == null ? null : new {
        balances = r.BankAnalysis.MonthlyAvgBalance
    }));
    if (bank && document.getElementById('balanceChart')) {
        const keys = Object.keys(bank.balances).sort();
        new Chart(document.getElementById('balanceChart'), {
            type: 'line',
            data: { labels: keys.map(monthLabel), datasets: [{
                data: keys.map(k => bank.balances[k]),
                borderColor: maroon, backgroundColor: maroon + '1f',
                fill: true, tension: .35, pointBackgroundColor: maroon
            }]},
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => inr(c.parsed.y) } } },
                scales: { y: { ticks: { callback: inr } } } }
        });
    }

    const gst = @Html.Raw(Json.Serialize(r.GstAnalysis == null ? null : new {
        sales = r.GstAnalysis.MonthlySales,
        customers = r.GstAnalysis.TopCustomers,
        vendors = r.GstAnalysis.TopVendors
    }));
    if (gst && document.getElementById('gstSalesChart')) {
        const saleKeys = Object.keys(gst.sales).sort();
        new Chart(document.getElementById('gstSalesChart'), {
            type: 'bar',
            data: { labels: saleKeys.map(monthLabel), datasets: [{
                data: saleKeys.map(k => gst.sales[k]), backgroundColor: maroon, borderRadius: 6
            }]},
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => inr(c.parsed.y) } } },
                scales: { y: { beginAtZero: true, ticks: { callback: inr } } } }
        });
        const shareBar = (id, data, color) => {
            const keys = Object.keys(data);
            if (keys.length === 0) { const el = document.getElementById(id); if (el) el.replaceWith('No data'); return; }
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: { labels: keys, datasets: [{
                    data: keys.map(k => Math.round(data[k] * 100)), backgroundColor: color, borderRadius: 6
                }]},
                options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.parsed.x + '% share' } } },
                    scales: { x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } },
                              y: { ticks: { font: { size: 9, family: 'monospace' } } } } }
            });
        };
        if (document.getElementById('customerChart')) shareBar('customerChart', gst.customers, rose);
        if (document.getElementById('vendorChart')) shareBar('vendorChart', gst.vendors, '#c98a2b');
    }

    // Ensure every Chart.js canvas redraws at the right size for print/PDF export,
    // since the print stylesheet reflows two-column sections to a single column.
    const resizeAllCharts = () => {
        Object.values(Chart.instances || {}).forEach(c => { try { c.resize(); } catch (e) {} });
    };
    window.addEventListener('beforeprint', resizeAllCharts);
    if (window.matchMedia) {
        window.matchMedia('print').addEventListener('change', mql => { if (mql.matches) resizeAllCharts(); });
    }
});
</script>
</body>
</html>

@functions {
    private static string FormatInr(double v)
    {
        if (v >= 10_000_000) return (v / 10_000_000).ToString("0.##") + " Cr";
        if (v >= 100_000) return (v / 100_000).ToString("0.##") + " L";
        return v.ToString("N0");
    }

    private static FinRiskLensAI.Core.Models.Scoring.DimensionScore? DimByName(
        List<FinRiskLensAI.Core.Models.Scoring.DimensionScore> dims, string name)
        => dims.FirstOrDefault(d => string.Equals(d.Dimension, name, StringComparison.OrdinalIgnoreCase));

    private static FinRiskLensAI.Core.Models.Scoring.LendingRatio? RatioByName(
        List<FinRiskLensAI.Core.Models.Scoring.LendingRatio>? ratios, string name)
        => ratios?.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase));

    /// <summary>Formats a set of yyyyMM keys as "Mon yyyy – Mon yyyy (N months)".</summary>
    private static string WindowLabel(IEnumerable<string>? keys)
    {
        var list = keys?.OrderBy(k => k).ToList() ?? new List<string>();
        if (list.Count == 0) return "Not available";
        string Label(string k) => new DateTime(int.Parse(k.Substring(0, 4)), int.Parse(k.Substring(4, 2)), 1).ToString("MMM yyyy");
        return list.Count == 1
            ? $"{Label(list[0])} (1 month)"
            : $"{Label(list[0])} – {Label(list[^1])} ({list.Count} months)";
    }

    private static (string bg, string fg, string bar, string css, string label) RatioBadge(FinRiskLensAI.Core.Models.Scoring.RatioStatus status) => status switch
    {
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Strong => ("#e3f4ea", "#0f5137", "#2e7d4f", "strong", "Strong"),
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Adequate => ("#fdf3d7", "#8a6d00", "#e6c34c", "adequate", "Adequate"),
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Weak => ("#fbe0e0", "#8b1020", "#c22f3e", "weak", "Weak"),
        _ => ("#efefef", "#777", "#bbb", "", "No data"),
    };

    private static int RiskBarPercent(FinRiskLensAI.Core.Models.Scoring.RatioStatus status) => status switch
    {
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Strong => 92,
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Adequate => 58,
        FinRiskLensAI.Core.Models.Scoring.RatioStatus.Weak => 22,
        _ => 4,
    };
}
