@{
    ViewBag.Title = "CustDashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var currentUser = Context.Session.GetCurrentUser();
    var enterpriseName = string.IsNullOrWhiteSpace(currentUser?.NameOfEnterprise)
        ? "there" : currentUser!.NameOfEnterprise;
    var aaid = currentUser.MobileNumber + "@finvu";
    var gstn = currentUser.GstinNumber;

    // Client IP captured on the session user at login — shown in the "Secure Connection IP" badge.
    var clientIp = currentUser?.ClientIP;
    if (string.IsNullOrWhiteSpace(clientIp)) clientIp = "N/A";
}

<div class="container-fluid py-5">

    <!-- Welcome greeting -->
    <div class="welcome-banner mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="greeting">Welcome back</div>
            <div class="enterprise">
                <i class="bi bi-buildings me-2"></i>@enterpriseName
            </div>
        </div>

        <!-- Secure Connection IP badge — click opens the Source IP Security Audit popup -->
        <div class="ip-header-badge" id="ipHeaderBadge" role="button" tabindex="0"
             data-bs-toggle="modal" data-bs-target="#ipAuditModal">
            <span class="ip-pulse-dot"></span>
            <span class="ip-badge-text">Secure Connection IP:</span>
            <span class="ip-badge-value" id="ipBadgeValue">@clientIp</span>
        </div>
        @* @if (currentUser != null)
        {
            <div class="meta">
                @if (!string.IsNullOrWhiteSpace(currentUser.UdyamNumber))
                {
                    <span>Udyam: @currentUser.UdyamNumber</span>
                }
                @if (!string.IsNullOrWhiteSpace(currentUser.GstinNumber))
                {
                    <span>GSTIN: @currentUser.GstinNumber</span>
                }
                @if (!string.IsNullOrWhiteSpace(currentUser.PanNumber))
                {
                    <span>PAN: @currentUser.PanNumber</span>
                }
            </div>
        } *@
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 mb-4 mb-md-0">
            <div class="verify-panel p-4">

                <h4 class="fw-bold mb-4">Lets get start</h4>

                <div class="verify-card mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">GST</h6>
                            <small class="text-muted">Goods & Services Tax Verification</small>
                        </div>

                        <button class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#verificationModal" data-title="Fetch GSTR Details">
                            Fetch Details
                        </button>
                    </div>
                </div>

                <div class="verify-card mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Account Aggregator</h6>
                            <small class="text-muted">Bank Statement Verification</small>
                        </div>

                        <button type="button"
                                class="btn btn-submit"
                                data-bs-toggle="modal"
                                data-bs-target="#aaConsentModal">
                            Fetch Details
                        </button>
                    
                    </div>
                </div>

                <div class="verify-card mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">ITR</h6>
                            <small class="text-muted">Income Tax Return Verification</small>
                        </div>
                        <button class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#itrModal" data-title="Fetch ITR Details">
                            Fetch Details
                        </button>
                    </div>
                </div>

                <div class="verify-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">MCA</h6>
                            <small class="text-muted">Corporate Affairs &amp; Director Verification</small>
                        </div>
                        <button class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#mcaModal">
                            Fetch Details
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex flex-column gap-3">

                <!-- GST -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:var(--brand-tint-bg-2); border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-receipt-cutoff text-danger fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Goods & Services Tax
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                View GST filings, turnover, tax payments, and compliance history.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Account Aggregator -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:var(--brand-tint-bg-2); border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-bank2 text-success fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Account Aggregator
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                Securely access bank account data to analyze cash flow and transactions.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Income Tax Return -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:var(--brand-tint-bg-2); border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-file-earmark-text-fill text-warning fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Income Tax Return
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                Verify declared income, tax filings, and financial stability.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Corporate Affairs (MCA) -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:var(--brand-tint-bg-2); border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-building-check text-info fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Corporate Affairs
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            <span>
                                Confirm company status, paid-up capital, registered charges and director DIN records.
                            </span>
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@* Leaflet map (for the Source IP Security Audit popup) *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

@* ===== Source IP Security Audit popup ===== *@
<div class="modal fade ip-audit" id="ipAuditModal" tabindex="-1" aria-labelledby="ipAuditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="ip-audit-header">
                <div class="header-title-container">
                    <div class="header-icon"><i class="bi bi-globe"></i></div>
                    <h5 id="ipAuditLabel" class="header-title">Source IP Security Audit</h5>
                </div>
                <button type="button" class="close-button" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="ip-audit-body">

                <!-- Empty state (no IP response cached) -->
                <div id="ipAuditEmpty" class="text-center py-5" style="display:none;">
                    <i class="bi bi-shield-exclamation" style="font-size:2.5rem;color:#b26a00;"></i>
                    <p class="mt-3 mb-0 text-muted">No IP verification data has been recorded for your account yet.</p>
                </div>

                <!-- Loaded content -->
                <div id="ipAuditContent">

                    <!-- Trust alert banner -->
                    <div id="ipTrustAlert" class="trust-alert-banner secure">
                        <div class="d-flex align-items-center gap-3">
                            <i id="ipTrustIcon" class="bi bi-shield-fill-check alert-icon-ring"></i>
                            <div class="alert-body-content">
                                <h6 id="ipTrustTitle" class="alert-title-text">IP Address Verified &amp; Trusted</h6>
                                <p id="ipTrustDesc" class="alert-desc-text"></p>
                            </div>
                        </div>
                        <span id="ipTrustBadge" class="pill-badge">SECURE</span>
                    </div>

                    <!-- Panel row: fraud gauge + integrity checks/specs -->
                    <div class="audit-panel-row">

                        <!-- Fraud score -->
                        <div class="panel-card d-flex flex-column align-items-center justify-content-center text-center">
                            <div class="w-100">
                                <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                                    <span class="panel-title mb-0">Fraud Index Analysis</span>
                                    <span class="tooltip-trigger">
                                        <i class="bi bi-info-circle-fill"></i>
                                        <span class="custom-tooltip">
                                            <span class="tooltip-highlight">Less fraud score is best</span> (0% to 20%). A
                                            <span class="tooltip-alert-text">high score</span> means potential VPN/Proxy activity and alertness is required.
                                        </span>
                                    </span>
                                </div>

                                <div class="fraud-gauge-wrapper">
                                    <svg viewBox="0 0 160 160">
                                        <circle class="gauge-ring-bg" cx="80" cy="80" r="70"></circle>
                                        <circle id="ipGauge" class="gauge-ring-fill" cx="80" cy="80" r="70"></circle>
                                    </svg>

                                    <div class="spark-emitter-overlay">
                                        <div class="emitter-head">
                                            <div class="spark-slot s1"><div class="spark-line l1"></div></div>
                                            <div class="spark-slot s2"><div class="spark-line l2"></div></div>
                                            <div class="spark-slot s3"><div class="spark-line l3"></div></div>
                                            <div class="spark-slot s4"><div class="spark-line l4"></div></div>
                                            <div class="spark-slot s5"><div class="spark-line l5"></div></div>
                                            <div class="spark-slot s6"><div class="spark-line l6"></div></div>
                                            <div class="spark-slot s7"><div class="spark-line l7"></div></div>
                                            <div class="spark-slot s8"><div class="spark-line l8"></div></div>
                                        </div>
                                    </div>

                                    <div class="gauge-inner-info">
                                        <span id="ipGaugeVal" class="gauge-inner-value">0%</span>
                                        <span class="gauge-inner-label">Fraud Score</span>
                                    </div>
                                </div>
                            </div>

                            <div class="w-100 mt-2">
                                <span id="ipTrustPill" class="badge bg-success-subtle text-success px-3 py-2 rounded-pill"
                                      style="font-size:11px;border:1px solid rgba(46,125,50,.1);">
                                    <i class="bi bi-shield-check me-1"></i> Trust Verified
                                </span>
                            </div>
                        </div>

                        <!-- Integrity checks + network specs -->
                        <div class="panel-card">
                            <h6 class="panel-title"><i class="bi bi-shield-check"></i>Connection Integrity Checks</h6>
                            <div class="pop-check-grid">
                                <div class="pop-check-card" id="ipChkVpn">
                                    <div class="check-icon-box"><i class="bi bi-shield-slash"></i></div>
                                    <div>
                                        <h6 class="check-title-lbl">VPN Status</h6>
                                        <p class="check-status-lbl">—</p>
                                    </div>
                                </div>
                                <div class="pop-check-card" id="ipChkProxy">
                                    <div class="check-icon-box"><i class="bi bi-server"></i></div>
                                    <div>
                                        <h6 class="check-title-lbl">Proxy Check</h6>
                                        <p class="check-status-lbl">—</p>
                                    </div>
                                </div>
                                <div class="pop-check-card" id="ipChkTor">
                                    <div class="check-icon-box"><i class="bi bi-layers"></i></div>
                                    <div>
                                        <h6 class="check-title-lbl">Tor Exit Node</h6>
                                        <p class="check-status-lbl">—</p>
                                    </div>
                                </div>
                                <div class="pop-check-card" id="ipChkBot">
                                    <div class="check-icon-box"><i class="bi bi-robot"></i></div>
                                    <div>
                                        <h6 class="check-title-lbl">Bot Traffic</h6>
                                        <p class="check-status-lbl">—</p>
                                    </div>
                                </div>
                            </div>

                            <h6 class="panel-title mt-4 mb-2"><i class="bi bi-hdd-network"></i>Network Specifications</h6>
                            <ul class="specs-list">
                                <li><span>Internet Service Provider (ISP)</span><strong id="ipIsp">—</strong></li>
                                <li><span>Organization / Carrier</span><strong id="ipOrg">—</strong></li>
                                <li><span>Autonomous System Number (ASN)</span><strong id="ipAsn">—</strong></li>
                                <li><span>Connection Protocol</span><strong id="ipProto">—</strong></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Geo details + map -->
                    <div class="geo-split-grid">
                        <div class="panel-card d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="panel-title"><i class="bi bi-geo-alt"></i>Geographical Details</h6>
                                <ul class="specs-list">
                                    <li><span>Country / Code</span><strong id="ipCountry">—</strong></li>
                                    <li><span>State / Territory</span><strong id="ipRegion">—</strong></li>
                                    <li><span>City / Locality</span><strong id="ipCity">—</strong></li>
                                    <li><span>Coordinates</span><strong id="ipCoords">—</strong></li>
                                    <li><span>Verified On</span><strong id="ipVerifiedOn">—</strong></li>
                                </ul>
                            </div>
                            <div class="mt-4 d-grid">
                                <a id="ipMapsLink" href="#" target="_blank" class="btn btn-outline-theme">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>Open in Google Maps
                                </a>
                            </div>
                        </div>

                        <div class="map-wrapper">
                            <div id="popupMap"></div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@* Modal *@

<div class="modal fade" id="verificationModal" tabindex="-1" data-bs-backdrop="static"
     aria-labelledby="verificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title " id="verificationModalLabel">
                        Fetch GSTR Details
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- User ID -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        GST Number
                    </label>
                    <input type="text" id="gstNumber" class="form-control custom-input" placeholder="Enter User ID" value="@gstn" disabled readonly>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>
                    <input type="password" id="gstPassword" class="form-control custom-input" placeholder="Enter Password">
                    <div class="invalid-feedback">Please enter your GST portal password.</div>
                </div>

                <!-- Consent -->
                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="gstConsent">

                        <label class="form-check-label" for="gstConsent">
                            I authorize the platform to securely access my
                            <strong>GSTR details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>
                <div id="gstFetchStatus" class="small mt-2"></div>

            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" id="fetchGstrBtn" class="btn btn-theme w-100">Fetch GSTR Details</button>
            </div>

        </div>
    </div>

</div>

@* ===================== MCA — Corporate Affairs & Directors ===================== *@
<div class="modal fade" id="mcaModal" tabindex="-1" data-bs-backdrop="static"
     aria-labelledby="mcaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title" id="mcaModalLabel">Fetch MCA Details</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Company Name</label>
                    <input type="text" class="form-control custom-input" value="@enterpriseName" disabled readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Udyam Registration Number</label>
                    <input type="text" class="form-control custom-input" value="@currentUser?.UdyamNumber" disabled readonly>
                </div>

                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="mcaConsent">
                        <label class="form-check-label" for="mcaConsent">
                            I authorize the platform to securely retrieve my
                            <strong>Ministry of Corporate Affairs (MCA)</strong> company record
                            and the <strong>DIN details of my directors</strong> for verification
                            purposes. I understand this data will be used only for credit
                            assessment and handled securely.
                        </label>
                    </div>
                </div>

                <div id="mcaFetchStatus" class="small mt-2"></div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" id="fetchMcaBtn" class="btn btn-theme w-100">Fetch MCA Details</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="aaConsentModal" tabindex="-1" aria-labelledby="aaConsentModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="aaConsentModalLabel">
                    Account Aggregator Consent
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Account Aggregator ID
                    </label>
                    <input type="text" class="form-control custom-input" placeholder="Enter Mobile Number" value="@aaid" disabled readonly>
                </div>
                <div class="consent-box">

                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="aaConsent">

                        <label class="form-check-label" for="aaConsent">
                            I authorize the platform to securely access my
                            <strong>Bank Account Statements</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>
                <div id="aaFetchStatus" class="small mt-2"></div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" id="fetchAaBtn" class="btn btn-theme w-100"> Fetch AA Details</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="itrModal" tabindex="-1" aria-labelledby="itrModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="itrModalLabel">
                    Income Tax Return Verification
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

             <div class="modal-body">

                <!-- User ID -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        User ID
                    </label>
                    <input type="text" class="form-control custom-input"  placeholder="Enter User ID">
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <!-- Consent -->
                <div class="consent-box">

                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="consentCheck">

                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>
            </div>

              <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch ITR Details</button>
            </div>

        </div>
    </div>
</div>


   <script>
       const verificationModal = document.getElementById('verificationModal');
       
        verificationModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const title = button.getAttribute('data-title');

            verificationModal.querySelector('.modal-title').textContent = title;
        });

        // ---------- Fetch GSTR: validate the modal, then seed GST data ----------
        document.getElementById('fetchGstrBtn').addEventListener('click', async function () {
            const gst = document.getElementById('gstNumber');
            const pwd = document.getElementById('gstPassword');
            const consent = document.getElementById('gstConsent');
            const status = document.getElementById('gstFetchStatus');
            status.textContent = '';

            // Validate every field.
            let ok = true;
            if (!gst.value.trim()) { status.innerHTML = '<span class="text-danger">No GST number linked to your account.</span>'; ok = false; }
            pwd.classList.toggle('is-invalid', !pwd.value.trim());
            if (!pwd.value.trim()) ok = false;
            consent.classList.toggle('is-invalid', !consent.checked);
            if (!consent.checked) { status.innerHTML = '<span class="text-danger">Please accept the consent to continue.</span>'; ok = false; }
            if (!ok) return;

            this.disabled = true;
            status.innerHTML = '<span class="text-muted">Fetching GSTR details…</span>';
            try {
                const resp = await fetch('/Dashboard/SeedFinancialData');
                const res = await resp.json();
                if (res.status) {
                    status.innerHTML = '<span class="text-success">' + res.message + ' Redirecting…</span>';
                    // Best-effort — fires before navigating away; no-ops if a score
                    // hasn't been computed yet (nothing to email on a first fetch).
                    const theme = localStorage.getItem('frl-theme') || 'theme1';
                    fetch('/Dashboard/SendFinancialHealthReportEmail?theme=' + encodeURIComponent(theme), { method: 'POST' }).catch(() => {});
                    setTimeout(() => window.location.href = '/Dashboard/FinancialHealthCard', 1200);
                } else {
                    status.innerHTML = '<span class="text-danger">' + res.message + '</span>';
                    this.disabled = false;
                }
            } catch (e) {
                status.innerHTML = '<span class="text-danger">Something went wrong. Please try again.</span>';
                this.disabled = false;
            }
        });

        // ---------- Fetch MCA: validate consent, then seed the MCA + DIN records ----------
        document.getElementById('fetchMcaBtn').addEventListener('click', async function () {
            const consent = document.getElementById('mcaConsent');
            const status = document.getElementById('mcaFetchStatus');
            status.textContent = '';

            consent.classList.toggle('is-invalid', !consent.checked);
            if (!consent.checked) {
                status.innerHTML = '<span class="text-danger">Please accept the consent to continue.</span>';
                return;
            }

            this.disabled = true;
            status.innerHTML = '<span class="text-muted">Fetching MCA &amp; director details…</span>';
            try {
                const resp = await fetch('/Dashboard/SeedMcaData');
                const res = await resp.json();
                if (res.status) {
                    status.innerHTML = '<span class="text-success">' + res.message + ' Redirecting…</span>';
                    setTimeout(() => window.location.href = '/Mca/MCADetails', 1200);
                } else {
                    status.innerHTML = '<span class="text-danger">' + res.message + '</span>';
                    this.disabled = false;
                }
            } catch (e) {
                status.innerHTML = '<span class="text-danger">Something went wrong. Please try again.</span>';
                this.disabled = false;
            }
        });

        // Clear the consent error as soon as the user ticks it
        document.getElementById('mcaConsent').addEventListener('change', function () {
            if (this.checked) {
                this.classList.remove('is-invalid');
                document.getElementById('mcaFetchStatus').textContent = '';
            }
        });

        // ---------- Fetch AA: validate consent, create consent request, open URL in new tab ----------
        document.getElementById('fetchAaBtn').addEventListener('click', async function () {
            const btn = this;
            const consent = document.getElementById('aaConsent');
            const status = document.getElementById('aaFetchStatus');
            status.textContent = '';

            consent.classList.toggle('is-invalid', !consent.checked);
            if (!consent.checked) {
                status.innerHTML = '<span class="text-danger">Please accept the consent to continue.</span>';
                return;
            }

            // Open the tab now, inside the click gesture, so the popup blocker allows it;
            // we set its URL once the consent request comes back.
            const aaWin = window.open('', '_blank');

            // Disable so the consent can only be initiated once; re-enable only on failure.
            btn.disabled = true;
            status.innerHTML = '<span class="text-muted">Creating consent request…</span>';
            try {
                const resp = await fetch('/Dashboard/InitiateAAFetch', { method: 'POST' });
                const res = await resp.json();
                if (res.status && res.url) {
                    status.innerHTML = '<span class="text-success">' + res.message + '</span>';
                    if (aaWin) aaWin.location.href = res.url; else window.open(res.url, '_blank');
                } else {
                    if (aaWin) aaWin.close();
                    status.innerHTML = '<span class="text-danger">' + res.message + '</span>';
                    btn.disabled = false;
                }
            } catch (e) {
                if (aaWin) aaWin.close();
                status.innerHTML = '<span class="text-danger">Something went wrong. Please try again.</span>';
                btn.disabled = false;
            }
        });
   </script>

