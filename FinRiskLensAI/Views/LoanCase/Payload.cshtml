@model FinRiskLensAI.Controllers.PayloadPageModel
@{
    Layout = null;
    var isReceipt = Model.Mode == "receipt";
    var stateClass = (Model.Status ?? (Model.IsLive ? "Sent" : "Simulated")).ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title · FinRiskLens AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/theme.css" rel="stylesheet" />
    <style>
        /* Standalone page: no portal chrome, just the payload and what it needs to be read. */
        :root { --pl-bg: #f4f6f8; --pl-ink: #1f2933; --pl-muted: #6b7c86; --pl-line: #e1e6ea; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--pl-bg); color: var(--pl-ink); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; }
        .pl-bar { background: var(--brand-primary, #005b4c); color: #fff; padding: 16px 28px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
        .pl-bar h1 { font-size: 1.05rem; margin: 0; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .pl-bar .meta { display: flex; gap: 22px; flex-wrap: wrap; font-size: .8rem; opacity: .92; margin-left: auto; }
        .pl-bar .meta b { display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; opacity: .7; font-weight: 600; }
        .pl-chip { display: inline-block; font-size: .68rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .04em; }
        .pl-chip.sent { background: #e3f4ea; color: #1a6e43; }
        .pl-chip.simulated { background: #fdf3d7; color: #8c5c0d; }
        .pl-chip.failed { background: #fbe0e0; color: #8b1020; }
        .pl-chip.preview { background: #e8eef8; color: #2c4a7a; }
        .pl-wrap { max-width: 1200px; margin: 22px auto; padding: 0 22px; }
        .pl-note { background: #fff; border: 1px solid var(--pl-line); border-radius: 12px; padding: 12px 16px; font-size: .84rem; color: var(--pl-muted); margin-bottom: 14px; display: flex; gap: 10px; align-items: flex-start; }
        .pl-note i { color: var(--brand-primary, #005b4c); margin-top: 2px; }
        .pl-card { background: #fff; border: 1px solid var(--pl-line); border-radius: 14px; overflow: hidden; margin-bottom: 16px; }
        .pl-card-h { display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; border-bottom: 1px solid var(--pl-line); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--pl-muted); }
        .pl-btn { border: 1px solid var(--pl-line); background: #fff; border-radius: 8px; padding: 5px 11px; font-size: .78rem; font-weight: 600; cursor: pointer; color: var(--pl-ink); }
        .pl-btn:hover { border-color: var(--brand-primary, #005b4c); color: var(--brand-primary, #005b4c); }
        pre { margin: 0; padding: 18px 20px; font: 12.5px/1.55 ui-monospace, 'Cascadia Code', Consolas, monospace; overflow: auto; white-space: pre; max-height: 78vh; color: #1f2933; }
        .k { color: #005b4c; } .s { color: #a3410e; } .n { color: #1d4ed8; } .b { color: #7c3aed; } .z { color: #9aa5b1; }
        .pl-err { background: #fdf0ef; border: 1px solid #f3c9c6; color: #a5342f; border-radius: 12px; padding: 16px 18px; }
        @@media print { .pl-bar, .pl-btn, .pl-note { display: none; } pre { max-height: none; } }
    </style>
</head>
<body>
@if (Model.Mode == "error")
{
    <div class="pl-wrap"><div class="pl-err"><i class="bi bi-exclamation-triangle-fill"></i> @Model.LoadError</div></div>
}
else
{
    <div class="pl-bar">
        <h1>
            <i class="bi bi-send-check"></i>
            @Model.Channel loan case
            <span class="pl-chip @(isReceipt ? stateClass : "preview")">@(isReceipt ? Model.Status : "Preview")</span>
        </h1>
        <div class="meta">
            <div><b>Enterprise</b>@(Model.EnterpriseName ?? Model.Uan)</div>
            <div><b>UAN</b>@Model.Uan</div>
            <div><b>Score</b>@Model.Score.ToString("0") · @Model.Band</div>
            @if (isReceipt)
            {
                <div><b>Case reference</b>@(Model.CaseReference ?? "—")</div>
                <div><b>Pushed</b>@(Model.PushedAt?.ToString("dd MMM yyyy HH:mm") ?? "—") UTC by @Model.PushedBy</div>
            }
            <div><b>Endpoint</b>@(Model.Endpoint ?? "not configured — simulated")@(Model.HttpStatus.HasValue ? $" · HTTP {Model.HttpStatus}" : "")</div>
        </div>
    </div>

    <div class="pl-wrap">
        @if (!isReceipt)
        {
            <div class="pl-note">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    This is the exact payload that <strong>Confirm push</strong> will send to <strong>@Model.Channel</strong>. Nothing has been sent yet.
                    @if (!Model.IsLive)
                    {
                        <text> No @Model.Channel endpoint is configured, so the push will be recorded as <strong>Simulated</strong> — set <code>LoanCase:Endpoints:@Model.Channel</code> to go live.</text>
                    }
                </div>
            </div>
        }
        else if (Model.Status == "Simulated")
        {
            <div class="pl-note">
                <i class="bi bi-info-circle-fill"></i>
                <div>Recorded locally: no <strong>@Model.Channel</strong> endpoint was configured when this case was raised. The payload below is what would have gone over the wire.</div>
            </div>
        }
        else if (Model.Status == "Failed")
        {
            <div class="pl-err" style="margin-bottom:14px;"><i class="bi bi-x-octagon-fill"></i> @Model.Channel rejected the case: @(Model.ErrorMessage ?? "see response below")</div>
        }

        <div class="pl-card">
            <div class="pl-card-h">
                <span>Payload</span>
                <button type="button" class="pl-btn" onclick="copyJson('payload', this)"><i class="bi bi-clipboard"></i> Copy JSON</button>
            </div>
            <pre id="payload">@Model.PayloadJson</pre>
        </div>

        @if (isReceipt && !string.IsNullOrWhiteSpace(Model.ResponseJson))
        {
            <div class="pl-card">
                <div class="pl-card-h">
                    <span>Response from @Model.Channel</span>
                    <button type="button" class="pl-btn" onclick="copyJson('response', this)"><i class="bi bi-clipboard"></i> Copy</button>
                </div>
                <pre id="response">@Model.ResponseJson</pre>
            </div>
        }
    </div>
}

<script>
    // Light syntax colouring, done client-side so the server just emits the raw
    // text — what you copy is byte-for-byte what was recorded.
    (function () {
        function colour(el) {
            if (!el) return;
            var src = el.textContent;
            try { src = JSON.stringify(JSON.parse(src), null, 2); } catch (e) { /* leave non-JSON as-is */ }
            el.innerHTML = src
                .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false)\b|\bnull\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?/g,
                    function (m, str, colon, bool) {
                        if (str) return colon ? '<span class="k">' + str + '</span>' + colon : '<span class="s">' + str + '</span>';
                        if (bool) return '<span class="b">' + m + '</span>';
                        if (m === 'null') return '<span class="z">null</span>';
                        return '<span class="n">' + m + '</span>';
                    });
        }
        colour(document.getElementById('payload'));
        colour(document.getElementById('response'));
    })();

    function copyJson(id, btn) {
        var text = document.getElementById(id).textContent;
        navigator.clipboard.writeText(text).then(function () {
            var was = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check2"></i> Copied';
            setTimeout(function () { btn.innerHTML = was; }, 1400);
        });
    }
</script>
</body>
</html>
