@using FinRiskLensAI.Core.Models.AccountAggregator
@model AaAnalysisResult
@{
    ViewBag.Title = "Bank Statement Deep Analysis";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/css/AaAnalysis.css" />

<div class="container-fluid py-4">
    <div class="aa-page-head d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
        <div>
            <div class="aa-eyebrow">
                <i class="bi bi-graph-up-arrow"></i><span>Account Aggregator · Credit Assessment</span>
            </div>
            <h3 class="fhc-title mb-1">Bank Statement Deep Analysis</h3>
            <p class="fhc-sub mb-0">
                Transaction-history driven credit review. Gross bank credits are never treated as business turnover.
            </p>
        </div>
        <a href="/AccountAggregator/AADetails" class="btn btn-outline-theme">
            <i class="bi bi-arrow-left me-1"></i>Back to AA Details
        </a>
    </div>

    @* Antiforgery token for the on-demand AI call. *@
    @Html.AntiForgeryToken()

    @await Html.PartialAsync("_AaAnalysisBody", Model)
</div>

@if (Model.HasData)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        // Hand this screen's computed analysis to the universal chatbot — metrics
        // only, sent once with the first question (never the raw statement).
        window.frlChatContext = {
            pageKey: 'AaDeepAnalysis',
            pageName: 'Bank Statement Deep Analysis (Account Aggregator) page',
            context: @Html.Raw(Json.Serialize(new {
                Model.AnalysisPeriod, Model.MonthsCovered, Model.TransactionCount,
                Model.TotalCredits, Model.TotalDebits, Model.NetCashFlow,
                Model.AvgMonthlyCredit, Model.AvgMonthlyDebit,
                Model.PotentialBusinessInflow, Model.PotentialNonBusinessInflow,
                Model.EstimatedSustainableInflow, Model.PotentialPassThroughAmount,
                Model.PassThroughPctOfCredits, Model.HealthScore, Model.RiskGrade,
                Model.CashWithdrawalRatio, Model.EstimatedMonthlyObligation,
                Model.DisciplineNote, Model.ActivityPattern,
                RiskFlags = Model.RiskFlags.Select(f => new { f.Severity, f.Title }),
                Monthly = Model.Monthly.Select(m => new { m.Month, m.Credits, m.Debits, m.NetCashFlow })
            }))
        };
    </script>
    <script src="~/FRLScripts/AccountAggregator/aa-analysis.js"></script>
}
