@using FinRiskLensAI.Core.Models.AccountAggregator
@model AaAnalysisResult
@{
    ViewBag.Title = "Account Aggregator Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<link rel="stylesheet" href="~/css/AaAnalysis.css" />

<div class="container-fluid py-4 aa-analysis">

    <div class="aa-page-head d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
        <div>
            <div class="aa-eyebrow" style="color:var(--aa-good);">
                <i class="bi bi-bank2"></i>
                <span>Account Aggregator @(Model.HasData ? "· Statement Linked" : "· Awaiting Data")</span>
            </div>
            <h3 class="fhc-title mb-1">Account Aggregator Details</h3>
            <p class="fhc-sub mb-0">Bank account information received through the AA consent journey.</p>
        </div>
        @if (Model.HasData)
        {
            <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                <a href="/AccountAggregator/DeepAnalysis" class="btn btn-theme">
                    <i class="bi bi-graph-up-arrow me-2"></i>Bank Statement Deep Analysis
                </a>
                <a href="/AccountAggregator/Transactions" class="btn btn-outline-theme">
                    <i class="bi bi-list-ul me-2"></i>Transactions
                </a>
            </div>
        }
    </div>

    @if (!Model.HasData)
    {
        <div class="aa-card">
            <div class="aa-empty">
                <i class="bi bi-inbox" style="font-size:2.2rem;color:var(--aa-muted);"></i>
                <p class="mt-3 mb-1">@(Model.LoadError ?? "No Account Aggregator statement is available yet.")</p>
                <p class="aa-sub mb-3">
                    Complete the Account Aggregator consent from the dashboard to fetch your bank statement.
                </p>
                <a href="/Dashboard/CustDashboard" class="btn btn-outline-theme btn-sm">
                    <i class="bi bi-arrow-right-circle me-1"></i>Go to Dashboard
                </a>
            </div>
        </div>
        return;
    }

    @* Statement overview + linked accounts — shared with the bank portal
       Customer 360 so the two never drift. *@
    @await Html.PartialAsync("_AaAccountsBody", Model)

    <!-- Deep analysis entry point -->
    <div class="aa-card" style="background:linear-gradient(135deg,var(--aa-tint),#fff);border-left:4px solid var(--aa-accent);">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h6 class="aa-cta-title">
                    <i class="bi bi-graph-up-arrow me-2"></i>Bank Statement Deep Analysis
                </h6>
                <p class="aa-sub mb-0" style="max-width:640px;">
                    Runs a credit-analyst review of the full statement — inflow/outflow classification,
                    potential pass-through detection, cash behaviour, recurring obligations, balance and
                    liquidity, concentration, risk indicators and an explainable banking health score.
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                <a href="/AccountAggregator/Transactions" class="btn btn-outline-theme">
                    <i class="bi bi-list-ul me-1"></i>Transactions
                </a>
                <a href="/AccountAggregator/DeepAnalysis" class="btn btn-theme">
                    Open Deep Analysis <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
