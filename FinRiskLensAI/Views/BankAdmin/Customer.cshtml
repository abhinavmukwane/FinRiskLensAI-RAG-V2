@model FinRiskLensAI.Core.Models.Admin.BankCustomerDetailViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    ViewBag.Title = "Customer 360";
    Layout = "~/Views/Shared/_BankAdminLayout.cshtml";
    var c = Model.Customer;

    string Inr(decimal? v)
    {
        if (v is null || v == 0m) return "—";
        var d = v.Value;
        if (d >= 10000000m) return "₹" + (d / 10000000m).ToString("0.##") + " Cr";
        if (d >= 100000m) return "₹" + (d / 100000m).ToString("0.##") + " L";
        return "₹" + d.ToString("N0");
    }

    string Tab(string key) => Model.ActiveTab == key ? "bp-tab active" : "bp-tab";
    string Pane(string key) => Model.ActiveTab == key ? "bp-pane active" : "bp-pane";
}

@section Styles {
    <link href="~/css/FinancialHealthCard.css" rel="stylesheet" />
    <link href="~/css/Dashboard.css" rel="stylesheet" />
    <link href="~/css/GstAnalysis.css" rel="stylesheet" />
    <link href="~/css/AaAnalysis.css" rel="stylesheet" />
}

<div class="bp-crumb">
    <a href="@Url.Action("Customers", "BankAdmin")"><i class="bi bi-arrow-left"></i> All customers</a>

    @if (c != null)
    {
        @* ── Raise as a loan case downstream. Lives in the crumb bar rather than
           the profile card: with three channels the status chips crowd the score,
           and this reads as the page's action toolbar. *@
        <div id="lcRoot" class="lc-root"
             data-uan="@c.Uan"
             data-scored="@(c.IsScored ? "true" : "false")"
             data-score="@(c.OverallScore?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
             data-token="@Xsrf.GetAndStoreTokens(Context).RequestToken"
             data-live="@System.Text.Json.JsonSerializer.Serialize(Model.LiveChannels)"
             data-pushes="@System.Text.Json.JsonSerializer.Serialize(Model.Pushes.Select(p => new {
                 id = p.LoanCasePushID, channel = p.Channel.ToString(), state = p.Status.ToString(),
                 caseReference = p.CaseReference, scoreAtPush = Math.Round(p.ScoreAtPush), band = p.BandAtPush,
                 pushedAt = p.PushedAt.ToString("dd MMM yyyy HH:mm"), pushedBy = p.PushedByName }))">
            <div id="lcChips" class="lc-chips"></div>
            <button type="button" id="lcOpen" class="bp-btn @(c.IsScored ? "" : "bp-btn-ghost")"
                    @(c.IsScored ? "" : "disabled")
                    title="@(c.IsScored ? "Raise this MSME as a loan case in LOS, ULI or ONDC" : "Score the MSME first")">
                <i class="bi bi-send"></i> Push to LOS / ULI / ONDC
            </button>
        </div>
    }
</div>

@if (Model.LoadError != null)
{
    <div class="bp-alert"><i class="bi bi-exclamation-triangle-fill"></i>@Model.LoadError</div>
}
else if (c != null)
{
    <!-- ===================== Profile header ===================== -->
    <div class="bp-profile">
        <div class="bp-profile-main">
            <div class="bp-profile-avatar">
                @(string.IsNullOrWhiteSpace(c.EnterpriseName) ? "?" : c.EnterpriseName.Trim()[..1].ToUpperInvariant())
            </div>
            <div>
                <h1>@c.EnterpriseName</h1>
                <div class="bp-profile-meta">
                    <span><i class="bi bi-patch-check"></i>@c.Uan</span>
                    @if (!string.IsNullOrWhiteSpace(c.GstinNumber))
                    {
                        <span><i class="bi bi-receipt"></i>@c.GstinNumber</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.PanNumber))
                    {
                        <span><i class="bi bi-card-text"></i>@c.PanNumber</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.City) || !string.IsNullOrWhiteSpace(c.State))
                    {
                        <span><i class="bi bi-geo-alt"></i>@(c.City ?? "")@(!string.IsNullOrWhiteSpace(c.City) && !string.IsNullOrWhiteSpace(c.State) ? ", " : "")@(c.State ?? "")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.OrganizationType))
                    {
                        <span><i class="bi bi-diagram-2"></i>@c.OrganizationType</span>
                    }
                </div>
            </div>
        </div>

        <div class="bp-profile-side">
            <div class="bp-profile-score">
                @if (c.IsScored)
                {
                    <div class="v">@c.OverallScore!.Value.ToString("0")</div>
                    <div class="k">Score / 1000</div>
                    <span class="bp-band bp-band-@c.ScoreBand">@c.ScoreBand</span>
                }
                else
                {
                    <div class="v bp-muted">—</div>
                    <div class="k">Not scored</div>
                    <span class="bp-band bp-band-Pending">Pending</span>
                }
            </div>
        </div>
    </div>

    @* ===================== Loan-case push modal ===================== *@
    <div class="detail-modal-overlay" id="lcOverlay"></div>
    <div class="detail-modal lc-modal" id="lcModal" role="dialog" aria-modal="true" aria-labelledby="lcTitle" style="width:640px;">
        <div class="detail-modal-header">
            <h5 id="lcTitle"><i class="bi bi-send me-2"></i>Raise loan case</h5>
            <button type="button" class="detail-modal-close" id="lcClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="detail-modal-body">
            <div class="lc-summary">
                <div><b>Enterprise</b>@c.EnterpriseName</div>
                <div><b>Score</b>@(c.IsScored ? $"{c.OverallScore:0} · {c.ScoreBand}" : "not scored")</div>
                <div><b>Eligibility</b>@Inr(c.TotalIndicativeEligibility)</div>
                <div><b>Product</b>@(c.TopProductName ?? "—")</div>
            </div>

            <div class="lc-label">Send to</div>
            <div class="lc-channels">
                <button type="button" class="lc-channel" data-channel="LOS">
                    <span class="lc-channel-name">LOS</span>
                    <span class="lc-channel-desc">Loan Origination System — credit appraisal case</span>
                </button>
                <button type="button" class="lc-channel" data-channel="ULI">
                    <span class="lc-channel-name">ULI</span>
                    <span class="lc-channel-desc">RBI Unified Lending Interface — OCEN loan application</span>
                </button>
                <button type="button" class="lc-channel" data-channel="ONDC">
                    <span class="lc-channel-name">ONDC</span>
                    <span class="lc-channel-desc">Open network — beckn FIS12 credit order</span>
                </button>
            </div>

            <div id="lcLiveNote" class="lc-note"></div>
            <div id="lcRepushNote" class="lc-note lc-note-warn" style="display:none;"></div>

            <div class="lc-actions">
                <a id="lcPreview" class="bp-btn bp-btn-ghost" href="#" target="_blank" rel="noopener">
                    <i class="bi bi-braces"></i> Preview payload
                </a>
                <button type="button" id="lcConfirm" class="bp-btn"><i class="bi bi-send"></i> Confirm push</button>
            </div>
            <div id="lcStatus" class="lc-status"></div>
        </div>
    </div>

    <!-- ===================== Quick facts ===================== -->
    <div class="bp-fact-grid">
        <div class="bp-fact">
            <div class="k">Indicative Eligibility</div>
            <div class="v">@Inr(c.TotalIndicativeEligibility)</div>
        </div>
        <div class="bp-fact">
            <div class="k">Recommended Product</div>
            <div class="v bp-fact-sm">@(c.TopProductName ?? "—")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Major Activity</div>
            <div class="v bp-fact-sm">@(c.MajorActivity ?? "—")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Incorporated</div>
            <div class="v bp-fact-sm">@(c.DateOfIncorporation?.ToString("dd MMM yyyy") ?? "—")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Onboarded</div>
            <div class="v bp-fact-sm">@c.OnboardedOn.ToString("dd MMM yyyy")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Score Computed</div>
            <div class="v bp-fact-sm">@(c.ComputedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Email</div>
            <div class="v bp-fact-sm">@(c.Email ?? "—")</div>
        </div>
        <div class="bp-fact">
            <div class="k">Mobile</div>
            <div class="v bp-fact-sm">@(c.MobileNumber ?? "—")</div>
        </div>
    </div>

    @if (c.IsAnomalous)
    {
        <div class="bp-alert bp-alert-warn">
            <i class="bi bi-shield-exclamation"></i>
            Cross-source anomaly flagged — GST turnover, ITR income and bank credits
            disagree materially. Review the data-integrity note on the score card.
        </div>
    }

    <!-- ===================== Tabs ===================== -->
    <div class="bp-tabs" role="tablist">
        <button type="button" class="@Tab("score")" data-pane="score" role="tab">
            <i class="bi bi-speedometer2"></i><span>Financial Score</span>
        </button>
        <button type="button" class="@Tab("udyam")" data-pane="udyam" role="tab">
            <i class="bi bi-grid-3x3-gap"></i><span>Udyam Identity</span>
        </button>
        <button type="button" class="@Tab("gst")" data-pane="gst" role="tab">
            <i class="bi bi-receipt"></i><span>GST Analysis</span>
        </button>
        <button type="button" class="@Tab("aa")" data-pane="aa" role="tab">
            <i class="bi bi-diagram-3"></i><span>AA Details</span>
        </button>
        <button type="button" class="@Tab("itr")" data-pane="itr" role="tab">
            <i class="bi bi-file-earmark-text"></i><span>ITR Details</span>
        </button>
        @* MCA only exists for companies and LLPs — flag it up front so the officer
           does not read an empty tab as missing data. *@
        <button type="button" class="@Tab("mca")" data-pane="mca" role="tab"
                title="@(Model.Mca?.IsApplicable == false ? $"Not applicable — {Model.Mca.OrganizationType ?? "non-corporate entity"} has no CIN or DIN" : "Corporate Affairs (MCA)")">
            <i class="bi bi-building-check"></i><span>Corporate (MCA)</span>
            @if (Model.Mca?.IsApplicable == false)
            {
                <span class="bp-tab-na">N/A</span>
            }
        </button>
        <button type="button" class="@Tab("security")" data-pane="security" role="tab">
            <i class="bi bi-shield-lock"></i><span>Security Audit</span>
        </button>
    </div>

    <!-- ===================== Panes ===================== -->
    <div class="bp-panes">

        <section class="@Pane("score")" data-pane="score">
            <div class="fhc-wrap bp-fhc">
                @if (Model.Card != null)
                {
                    @await Html.PartialAsync("_FinancialHealthCardBody", Model.Card)
                }
            </div>
        </section>

        <section class="@Pane("udyam")" data-pane="udyam">
            @if (Model.Udyam != null)
            {
                @await Html.PartialAsync("_UdyamDetailsBody", Model.Udyam)
            }
        </section>

        <section class="@Pane("gst")" data-pane="gst">
            @if (Model.Gst != null)
            {
                @await Html.PartialAsync("_GstAnalysisBody", Model.Gst)
            }
        </section>

        <section class="@Pane("itr")" data-pane="itr">
            @if (Model.Itr != null)
            {
                @await Html.PartialAsync("_ItrDetailsBody", Model.Itr)
            }
        </section>

        @* Both AA panels: the linked accounts the customer sees on /AADetails,
           then the full deep analysis from /DeepAnalysis. *@
        <section class="@Pane("aa")" data-pane="aa">
            @if (Model.Aa != null)
            {
                <div class="container-fluid py-4">
                    @{ ViewData["ShowAiPanel"] = false; ViewData["IsBankPortal"] = true; }
                    @await Html.PartialAsync("_AaAccountsBody", Model.Aa)
                    @await Html.PartialAsync("_AaAnalysisBody", Model.Aa)
                </div>
            }
        </section>

        <section class="@Pane("mca")" data-pane="mca">
            @if (Model.Mca != null)
            {
                @await Html.PartialAsync("_McaDetailsBody", Model.Mca)
            }
        </section>

        <section class="@Pane("security")" data-pane="security">
            @if (Model.IpAudit != null)
            {
                @await Html.PartialAsync("_IpAuditBody", Model.IpAudit)
            }
        </section>
    </div>
}

@section Scripts {
    @* _ItrDetailsBody and _McaDetailsBody both use the .mca2-tabs strip; the
       switcher is scoped per strip so the two do not fight on this page. The AA
       body draws Chart.js canvases. *@
    <script src="~/FRLScripts/Common/panel-tabs.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/FRLScripts/AccountAggregator/aa-analysis.js" asp-append-version="true"></script>
    <script src="~/FRLScripts/BankAdmin/loan-case.js" asp-append-version="true"></script>
    <script>
        // Tab switching. Every pane is rendered server-side, so switching is purely
        // show/hide — no refetch, and charts inside a pane keep their state.
        (function () {
            var tabs = document.querySelectorAll('.bp-tab');
            var panes = document.querySelectorAll('.bp-pane');

            function activate(key) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.pane === key); });
                panes.forEach(function (p) { p.classList.toggle('active', p.dataset.pane === key); });

                // Keep the tab in the URL so a refresh or shared link lands in place
                var u = new URL(window.location.href);
                u.searchParams.set('tab', key);
                history.replaceState(null, '', u);

                // Charts laid out while hidden measure 0px — nudge them once visible
                window.dispatchEvent(new Event('resize'));
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { activate(this.dataset.pane); });
            });
        })();
    </script>
}
