@model FinRiskLensAI.Core.Models.AccountAggregator.AAConsentCallbackViewModel
@{
    Layout = null;
    var ok = Model.IsSuccess;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ok ? "AA Consent Success" : "AA Consent Failed") — FinRiskLensAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/theme.css" />
    <script src="~/js/theme.js"></script>
    <link rel="stylesheet" href="~/css/AAConsentCallback.css" />
</head>

<body>

    <div class="result-container">

        <div class="result-card">

            <div class="brand">FinRiskLens<span>AI</span></div>

            <div class="animation-wrapper">
                <div class="shape dot s1"></div>
                <div class="shape circle s2"></div>
                <div class="shape dot s3"></div>
                <div class="shape circle s4"></div>
                <div class="shape star s5"><i class="fa-solid fa-star"></i></div>
                <div class="shape star s6"><i class="fa-solid fa-star"></i></div>

                @if (ok)
                {
                    <div class="status-icon icon-success"><i class="fa-solid fa-check"></i></div>
                }
                else
                {
                    <div class="status-icon icon-failure"><i class="fa-solid fa-xmark"></i></div>
                }
            </div>

            @if (ok)
            {
                <div class="status-badge badge-success">
                    <i class="fa-solid fa-circle-check"></i>
                    Successfully Verified
                </div>

                <div class="title">CONSENT COMPLETE</div>

                <div class="subtitle">
                    Your Account Aggregator consent has been successfully submitted
                    and approved. Your financial data verification will continue
                    automatically for your credit health assessment.
                </div>
            }
            else
            {
                <div class="status-badge badge-failure">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Verification Failed
                </div>

                <div class="title">CONSENT FAILED</div>

                <div class="subtitle">
                    We were unable to complete your Account Aggregator consent
                    verification. Please try again or contact support if the issue
                    persists.
                </div>
            }

            <div class="details-card">
                <div class="details-header">Application Details</div>

                <div class="detail-row">
                    <div class="detail-label">Transaction ID</div>
                    <div class="detail-value">@(Model.ApplicationId ?? "—")</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ConsentHandle))
                {
                    <div class="detail-row">
                        <div class="detail-label">Consent Handle</div>
                        <div class="detail-value">@Model.ConsentHandle</div>
                    </div>
                }

                <div class="detail-row">
                    <div class="detail-label">Consent Status</div>
                    <div class="detail-value @(ok ? "chip-approved" : "chip-rejected")">
                        @(ok ? "Approved" : "Failed")
                    </div>
                </div>
            </div>

            @if (ok)
            {
                <button type="button" class="btn-action" onclick="returnToDashboard();">
                    <i class="fa-solid fa-house"></i>
                    Return To Dashboard
                </button>
            }
            else
            {
                <div class="next-step">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Please retry the consent process to continue your credit assessment.
                </div>

                <button type="button" class="btn-action" onclick="tryAgain();">
                    <i class="fa-solid fa-rotate-right"></i>
                    Try Again
                </button>
            }
            <div class="footer">
                FinRiskLensAI &middot; Account Aggregator Consent
            </div>

        </div>

    </div>

    <script>
        // This page is opened in a tab by the dashboard (window.opener). On close we
        // tidy up that dashboard tab: hide the AA modal (success) or re-enable the
        // Fetch button so the user can retry (failure).
        function closeAaModalOnOpener() {
            try {
                if (window.opener && !window.opener.closed) {
                    var doc = window.opener.document;
                    var modalEl = doc.getElementById('aaConsentModal');
                    if (modalEl && window.opener.bootstrap) {
                        window.opener.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    }
                    window.opener.focus();
                }
            } catch (e) { /* cross-tab access can fail silently */ }
        }

        function returnToDashboard() {
            closeAaModalOnOpener();
            window.close();
            // Fallback if the tab wasn't script-opened (window.close blocked).
            window.location.href = '/Dashboard/CustDashboard';
        }

        function tryAgain() {
            try {
                if (window.opener && !window.opener.closed) {
                    var btn = window.opener.document.getElementById('fetchAaBtn');
                    if (btn) btn.disabled = false;
                    window.opener.focus();
                }
            } catch (e) { }
            window.close();
        }
    </script>

</body>

</html>
