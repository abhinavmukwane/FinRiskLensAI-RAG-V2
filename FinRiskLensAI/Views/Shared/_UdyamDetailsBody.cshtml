@model FinRiskLensAI.Models.UdyamDetailsViewModel
@*
    Shared Udyam "Business Identity & Trust Analysis" body. Rendered by the
    customer page (Views/Udyam/UdyamDetails) and the bank portal Customer 360,
    so both show identical data. Caller supplies layout and page chrome.
*@

@*
    Pure presentation view — all data binding and the business-identity
    analysis (score, risk, classification, strengths, observations) are
    computed in UdyamController.BuildAnalysis from the Udyam response
    cached in m_StaticResponces. Page behavior lives in
    ~/FRLScripts/Udyam/UdyamDetails.js.
*@

@if (!Model.HasData)
{
    <div class="container-fluid py-4 udyam-dashboard">
        <div class="alert alert-danger rounded-4">
            @(Model.LoadError ?? "No Udyam data is available for your account.")
        </div>
    </div>
    return;
}


<div class="container-fluid py-4 udyam-dashboard">

    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 verified-tag mb-1">
                <i class="bi bi-patch-check-fill"></i>
                <span>UDYAM REGISTRATION @Model.RegistrationStatus.ToUpper()</span>
            </div>
            <h3 class="fhc-title mb-1">AI-Powered Udyam Registration Analysis</h3>
            <p class=" fhc-sub">@Model.EnterpriseName &middot; Registration No: <span id="udyamRegNumber">@Model.Uan</span></p>
            
        </div>
        <div class="d-flex gap-2">
            <button id="btnDownloadReport" type="button" class="btn btn-outline-theme">
                <i class="bi bi-download me-1"></i> Download Report
            </button>
            <button id="btnRefreshData" type="button" class="btn btn-theme">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
        </div>
    </div>

    <div class="row g-4">

        <!-- COLUMN 1: Business Identity Score Card -->
        <div class="col-12 col-lg-4">
            <div class="dash-card glass-card h-100 text-center d-flex flex-column align-items-center justify-content-between position-relative p-4">
                <i class="bi bi-info-circle info-icon position-absolute top-0 end-0 m-3"
                   title="Score = Business Age + Enterprise Stability + Registration + Plant Locations + NIC Diversity + Org Type + GST + PAN (see Observations for detail)"></i>

                @* <h6 class="card-subtitle mb-3">Business Identity Score</h6> *@
                <div class="fhc-section-label mb-0">Business Identity Score</div>
                <div class="score-gauge my-3">
                    <svg viewBox="0 0 200 200">
                        <circle class="gauge-track" cx="100" cy="100" r="88"></circle>
                        <circle id="gaugeProgress" class="gauge-progress" cx="100" cy="100" r="88"></circle>
                    </svg>
                    <div class="score-value">
                        <span id="reliabilityScore">@Model.BusinessIdentityScore</span>
                        <small>/ 100</small>
                    </div>
                </div>

                <div class="text-center mb-3">
                    <span class="risk-badge @Model.RiskCss">@Model.RiskLabel</span>
                    <div class="classification-tag mt-2">@Model.BusinessClassification Business</div>
                </div>

                <div class="score-observations w-100 mt-2">
                    <h6 class="card-heading mb-2"><i class="bi bi-stars me-2"></i>AI Observations</h6>
                    <p class="observations-text mb-0">@Model.Observations</p>
                </div>
            </div>
        </div>

        <!-- COLUMN 2: Business Identity, Strengths, Timeline Grouped -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <div class="row g-4">
                <!-- Business Identity Card -->
                <div class="col-12 col-md-6">
                    <div class="dash-card h-100">
                        <h6 class="card-heading"><i class="bi bi-building me-2"></i>Business Identity</h6>
                        <ul class="profile-list list-unstyled mb-0">
                            <li><span>Business Name</span><strong class="text-end">@Model.EnterpriseName</strong></li>
                            <li><span>Enterprise Type</span><strong>@Model.LatestEnterpriseType</strong></li>
                            <li><span>Business Age</span><strong>@Model.BusinessAgeYears Years</strong></li>
                            <li><span>Registration Date</span><strong>@Model.RegistrationDate.ToString("dd MMM yyyy")</strong></li>
                            <li><span>Organization Type</span><strong class="text-end">@Model.OrganizationType</strong></li>
                            <li class="no-border"><span>Major Activity</span><strong>@Model.MajorActivity</strong></li>
                        </ul>
                    </div>
                </div>

                <!-- Strengths -->
                <div class="col-12 col-md-6">
                    <div class="dash-card h-100">
                        <div class="fhc-section-label mb-0" style="padding-bottom: 12px;"><i class="bi bi-shield-check me-2"></i>Identified Strengths</div>
                        @* <h6 class="card-heading"><i class="bi bi-shield-check me-2"></i>Identified Strengths</h6> *@
                        <ul class="signal-list list-unstyled mb-0">
                            @foreach (var s in Model.Strengths)
                            {
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <div><p class="signal-title mb-0">@s</p></div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Classification Timeline -->
            <div class="dash-card glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    @* <div class="fhc-section-label mb-0"><i class="bi bi-bank me-1"></i>Bank Lending Assessment</div> *@
                    <div class="fhc-section-label mb-0"><i class="bi bi-calendar3 me-2"></i>Enterprise Classification Timeline</div>
                    <span class="legend"><span class="legend-dot"></span> Stable Classification</span>
                </div>
                <div class="classification-timeline">
                    @foreach (var entry in Model.EnterpriseTypeHistory)
                    {
                        <div class="timeline-step">
                            <div class="timeline-dot"></div>
                            <div class="timeline-year">@entry.Year</div>
                            <div class="timeline-type">@entry.Type</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Location Summary -->
        <div class="col-12 col-md-6">
            <div class="dash-card compliance-card h-100">
                <div class="fhc-section-label">Location Summary</div>
                <ul class="mini-list">
                    <li><span>State</span><strong>@Model.State</strong></li>
                    <li><span>District</span><strong>@Model.District</strong></li>
                    <li><span>City</span><strong>@Model.City</strong></li>
                    <li><span>PIN</span><strong>@Model.Pin</strong></li>
                    <li><span>Total Locations</span><strong>@Model.PlantLocations.Count</strong></li>
                </ul>
            </div>
        </div>

        <!-- Compliance Summary -->
        <div class="col-12 col-md-6">
            <div class="dash-card compliance-card h-100">
                <div class="fhc-section-label">Compliance Summary</div>
                <ul class="mini-list">
                    <li><span>GST</span><strong>@(string.IsNullOrWhiteSpace(Model.GstinMasked) ? "Not Available" : Model.GstinMasked)</strong></li>
                    <li><span>PAN</span><strong>@(string.IsNullOrWhiteSpace(Model.PanMasked) ? "Not Available" : Model.PanMasked)</strong></li>
                    <li><span>Registration</span><strong class="status-active"><i class="bi bi-dot"></i>@Model.RegistrationStatus</strong></li>
                </ul>
            </div>
        </div>

        <!-- Plant Location Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <div class="fhc-section-label mb-0"><i class="bi bi-geo-alt-fill me-2"></i>Registered Plant Locations (@Model.PlantLocations.Count)</div>
                @* <h6 class="card-heading"><i class="bi bi-geo-alt-fill me-2"></i>Registered Plant Locations (@Model.PlantLocations.Count)</h6> *@
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th>Unit Name</th><th>City</th><th>District</th><th>State</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var loc in Model.PlantLocations)
                            {
                                <tr>
                                    <td>@loc.UnitName</td>
                                    <td>@loc.City</td>
                                    <td>@loc.District</td>
                                    <td>@loc.State</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- NIC Activities Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <div class="fhc-section-label mb-0"><i class="bi bi-diagram-3-fill me-2"></i>NIC Activities (@Model.NicActivities.Count)</div>
                @* <h6 class="card-heading"><i class="bi bi-diagram-3-fill me-2"></i>NIC Activities (@Model.NicActivities.Count)</h6> *@
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th style="width:75px !important">NIC Code</th><th>Activity</th><th>Type</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var nic in Model.NicActivities)
                            {
                                <tr>
                                    <td>@nic.Code</td>
                                    <td>@nic.Activity</td>
                                    <td><span class="pill-type">@nic.ActivityType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@* ================================================================
   Preserved verification modals (GST / Account Aggregator / ITR).
   Not currently triggered from this view since the launcher cards
   were replaced by the analysis dashboard above, but kept in place
   with existing IDs/markup intact for reuse (e.g. "Refresh Data",
   re-verification flows, or future wiring) without breaking any
   JS hooks already built against them.
   ================================================================ *@

<div class="modal fade" id="verificationModal" tabindex="-1"
     aria-labelledby="verificationModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title " id="verificationModalLabel">
                        Fetch GSTR Details
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label fw-semibold">User ID</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter User ID">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>Udyam Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="aaConsentModal" tabindex="-1" aria-labelledby="aaConsentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="aaConsentModalLabel">
                    Account Aggregator Consent
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mobile Number</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter Mobile Number">
                </div>
                <div class="consent-box">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize sharing of my bank account information for
                            verification purposes.
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="itrModal" tabindex="-1" aria-labelledby="itrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title" id="itrModalLabel">
                    <i class="bi bi-file-earmark-text-fill text-warning me-2"></i>
                    Income Tax Return Verification
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label fw-semibold">User ID</label>
                    <input type="text" class="form-control custom-input" placeholder="Enter User ID">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <div class="consent-box">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="consentCheck">
                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>

<script>
    // Hand this screen's full analysis to the universal chatbot — it is sent
    // to the server only once, together with the first question.
    window.frlChatContext = {
        pageKey: 'UdyamDetails',
        pageName: 'Udyam Verification (Business Identity & Trust Analysis) page',
        context: @Html.Raw(Json.Serialize(Model))
    };
</script>
<script src="~/FRLScripts/Udyam/UdyamDetails.js"></script>
