
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinRiskLens AI | MSME Credit Risk Intelligence</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Sora:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <link href="~/css/theme.css" rel="stylesheet" />
    <script src="~/js/theme.js"></script>
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/DashboardLayout.css" rel="stylesheet" />
</head>
<body>

    <div class="app-shell" id="appShell">

        <!-- ============ Sidebar ============ -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-mark" style="background:#fff;overflow:hidden;">
                    <img src="~/Logo.png" alt="FinRiskLens AI" style="width:100%;height:100%;object-fit:cover;" />
                </div>
                <div class="sidebar-brand-text">
                    <h1>FinRiskLens AI</h1>
                    <p>MSME Credit Risk</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link " href="/Dashboard/CustDashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link" href="/Dashboard/FinancialHealthCard">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Financial Score</span>
                </a>
                <a class="nav-link" href="/Udyam/UdyamDetails">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Udyam Details</span>
                </a>
                <a class="nav-link" href="/Dashboard/GSTAnalysis">
                    <i class="bi bi-receipt"></i> <span>GST Details</span>
                </a>
                <a class="nav-link" href="/AccountAggregator/AADetails">
                    <i class="bi bi-diagram-3"></i><span>Account Aggregator Details</span>
                </a>
                <a class="nav-link" href="/Mca/MCADetails">
                    <i class="bi bi-building-check"></i>
                    <span>Corporate Affairs (MCA)</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i><span>ITR Details</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-credit-card-2-front"></i><span>Transactions</span>
                </a>
            </nav>

            <div class="sidebar-footer">
               
                <div class="sidebar-nav">
                    @* <a class="nav-link" href="#">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        <span>Help Center</span>
                    </a> *@

                    @* <button type="button"
                            class="btn text-white mt-3" style="background:var(--brand-btn-bg);border-radius:10px;padding:8px 22px;font-weight:600;"
                            onclick="window.location.href='@Url.Action("DownloadFinancialReport", "Report")'">
                        <i class="bi bi-download me-1"></i>
                        Download Report
                    </button> *@
                    <div class="nav-header-badge">

                        <a class="nav-linkLogout" href="/Auth/Logout">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Logout</span>
                    </a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- backdrop for mobile drawer -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- ============ Main + Topbar ============ -->
        <main class="main-content">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list icon-hamburger"></i>
                        <i class="bi bi-x-lg icon-cross"></i>
                    </button>
                    @* <h2 class="topbar-title">Overview Dashboard</h2> *@
                </div>

                <div class="topbar-right">

                    <div class="topbar-actions">
                        <!-- Translation Plugin -->
                        <div class="bhashini-plugin-container"></div>
                        @await Html.PartialAsync("_ThemeSwitch")

                        @* <span class="topbar-user-name">@enterpriseName</span> *@

@*                         <button class="topbar-avatar" type="button" aria-label="User menu">
                            <i class="bi bi-person"></i>
                        </button> *@
                    </div>
                </div>
            </header>

            <!-- ==== put your page content here ==== -->
            <div>
            @RenderBody()
            </div>
        </main>
    </div>

    <script>
        // Sidebar collapse / expand — hamburger <-> cross toggle
        (function(){
          const appShell = document.getElementById('appShell');
          const toggle = document.getElementById('sidebarToggle');
          const backdrop = document.getElementById('sidebarBackdrop');

          toggle.addEventListener('click', () => appShell.classList.toggle('sidebar-collapsed'));
          backdrop.addEventListener('click', () => appShell.classList.remove('sidebar-collapsed'));
        })();

        document.addEventListener('DOMContentLoaded', function () {
        const currentPath = window.location.pathname.toLowerCase();
        const links = document.querySelectorAll('.sidebar-nav .nav-link');

        links.forEach(link => {
        const linkPath = link.getAttribute('href').toLowerCase();

        // skip placeholder "#" links
        if (linkPath === '#') return;

        if (linkPath === currentPath) {
        link.classList.add('active');
        } else {
        link.classList.remove('active');
        }
        });
        });
    </script>

    @* Universal AI chatbot — pages pass screen data via window.frlChatContext *@
    @await Html.PartialAsync("_Chatbot")

    <script src="~/js/website_translation_utility.js"
            asp-append-version="true"
            page-source-language="en"
            translation-language-list="en,hi,mr,ta,gu,gom,sa"
            language_order="en,hi,mr,ta,gu,gom,sa"
            initial_preferred_language="en"
            language-icon-color="#8b1538">
    </script>
</body>
</html>
