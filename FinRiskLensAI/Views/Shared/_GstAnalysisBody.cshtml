@model FinRiskLensAI.Core.Models.GST.GSTAnalysisViewModel
@using FinRiskLensAI.Core.Common
@*
    Shared GST analysis body. Rendered by the customer page
    (Views/Dashboard/GSTAnalysis) and the bank portal Customer 360, so both
    show identical data. Identity is read from the model first so the view
    also renders for a bank officer, whose session holds no MSME user.
*@
<style>
    .stat-box {
        width: 100%;
        max-width: 150px;
        min-height: 90px;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        /* padding: 1rem; */
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .dash-table {
        table-layout: fixed;
        width: 100%;
    }

        .dash-table th,
        .dash-table td {
            white-space: normal;
            word-wrap: break-word;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #198754; /* bootstrap success green, matches text-success */
        display: inline-block;
        animation: blink-dot 1.5s ease-in-out infinite;
    }

    @@keyframes blink-dot {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.25;
    }

    }
</style>
@{

    // Prefer the model (set per-UAN by CustomerProfileBuilder) so this view also
    // renders for a bank officer, whose session holds no MSME user.
    var user = Context.Session.GetCurrentUser();
    var enterpriseName = Model.EnterpriseName ?? user?.NameOfEnterprise ?? "TRUST FINTECH LIMITED";

    // Sensitive identifiers are always rendered masked (Universal maskers —
    // the same helpers UdyamController uses; never show the raw values here).
    var gstin = Universal.MaskGstin(Model.Gstin ?? user?.GstinNumber ?? "27AAAAA1111A1Z1");
    var pan = Universal.MaskPan(Model.PanNumber ?? user?.PanNumber ?? "AAAAA1111A");
    var uan = Universal.MaskUdyam(Model.Uan ?? "UDYAM-MH-20-0033382");
}


@*
