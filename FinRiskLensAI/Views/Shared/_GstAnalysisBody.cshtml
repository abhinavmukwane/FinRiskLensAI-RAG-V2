                        <circle class="gauge-circle-bg" cx="70" cy="70" r="58"></circle>
                        <circle id="gstHealthGauge" class="gauge-circle-progress success" cx="70" cy="70" r="58" style="stroke-dasharray: 364; stroke-dashoffset: 364;"></circle>
