@using FinRiskLensAI.Common
@{
    var bankUser = Context.Session.GetCurrentBankUser();
    var action = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
    string Nav(string a) => action == a.ToLowerInvariant() ? "bp-nav-link active" : "bp-nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | FinRiskLens AI Bank Portal</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="~/css/theme.css" rel="stylesheet" />
    <script src="~/js/theme.js"></script>
    <link href="~/css/BankAdmin.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bank-portal">

    <header class="bp-topbar">
        <div class="bp-brand">
            <img src="~/Logo.png" alt="FinRiskLens AI" />
            <div>
                <div class="bp-brand-name">FinRiskLens <span>AI</span></div>
                <div class="bp-brand-sub">Bank Portal</div>
            </div>
        </div>

        <nav class="bp-nav">
            <a class="@Nav("Dashboard")" href="@Url.Action("Dashboard", "BankAdmin")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
            <a class="@Nav("Customers")" href="@Url.Action("Customers", "BankAdmin")">
                <i class="bi bi-people"></i><span>Customers</span>
            </a>
        </nav>

        <div class="bp-topbar-right">
            @await Html.PartialAsync("_ThemeSwitch")

            <div class="bp-user">
                <div class="bp-avatar">@(bankUser?.Initials ?? "?")</div>
                <div class="bp-user-meta">
                    <div class="bp-user-name">@(bankUser?.FullName ?? "Bank User")</div>
                    <div class="bp-user-branch">
                        @(bankUser?.BranchName ?? "—") &middot; @(bankUser?.IfscCode ?? "—")
                    </div>
                </div>
            </div>

            <a class="bp-logout" href="@Url.Action("Logout", "BankAdmin")" title="Sign out">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </header>

    <main class="bp-main">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
