<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinRiskLens AI | MSME Credit Risk Intelligence</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=Geist:wght@400;500;600&display=swap"
          rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="~/css/theme.css" rel="stylesheet" />
    <script src="~/js/theme.js"></script>
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/SiteLayout.css" rel="stylesheet" />
</head>

<body>

    <!-- Header -->
    <div class="brandbar py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center gap-3 text-decoration-none">
                <img src="~/Logo.png" alt="FinRiskLens AI" class="brand-logo"
                     style="height:46px;width:auto;border-radius:10px;background:#fff;" />
                <div>
                    <div class="brand-name">FinRiskLens <span style="color:var(--gold-soft)">AI</span></div>
                    <div class="brand-sub">IDBI Innovate · MSME Onboarding</div>
                </div>
            </a>

            <div class="d-flex align-items-center gap-3">
               
                <div class="frl-login-dropdown">
                    <button type="button" class="btn text-white px-3 py-2 rounded-3 font-heading d-flex align-items-center gap-2 frl-login-toggle"
                            style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.85rem; font-weight: 600;"
                            aria-haspopup="true" aria-expanded="false">
                        <i class="bi bi-box-arrow-in-right" style="font-size: 1.1rem; vertical-align: middle;"></i>
                        Login
                        <i class="bi bi-chevron-down frl-login-caret" style="font-size: .65rem;"></i>
                    </button>
                    <div class="frl-login-menu">
                        <a href="/Auth/CustLogin" class="frl-login-menu-item">
                            <i class="bi bi-person-circle"></i> User Login
                        </a>
                        <a href="/Auth/BankLogin" class="frl-login-menu-item">
                            <i class="bi bi-bank"></i> Bank Login
                        </a>
                    </div>
                </div>
                <!-- Translation Plugin Goes Here -->
                <div class="bhashini-plugin-container"></div>
                @await Html.PartialAsync("_ThemeSwitch")

            </div>
            
        </div>
        
    </div>
    <!-- Main Body -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-light border-top px-margin-desktop py-5 mt-5">
        <div class="mx-auto" style="max-width: 1440px;">
            <div class="row g-4">
                <div class="col-lg-4 space-y-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center"
                             style="width: 1.75rem; height: 1.75rem;">
                            <i class="bi bi-bar-chart-fill text-white" style="font-size: 14px;"></i>
                        </div>
                        <span class="h5 text-primary font-heading mb-0 fw-bold">FinRiskLens AI</span>
                    </div>
                    <p class="small text-secondary" style="max-width: 320px;">
                        The future of credit risk is data-driven,
                        transparent, and inclusive. Join the revolution in MSME banking.
                    </p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Platform
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">Risk Modeling</a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Data
                                Connectors
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Decision
                                Engine
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Compliance
                                Audit
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Company
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">About Us</a></li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">Methodology</a>
                        </li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Careers</a></li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Legal
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Privacy
                                Policy
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Terms of
                                Service
                            </a>
                        </li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Security</a></li>
                    </ul>
                </div>
            </div>

            <div class="mt-5 pt-3 border-top border-secondary border-opacity-10 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <p class="font-data small text-secondary mb-0">© @DateTime.Now.Year FinRiskLens AI. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-globe2 fs-5"></i>
                    </a>
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-at fs-5"></i>
                    </a>
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-share-fill fs-5"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/website_translation_utility.js"
            asp-append-version="true"
            page-source-language="en"
            translation-language-list="en,hi,mr,ta,gu,gom,sa"
            language_order="en,hi,mr,ta,gu,gom,sa"
            initial_preferred_language="en"
            language-icon-color="#F3E2B2">
    </script>

    <script>
        // Login dropdown — hover opens it (see SiteLayout.css); this adds
        // click support for touch/keyboard, plus close-on-outside-click/Escape.
        (function () {
            var wrap = document.querySelector('.frl-login-dropdown');
            var toggle = wrap && wrap.querySelector('.frl-login-toggle');
            if (!wrap || !toggle) return;

            function close() {
                wrap.classList.remove('open');
                toggle.setAttribute('aria-expanded', 'false');
            }
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = wrap.classList.toggle('open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (!wrap.contains(e.target)) close();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') close();
            });
        })();
    </script>
</body>
</html>
