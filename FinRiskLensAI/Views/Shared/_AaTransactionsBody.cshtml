@using FinRiskLensAI.Core.Models.AccountAggregator
@model AaAnalysisResult
@*
    Shared transaction-history body. Rendered by the customer page
    (/AccountAggregator/Transactions) and reusable from the bank portal
    Customer 360, so both surfaces list the same rows from one code path.

    This used to sit at the bottom of _AaAnalysisBody. It was moved out
    because the deep-analysis page is a summary — a 2,000-row table below
    eighteen analysis cards buried them. Classification and confidence
    still come from AaStatementAnalysisService; nothing is computed here.
*@

@functions {
    static string Exact(decimal v) => $"₹{v:N2}";

    /// <summary>Filter groups used by the transaction-history tabs.</summary>
    static string Groups(AaTransaction t, HashSet<AaTransaction> obligations)
    {
        var g = new List<string> { "all", t.IsCredit ? "credits" : "debits" };
        if (t.Category is AaCategory.BusinessReceipt or AaCategory.TradeReceipt) g.Add("business");
        if (t.Category is AaCategory.CashWithdrawal or AaCategory.CashDeposit) g.Add("cash");
        if (t.Category == AaCategory.CashWithdrawal) g.Add("cashout");
        if (t.Category == AaCategory.SelfTransfer) g.Add("self");
        if (!string.IsNullOrWhiteSpace(t.Mode)
            && new[] { "NEFT", "RTGS", "IMPS", "UPI", "FT", "TRANSFER" }.Any(m => t.Mode.Contains(m))) g.Add("transfers");
        if (obligations.Contains(t)) g.Add("obligations");
        if (t.Category is AaCategory.LoanEmi or AaCategory.NachEcs) g.Add("emi");
        if (t.Category == AaCategory.BankCharges) g.Add("charges");
        if (t.Category is AaCategory.InterestIncome or AaCategory.InterestPaid) g.Add("interest");
        if (!string.IsNullOrWhiteSpace(t.RiskFlag)) g.Add("flagged");
        if (t.Category == AaCategory.Unknown) g.Add("unknown");
        return string.Join(" ", g);
    }
}

@if (!Model.HasData)
{
    <div class="aa-analysis">
        <div class="alert alert-warning rounded-4 mb-0">
            <i class="bi bi-info-circle me-2"></i>
            @(Model.LoadError ?? "No Account Aggregator statement is available.")
        </div>
    </div>
    return;
}

@{
    var obligationTxns = new HashSet<AaTransaction>(Model.Obligations.SelectMany(o => o.Transactions));
    const int maxRows = 2000;
    var rows = Model.Transactions.OrderByDescending(t => t.Date).Take(maxRows).ToList();
}

<div class="aa-analysis" id="aaTransactions">

    <div class="aa-card">
        <div class="aa-card-head">
            <h6><i class="bi bi-list-ul"></i>Transaction History</h6>
            <div class="d-flex align-items-center gap-2">
                <input type="search" id="aaSearch" class="form-control form-control-sm" style="max-width:230px"
                       placeholder="Search narration / amount…" aria-label="Search transactions" />
                <span class="aa-sub" id="aaRowCount"></span>
                @* Shown only when arriving from a month row on the deep-analysis page. *@
                <button type="button" id="aaClearMonth" class="aa-month-chip" style="display:none">
                    <i class="bi bi-funnel-fill"></i><span id="aaMonthLabel"></span><i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="aa-tabs" role="tablist">
            @{
                var tabs = new (string Key, string Label)[]
                {
                    ("all","All"), ("credits","Credits"), ("debits","Debits"), ("business","Business Inflows"),
                    ("cashout","Cash Withdrawals"), ("transfers","Transfers"), ("self","Self Transfers"),
                    ("obligations","Obligations"), ("emi","EMI/Loan"), ("charges","Charges"),
                    ("interest","Interest"), ("flagged","Suspicious Patterns"), ("unknown","Unknown")
                };
            }
            @foreach (var (key, label) in tabs)
            {
                <button type="button" class="aa-tab @(key == "all" ? "active" : "")" data-group="@key">@label</button>
            }
        </div>

        @if (Model.Transactions.Count > maxRows)
        {
            <p class="aa-sub mb-2">
                <i class="bi bi-info-circle me-1"></i>
                Showing the @maxRows most recent of @Model.Transactions.Count transactions. All aggregate figures above use the full statement.
            </p>
        }

        <div class="aa-table-wrap aa-scroll-y">
            <table class="aa-table" id="aaTxnTable">
                <thead>
                    <tr>
                        <th>Date</th><th>Txn No</th><th class="narr">Narration</th><th class="narr">Description</th>
                        <th class="num">Credit</th><th class="num">Debit</th><th class="num">Balance</th>
                        <th>Mode</th><th>Cheque</th><th>Classification</th><th>Conf.</th><th>Risk</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in rows)
                    {
                        <tr data-groups="@Groups(t, obligationTxns)" data-month="@t.Date.ToString("yyyy-MM")">
                            <td>@t.Date.ToString("dd MMM yyyy")</td>
                            <td>@(string.IsNullOrWhiteSpace(t.TxnNo) ? "—" : (t.TxnNo.Length > 14 ? t.TxnNo[..14] + "…" : t.TxnNo))</td>
                            <td class="narr">@t.Narration</td>
                            <td class="narr">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                            <td class="num cr">@(t.Credit > 0 ? Exact(t.Credit) : "")</td>
                            <td class="num dr">@(t.Debit > 0 ? Exact(t.Debit) : "")</td>
                            <td class="num">@(t.Balance.HasValue ? Exact(t.Balance.Value) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Mode) ? "—" : t.Mode)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.ChequeNo) ? "—" : t.ChequeNo)</td>
                            <td><span class="aa-pill">@t.Category</span></td>
                            <td><span class="aa-pill conf-@t.Confidence">@t.Confidence</span></td>
                            <td>@if (t.RiskFlag != null) { <span class="aa-riskdot">@t.RiskFlag</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="aa-sub mt-2 mb-0">Original narration is never hidden or rewritten — classification is shown alongside it for verification.</p>
    </div>
</div>
