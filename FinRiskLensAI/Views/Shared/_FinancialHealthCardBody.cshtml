@model FinRiskLensAI.Models.FinancialHealthCardViewModel
@*
    Shared Financial Health Card body — the score gauge, six dimensions,
    bank lending assessment, recommended credit products and the charts.
    Rendered by BOTH the customer page (Views/Dashboard/FinancialHealthCard)
    and the bank portal Customer 360 (Views/BankAdmin/Customer), so the two
    never drift apart. The caller supplies its own header and the
    surrounding .fhc-wrap container.
*@

<style>
    .stat-tile {
    width: 100%;
    /* max-width: 160px;    */
    min-height: 90px;   
    padding: 12px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.stat-tile .v {
    font-size: 1.5rem;
    font-weight: 700;
      margin-bottom: 8px;
}
.stat-tile .k {
    font-size: 0.75rem;
    text-transform: uppercase;
    line-height: 1.2;
}
</style>

@{
    var r = Model.Result;
}
    @if (Model.LoadError != null)
    {
        <div class="alert alert-danger rounded-4">@Model.LoadError</div>
    }
    else if (!Model.HasResult)
    {
        <div class="fhc-card text-center py-5">
            <i class="bi bi-hourglass-split" style="font-size:3rem;color:var(--brand-secondary);"></i>
            <h5 class="fhc-title mt-3">No analysis result yet for @Model.Uan</h5>
            <div class="fhc-sub mb-3">
                Files in folder: @(Model.Status?.FilesPresent.Count ?? 0)
                @if (Model.Status?.FilesMissing.Count > 0)
                {
                    <br /><span>Missing: @string.Join(", ", Model.Status.FilesMissing)</span>
                }
            </div>
            <button id="runAnalysisBtn" class="btn text-white" style="background:var(--brand-btn-bg);border-radius:10px;padding:10px 26px;font-weight:600;">
                <i class="bi bi-cpu me-1"></i> Run AI Analysis Now
            </button>
            <div id="runStatus" class="fhc-sub mt-2"></div>
        </div>
        <script>
            document.getElementById('runAnalysisBtn').addEventListener('click', async function () {
                this.disabled = true;
                document.getElementById('runStatus').textContent = 'Running ML analysis — first run trains the models, please wait…';
                try {
                    const resp = await fetch('/api/msme-data/@Model.Uan/analyze?force=true', { method: 'POST' });
                    if (resp.ok) { location.reload(); }
                    else { document.getElementById('runStatus').textContent = 'Failed: ' + await resp.text(); this.disabled = false; }
                } catch (e) { document.getElementById('runStatus').textContent = 'Error: ' + e; this.disabled = false; }
            });
        </script>
    }
    else
    {
        <!-- ===================== Row 1: Gauge + summary ===================== -->
        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <div class="fhc-card text-center">
                    <div class="fhc-section-label">Overall Financial Health Score</div>
                    <div class="gauge-box">
                        <canvas id="scoreGauge" height="180"></canvas>
                        <div class="gauge-center">
                            <div class="gauge-score">@r!.OverallScore.ToString("0")</div>
                            <div class="gauge-of">out of 1000</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="band-chip band-@r.ScoreBand">
                            <i class="bi bi-patch-check-fill"></i> @r.ScoreBand
                        </span>
                    </div>
                    <div class="fhc-sub mt-3">
                        @(Model.EnterpriseName ?? Model.Uan) &middot; computed @r.ComputedAt.ToString("dd MMM yyyy HH:mm") UTC
                    </div>
                    <button id="reAnalyzeBtn" class="btn text-white mt-3" style="background:var(--brand-btn-bg);border-radius:10px;padding:8px 22px;font-weight:600;">
                        <i class="bi bi-arrow-repeat me-1"></i> Re-analyze Score
                    </button>
                    <div id="reAnalyzeStatus" class="fhc-sub mt-2"></div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="fhc-card">
                    <div class="fhc-section-label">Score Composition</div>
                 @*    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@r.HeuristicScore.ToString("0")</div><div class="k">Rules Engine</div></div></div>
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@r.MlCalibratedScore.ToString("0")</div><div class="k">ML Model</div></div></div>
                        <div class="col-6 col-md-3">
                            <div class="stat-tile">
                                <div class="v">
                                    @(r.CashflowTrendSlope >= 0 ? "▲" : "▼") @Math.Abs(r.CashflowTrendSlope).ToString("0.00")
                                </div>
                                <div class="k">Cashflow Trend</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@(Model.Status?.FilesPresent.Count ?? 0)</div><div class="k">Data Files Used</div></div></div>
                    </div> *@
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <div class="stat-tile">
                                <div class="v">@r.HeuristicScore.ToString("0")</div>
                                <div class="k">Rules Engine</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <div class="stat-tile">
                                <div class="v">@r.MlCalibratedScore.ToString("0")</div>
                                <div class="k">ML Model</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <div class="stat-tile">
                                <div class="v">
                                    @(r.CashflowTrendSlope >= 0 ? "▲" : "▼") @Math.Abs(r.CashflowTrendSlope).ToString("0.00")
                                </div>
                                <div class="k">Cashflow Trend</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <div class="stat-tile">
                                <div class="v">@(Model.Status?.FilesPresent.Count ?? 0)</div>
                                <div class="k">Data Files Used</div>
                            </div>
                        </div>
                    </div>
                    <div class="fhc-section-label">Six Dimensions</div>
                    @foreach (var d in r.Dimensions)
                    {
                        var pct = d.MaxPoints > 0 ? Math.Round(d.Score / d.MaxPoints * 100) : 0;
                        <div class="dim-row @(d.DataAvailable ? "" : "dim-muted")">
                            <div class="dim-name">
                                @d.Dimension
                                @if (d.UsedNeutralDefault) { <i class="bi bi-info-circle text-secondary" title="Neutral default used (New-to-Credit)"></i> }
                                @if (!d.DataAvailable) { <i class="bi bi-slash-circle text-secondary" title="Source unavailable — weight redistributed"></i> }
                            </div>
                            <div class="dim-track"><div class="dim-fill" style="width:@pct%;"></div></div>
                            <div class="dim-val">@d.Score.ToString("0") / @d.MaxPoints.ToString("0")</div>
                        </div>
                    }
                    @if (r.ExcludedDimensions.Count > 0)
                    {
                        <div class="fhc-sub mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Score computed without: @string.Join(", ", r.ExcludedDimensions) — weights redistributed.</div>
                    }
                </div>
            </div>
        </div>

        <script>
            document.getElementById('reAnalyzeBtn').addEventListener('click', async function () {
                this.disabled = true;
                document.getElementById('reAnalyzeStatus').textContent = 'Re-analyzing with the latest data…';
                try {
                    const resp = await fetch('/api/msme-data/@Model.Uan/analyze?force=true', { method: 'POST' });
                    if (resp.ok) {
                        // Best-effort — an email hiccup should never block the reload.
                        try {
                            const theme = localStorage.getItem('frl-theme') || 'theme1';
                            await fetch('/Dashboard/SendFinancialHealthReportEmail?theme=' + encodeURIComponent(theme), { method: 'POST' });
                        } catch (e) { /* ignore */ }
                        location.reload();
                    }
                    else { document.getElementById('reAnalyzeStatus').textContent = 'Failed: ' + await resp.text(); this.disabled = false; }
                } catch (e) { document.getElementById('reAnalyzeStatus').textContent = 'Error: ' + e; this.disabled = false; }
            });
        </script>

        <!-- ===================== Row 2: Charts ===================== -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label">Dimension Radar</div>
                    <canvas id="radarChart" height="300"></canvas>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label">Points Earned vs Maximum</div>
                    <canvas id="barChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- ===================== Row 3: Bank Lending Assessment ===================== -->
        @if (r.Lending != null)
        {
            var l = r.Lending;
            <div class="fhc-card mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div class="fhc-section-label mb-0"><i class="bi bi-bank me-1"></i>Bank Lending Assessment</div>
                    <div class="d-flex align-items-center gap-2">
                        @if (r.Industry != null)
                        {
                            var indColor = r.Industry.Outlook switch
                            {
                                "Favourable" => ("#e3f4ea", "#0f5137"),
                                "Moderate" => ("#fdf3d7", "#8a6d00"),
                                _ => ("#fde8d7", "#9c4a00")
                            };
                            <span class="badge" style="background:@indColor.Item1;color:@indColor.Item2;padding:7px 12px;">
                                <i class="bi bi-buildings me-1"></i>@r.Industry.SectorName — @r.Industry.Outlook outlook
                            </span>
                        }
                        <span class="fhc-sub">band factor ×@l.BandAdjustmentFactor.ToString("0.00") (@r.ScoreBand)</span>
                    </div>
                </div>

                <!-- Eligibility headline tiles -->
              @*   <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid var(--brand-primary-dark);">
                            <div class="v">₹@FormatInr(l.WorkingCapitalLimit)</div>
                            <div class="k">Working Capital Limit</div>
                            <div class="fhc-sub" style="font-size:.7rem;">turnover method (20%)</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid var(--brand-secondary);">
                            <div class="v">₹@FormatInr(l.TermLoanCapacity)</div>
                            <div class="k">Term Loan Capacity</div>
                            <div class="fhc-sub" style="font-size:.7rem;">5 yr @@ 11% on EMI headroom</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid #0f5137;">
                            <div class="v">₹@FormatInr(l.TotalIndicativeEligibility)</div>
                            <div class="k">Total Indicative Eligibility</div>
                            <div class="fhc-sub" style="font-size:.7rem;">WC + term combined</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-tile" style="border-left:4px solid #8a6d00;">
                            <div class="v">₹@FormatInr(l.MarginMoneyRequired)</div>
                            <div class="k">Borrower Margin Required</div>
                            <div class="fhc-sub" style="font-size:.7rem;">5% of turnover (Nayak)</div>
                        </div>
                    </div>
                </div> *@


                <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 d-flex justify-content-center">
        <div class="stat-tile" style="border-left:4px solid var(--brand-primary-dark);">
            <div class="v">₹@FormatInr(l.WorkingCapitalLimit)</div>
            <div class="k">Working Capital Limit</div>
            <div class="fhc-sub" style="font-size:.7rem;">turnover method (20%)</div>
        </div>
    </div>
    <div class="col-6 col-lg-3 d-flex justify-content-center">
        <div class="stat-tile" style="border-left:4px solid var(--brand-secondary);">
            <div class="v">₹@FormatInr(l.TermLoanCapacity)</div>
            <div class="k">Term Loan Capacity</div>
            <div class="fhc-sub" style="font-size:.7rem;">5yr @@ 11% on EMI headroom</div>
        </div>
    </div>
    <div class="col-6 col-lg-3 d-flex justify-content-center">
        <div class="stat-tile" style="border-left:4px solid #0f5137;">
            <div class="v">₹@FormatInr(l.TotalIndicativeEligibility)</div>
            <div class="k">Total Indicative Eligibility</div>
            <div class="fhc-sub" style="font-size:.7rem;">WC + term combined</div>
        </div>
    </div>
    <div class="col-6 col-lg-3 d-flex justify-content-center">
        <div class="stat-tile" style="border-left:4px solid #8a6d00;">
            <div class="v">₹@FormatInr(l.MarginMoneyRequired)</div>
            <div class="k">Borrower Margin Required</div>
            <div class="fhc-sub" style="font-size:.7rem;">5% of turnover (Nayak)</div>
        </div>
    </div>
</div>

                <div class="row g-4">
                    <!-- Ratio table -->
                    <div class="col-lg-7">
                        <div class="fhc-section-label">Credit Appraisal Ratios</div>
                        @foreach (var ratio in l.Ratios)
                        {
                            var chip = ratio.Status switch
                            {
                                FinRiskLensAI.Core.Models.Scoring.RatioStatus.Strong => ("Strong", "#e3f4ea", "#0f5137"),
                                FinRiskLensAI.Core.Models.Scoring.RatioStatus.Adequate => ("Adequate", "#fdf3d7", "#8a6d00"),
                                FinRiskLensAI.Core.Models.Scoring.RatioStatus.Weak => ("Weak", "#fbe0e0", "#8b1020"),
                                _ => ("No data", "#efefef", "#777")
                            };
                            <div class="d-flex align-items-center gap-3 py-2" style="border-bottom:1px dashed #f0e2e7;">
                                <div style="flex:1;">
                                    <div style="font-size:.88rem;font-weight:600;color:#2b2026;">@ratio.Name</div>
                                    <div class="fhc-sub" style="font-size:.74rem;">@ratio.Description</div>
                                </div>
                                <div class="text-end" style="flex:0 0 90px;">
                                    <div style="font-weight:700;color:var(--brand-primary-dark);">@ratio.Display</div>
                                    <div class="fhc-sub" style="font-size:.7rem;">norm @ratio.Benchmark</div>
                                </div>
                                <span class="badge" style="flex:0 0 84px;background:@chip.Item2;color:@chip.Item3;">@chip.Item1</span>
                            </div>
                        }
                    </div>

                    <!-- Cashflow vs debt capacity chart -->
                    <div class="col-lg-5">
                        <div class="fhc-section-label">Monthly Cashflow &amp; EMI Capacity</div>
                        <canvas id="lendingChart" height="260"></canvas>
                        <div class="lending-notes mt-3">
                            <div class="lending-notes-head">
                                <i class="bi bi-journal-text"></i> How this was calculated
                            </div>
                            @foreach (var note in l.Notes)
                            {
                                var isWarning = note.Contains("verify", StringComparison.OrdinalIgnoreCase)
                                             || note.Contains("No AA", StringComparison.OrdinalIgnoreCase);
                                <div class="lending-note @(isWarning ? "warn" : "")">
                                    <i class="bi @(isWarning ? "bi-exclamation-triangle-fill" : "bi-check2-circle")"></i>
                                    <span>@note</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ===================== Bank Statement Analysis ===================== -->
        @if (r.BankAnalysis != null)
        {
            var b = r.BankAnalysis;
            <div class="fhc-card mb-4">
                <div class="fhc-section-label"><i class="bi bi-credit-card-2-front me-1"></i>Bank Statement Analysis (Account Aggregator)</div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.AverageMonthlyBalance)</div><div class="k">Avg Monthly Balance</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.PeakBalance)</div><div class="k">Peak Balance</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.CustomerReceiptsMonthly)</div><div class="k">Customer Receipts / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.SupplierPaymentsMonthly)</div><div class="k">Supplier Payments / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.CashDepositsMonthly)</div><div class="k">Cash Deposits / mo</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@FormatInr(b.SalaryCreditsMonthly)</div><div class="k">Salary Credits / mo</div></div></div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(b.ChequeReturnCount + b.EcsNachReturnCount > 0 ? "#8b1020" : "#0f5137");">
                                @b.ChequeReturnCount / @b.EcsNachReturnCount
                            </div>
                            <div class="k">Cheque / ECS-NACH Returns</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(b.MinBalanceBreachCount + b.OverdrawnTxnCount > 0 ? "#9c4a00" : "#0f5137");">
                                @b.MinBalanceBreachCount / @b.OverdrawnTxnCount
                            </div>
                            <div class="k">Min-Bal Breaches / Overdrawn</div>
                            <div class="fhc-sub" style="font-size:.68rem;">OD limit ₹@FormatInr(b.OdLimitTotal)</div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fhc-section-label">Monthly Average Balance Trend</div>
                        <div style="height:170px;"><canvas id="balanceChart"></canvas></div>
                    </div>
                    <div class="col-lg-5">
                        <div class="fhc-section-label">Transaction Value by Channel</div>
                        <div style="height:170px;max-width:280px;margin:0 auto;"><canvas id="modeChart"></canvas></div>
                    </div>
                </div>
            </div>
        }

        <!-- ===================== GST Deep-Dive ===================== -->
        @if (r.GstAnalysis != null)
        {
            var g = r.GstAnalysis;
            <div class="fhc-card mb-4">
                <div class="fhc-section-label"><i class="bi bi-receipt me-1"></i>GST Deep-Dive</div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(g.R1Vs3bConsistency >= 0.9 ? "#0f5137" : "#9c4a00");">@(g.R1Vs3bConsistency > 0 ? g.R1Vs3bConsistency.ToString("P0") : "N/A")</div>
                            <div class="k">GSTR-1 vs 3B Consistency</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v">@(g.HasTaxPaymentData ? g.CashTaxShare.ToString("P0") : "N/A")</div>
                            <div class="k">Tax Paid in Cash</div>
                            <div class="fhc-sub" style="font-size:.68rem;">rest settled via ITC</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v">₹@FormatInr(g.ItcMonthlyAvg)</div>
                            <div class="k">Net ITC / month</div>
                            @if (g.Has2bData) { <div class="fhc-sub" style="font-size:.68rem;">2B available ₹@FormatInr(g.ItcAvailableMonthly)</div> }
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(g.Has2bData && g.ItcClaimVsAvailable > 1.0 ? "#8b1020" : "#0f5137");">
                                @(g.Has2bData && g.ItcClaimVsAvailable > 0 ? g.ItcClaimVsAvailable.ToString("P0") : "N/A")
                            </div>
                            <div class="k">ITC Claimed vs 2B</div>
                            <div class="fhc-sub" style="font-size:.68rem;">&gt;100% = over-claiming</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(g.SupplierFilingRate >= 0.9 ? "#0f5137" : "#9c4a00");">
                                @(g.Has2bData ? g.SupplierFilingRate.ToString("P0") : "N/A")
                            </div>
                            <div class="k">Supplier Filing Rate (2B)</div>
                            @if (g.Has2bData && g.ItcUnavailableShare > 0) { <div class="fhc-sub" style="font-size:.68rem;">ITC unavailable @g.ItcUnavailableShare.ToString("P1")</div> }
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-tile">
                            <div class="v" style="color:@(g.TopCustomerShare > 0.4 ? "#9c4a00" : "#0f5137");">@(g.TopCustomerShare > 0 ? g.TopCustomerShare.ToString("P0") : "N/A")</div>
                            <div class="k">Top Customer Share</div>
                            <div class="fhc-sub" style="font-size:.68rem;">top vendor @(g.TopVendorShare > 0 ? g.TopVendorShare.ToString("P0") : "N/A")</div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Monthly GST Sales</div>
                        <canvas id="gstSalesChart" height="240"></canvas>
                    </div>
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Major Customers (share of B2B sales)</div>
                        <canvas id="customerChart" height="240"></canvas>
                    </div>
                    <div class="col-lg-4">
                        <div class="fhc-section-label">Major Vendors (share of purchases)</div>
                        <canvas id="vendorChart" height="240"></canvas>
                    </div>
                </div>
            </div>
        }

        <!-- ===================== Row 4: Strengths / Risks ===================== -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-arrow-up-circle-fill me-1" style="color:#0f5137;"></i>Key Strengths</div>
                    @foreach (var e in r.Explanations.Where(x => x.Impact == FinRiskLensAI.Core.Models.Scoring.ImpactDirection.Positive).OrderByDescending(x => x.RelativeWeight))
                    {
                        <div class="expl-item">
                            <i class="bi bi-check-circle-fill" style="color:#0f5137;"></i>
                            <div><div class="expl-dim">@e.Dimension</div>@e.ExplanationText</div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-arrow-down-circle-fill me-1" style="color:#8b1020;"></i>Risk Factors</div>
                    @{ var risks = r.Explanations.Where(x => x.Impact == FinRiskLensAI.Core.Models.Scoring.ImpactDirection.Negative).OrderByDescending(x => x.RelativeWeight).ToList(); }
                    @if (risks.Count == 0)
                    {
                        <div class="fhc-sub py-3"><i class="bi bi-emoji-smile me-1"></i>No material risk factors surfaced by the model.</div>
                    }
                    @foreach (var e in risks)
                    {
                        <div class="expl-item">
                            <i class="bi bi-exclamation-circle-fill" style="color:#9c4a00;"></i>
                            <div><div class="expl-dim">@e.Dimension</div>@e.ExplanationText</div>
                        </div>
                    }

                    <div class="fhc-section-label mt-4">Cross-Source Income Check</div>
                    <div class="anomaly-box @(r.Anomaly.IsAnomalous ? "flagged" : "")">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi @(r.Anomaly.IsAnomalous ? "bi-flag-fill" : "bi-shield-check")"></i>
                            <strong>@(r.Anomaly.IsAnomalous ? "Mismatch flagged for review" : "No cross-source mismatch flagged")</strong>
                            <span class="ms-auto fhc-sub">anomaly score @r.Anomaly.AnomalyScore.ToString("0.00")</span>
                        </div>
                        GST ₹@FormatInr(r.Anomaly.GstMonthlyTurnover)/mo &middot;
                        ITR ₹@FormatInr(r.Anomaly.ItrMonthlyIncome)/mo &middot;
                        Bank credits ₹@FormatInr(r.Anomaly.BankMonthlyCredits)/mo
                        @if (!string.IsNullOrEmpty(r.Anomaly.Note)) { <div class="fhc-sub mt-1">@r.Anomaly.Note</div> }
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== Row 4: Recommendations ===================== -->
        <div class="fhc-card mb-4">
            <div class="fhc-section-label"><i class="bi bi-lightbulb-fill me-1" style="color:#8a6d00;"></i>Recommended Credit Products</div>
            @if (r.Recommendations.Count == 0)
            {
                <div class="fhc-sub py-2">No products recommended at this band — improve the weak dimensions above first.</div>
            }
            <div class="row g-3">
                @foreach (var p in r.Recommendations)
                {
                    <div class="col-md-6">
                        <div class="reco-card">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong>@p.ProductName</strong>
                                <span class="badge" style="background:var(--brand-tint-bg-2);color:var(--brand-primary-dark);">@p.SchemeCode</span>
                            </div>
                            <div class="reco-amt my-1">₹@FormatInr((double)p.IndicativeAmountMin) – ₹@FormatInr((double)p.IndicativeAmountMax)</div>
                            <div class="fhc-sub">@p.RecommendationReason</div>
                        </div>
                    </div>
                }
            </div>
            <div class="fhc-sub mt-3">Model @r.ModelVersion &middot; indicative amounts anchored to observed turnover — not a sanctioned limit.</div>
        </div>

        <!-- ===================== Charts script ===================== -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            const dims = @Html.Raw(Json.Serialize(r.Dimensions.Select(d => new { d.Dimension, d.Score, d.MaxPoints })));
            const score = @r.OverallScore.ToString(System.Globalization.CultureInfo.InvariantCulture);
            // Brand colors follow the active theme (see ~/css/theme.css). Read
            // fresh (not just once at load) so re-applying after a theme
            // switch — see frl-theme-changed below — picks up the new values.
            function readBrandColors() {
                const cs = getComputedStyle(document.documentElement);
                return {
                    maroon: cs.getPropertyValue('--brand-btn-bg').trim() || '#f37021',
                    rose: cs.getPropertyValue('--brand-secondary').trim() || '#974354',
                    tint2: cs.getPropertyValue('--brand-tint-bg-2').trim() || '#f2e6ea',
                    accent: cs.getPropertyValue('--brand-btn-bg-hover').trim() || '#c98a2b'
                };
            }
            let { maroon, rose, tint2, accent } = readBrandColors();
            const charts = {};

            // ── Score meter: 5 band segments + needle
            const bandColors = ['#c22f3e', '#e08a3c', '#e6c34c', '#7fae5e', '#2e7d4f'];
            const needle = {
                id: 'needle',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const meta = chart.getDatasetMeta(0).data[0];
                    const cx = meta.x, cy = meta.y, r = meta.outerRadius;
                    const angle = Math.PI + (score / 1000) * Math.PI;
                    ctx.save();
                    ctx.translate(cx, cy);
                    ctx.rotate(angle);
                    ctx.beginPath();
                    ctx.moveTo(0, -4); ctx.lineTo(r * 0.82, 0); ctx.lineTo(0, 4);
                    ctx.fillStyle = maroon; ctx.fill();
                    ctx.beginPath(); ctx.arc(0, 0, 8, 0, Math.PI * 2); ctx.fill();
                    ctx.restore();
                }
            };
            charts.gauge = new Chart(document.getElementById('scoreGauge'), {
                type: 'doughnut',
                data: { datasets: [{
                    data: [350, 150, 150, 150, 200],       // HighRisk / AtRisk / Fair / Good / Excellent widths
                    backgroundColor: bandColors, borderWidth: 2, borderColor: '#fff'
                }]},
                options: {
                    rotation: -90, circumference: 180, cutout: '72%',
                    aspectRatio: 1.9,
                    layout: { padding: { bottom: 4 } },
                    plugins: { legend: { display: false }, tooltip: { enabled: false } },
                    animation: { animateRotate: true }
                },
                plugins: [needle]
            });

            // ── Radar: % of each dimension's max
            charts.radar = new Chart(document.getElementById('radarChart'), {
                type: 'radar',
                data: {
                    labels: dims.map(d => d.dimension.replace(' ', '\n')),
                    datasets: [{
                        label: '% of maximum',
                        data: dims.map(d => d.maxPoints > 0 ? Math.round(d.score / d.maxPoints * 100) : 0),
                        backgroundColor: maroon + '2e', borderColor: maroon,
                        pointBackgroundColor: maroon, borderWidth: 2
                    }]
                },
                options: {
                    scales: { r: { min: 0, max: 100, ticks: { stepSize: 20, backdropColor: 'transparent' }, pointLabels: { font: { size: 11 } } } },
                    plugins: { legend: { display: false } }
                }
            });

            // ── Lending: monthly cashflow vs EMI capacity
            const lendingEl = document.getElementById('lendingChart');
            if (lendingEl) {
                const lend = @Html.Raw(Json.Serialize(r.Lending == null ? null : new {
                    inflow = r.Lending.MonthlyBankInflow,
                    outflow = r.Lending.MonthlyBankOutflow,
                    surplus = Math.Max(0, r.Lending.MonthlySurplus),
                    existingEmi = r.Lending.ExistingMonthlyEmi,
                    affordableEmi = r.Lending.AffordableMonthlyEmi
                }));
                if (lend) {
                    new Chart(lendingEl, {
                        type: 'bar',
                        data: {
                            labels: ['Bank Inflow', 'Bank Outflow', 'Surplus', 'Existing EMI', 'EMI Headroom'],
                            datasets: [{
                                data: [lend.inflow, lend.outflow, lend.surplus, lend.existingEmi, lend.affordableEmi],
                                backgroundColor: ['#2e7d4f', '#c22f3e', '#7fae5e', '#e08a3c', maroon],
                                borderRadius: 6
                            }]
                        },
                        options: {
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { label: c => '₹' + new Intl.NumberFormat('en-IN').format(Math.round(c.parsed.y)) + '/mo' } }
                            },
                            scales: { y: { beginAtZero: true, ticks: { callback: v => '₹' + new Intl.NumberFormat('en-IN', { notation: 'compact' }).format(v) } } }
                        }
                    });
                }
            }

            // ── Deep-dive charts (render only when their canvas exists)
            const monthLabel = k => {
                const names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                return names[parseInt(k.substring(4)) - 1] + ' ' + k.substring(2, 4);
            };
            const inr = v => '₹' + new Intl.NumberFormat('en-IN', { notation: 'compact' }).format(v);

            const bank = @Html.Raw(Json.Serialize(r.BankAnalysis == null ? null : new {
                balances = r.BankAnalysis.MonthlyAvgBalance,
                modes = r.BankAnalysis.ModeSplitAmount
            }));
            if (bank && document.getElementById('balanceChart')) {
                const keys = Object.keys(bank.balances).sort();
                charts.balance = new Chart(document.getElementById('balanceChart'), {
                    type: 'line',
                    data: { labels: keys.map(monthLabel), datasets: [{
                        data: keys.map(k => bank.balances[k]),
                        borderColor: maroon, backgroundColor: maroon + '1f',
                        fill: true, tension: .35, pointBackgroundColor: maroon
                    }]},
                    options: { maintainAspectRatio: false,
                        plugins: { legend: { display: false },
                        tooltip: { callbacks: { label: c => inr(c.parsed.y) } } },
                        scales: { y: { ticks: { callback: inr } } } }
                });
                const modeKeys = Object.keys(bank.modes);
                charts.mode = new Chart(document.getElementById('modeChart'), {
                    type: 'doughnut',
                    data: { labels: modeKeys, datasets: [{
                        data: modeKeys.map(k => bank.modes[k]),
                        backgroundColor: [maroon, rose, accent, '#2e7d4f', '#7fae5e', '#8a6d00', '#c22f3e'],
                        borderColor: '#fff', borderWidth: 2
                    }]},
                    options: { maintainAspectRatio: false, cutout: '58%',
                        plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { size: 10 } } },
                        tooltip: { callbacks: { label: c => c.label + ': ' + inr(c.parsed) } } } }
                });
            }

            const gst = @Html.Raw(Json.Serialize(r.GstAnalysis == null ? null : new {
                sales = r.GstAnalysis.MonthlySales,
                customers = r.GstAnalysis.TopCustomers,
                vendors = r.GstAnalysis.TopVendors
            }));
            if (gst && document.getElementById('gstSalesChart')) {
                const saleKeys = Object.keys(gst.sales).sort();
                charts.gstSales = new Chart(document.getElementById('gstSalesChart'), {
                    type: 'bar',
                    data: { labels: saleKeys.map(monthLabel), datasets: [{
                        data: saleKeys.map(k => gst.sales[k]), backgroundColor: maroon, borderRadius: 6
                    }]},
                    options: { plugins: { legend: { display: false },
                        tooltip: { callbacks: { label: c => inr(c.parsed.y) } } },
                        scales: { y: { beginAtZero: true, ticks: { callback: inr } } } }
                });
                const shareBar = (id, data, color) => {
                    const keys = Object.keys(data);
                    if (keys.length === 0) { document.getElementById(id).replaceWith('No data'); return null; }
                    return new Chart(document.getElementById(id), {
                        type: 'bar',
                        data: { labels: keys, datasets: [{
                            data: keys.map(k => Math.round(data[k] * 100)), backgroundColor: color, borderRadius: 6
                        }]},
                        options: { indexAxis: 'y', plugins: { legend: { display: false },
                            tooltip: { callbacks: { label: c => c.parsed.x + '% share' } } },
                            scales: { x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } },
                                      y: { ticks: { font: { size: 9, family: 'monospace' } } } } }
                    });
                };
                charts.customer = shareBar('customerChart', gst.customers, rose);
                charts.vendor = shareBar('vendorChart', gst.vendors, accent);
            }

            // ── Horizontal bars: earned vs max
            charts.bar = new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: dims.map(d => d.dimension),
                    datasets: [
                        { label: 'Earned', data: dims.map(d => d.score), backgroundColor: maroon, borderRadius: 6 },
                        { label: 'Maximum', data: dims.map(d => d.maxPoints), backgroundColor: tint2, borderRadius: 6 }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    scales: { x: { beginAtZero: true, max: 260 } },
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // ── Re-color every chart in place when the theme is switched —
            // Chart.js datasets hold plain color strings, so a CSS variable
            // change alone (data-theme flip) never reaches an already-drawn
            // canvas. See frlSetTheme in ~/js/theme.js for the dispatch side.
            document.addEventListener('frl-theme-changed', function () {
                ({ maroon, rose, tint2, accent } = readBrandColors());

                if (charts.gauge) charts.gauge.update();               // needle reads `maroon` live at draw time

                if (charts.radar) {
                    const ds = charts.radar.data.datasets[0];
                    ds.backgroundColor = maroon + '2e'; ds.borderColor = maroon; ds.pointBackgroundColor = maroon;
                    charts.radar.update();
                }
                if (charts.bar) {
                    charts.bar.data.datasets[0].backgroundColor = maroon;
                    charts.bar.data.datasets[1].backgroundColor = tint2;
                    charts.bar.update();
                }
                if (charts.balance) {
                    const ds = charts.balance.data.datasets[0];
                    ds.borderColor = maroon; ds.backgroundColor = maroon + '1f'; ds.pointBackgroundColor = maroon;
                    charts.balance.update();
                }
                if (charts.mode) {
                    charts.mode.data.datasets[0].backgroundColor[0] = maroon;
                    charts.mode.data.datasets[0].backgroundColor[1] = rose;
                    charts.mode.data.datasets[0].backgroundColor[2] = accent;
                    charts.mode.update();
                }
                if (charts.gstSales) { charts.gstSales.data.datasets[0].backgroundColor = maroon; charts.gstSales.update(); }
                if (charts.customer) { charts.customer.data.datasets[0].backgroundColor = rose; charts.customer.update(); }
                if (charts.vendor) { charts.vendor.data.datasets[0].backgroundColor = accent; charts.vendor.update(); }
            });
        </script>
    }

@functions {
    private static string FormatInr(double v)
    {
        if (v >= 10_000_000) return (v / 10_000_000).ToString("0.##") + " Cr";
        if (v >= 100_000) return (v / 100_000).ToString("0.##") + " L";
        return v.ToString("N0");
    }
}
