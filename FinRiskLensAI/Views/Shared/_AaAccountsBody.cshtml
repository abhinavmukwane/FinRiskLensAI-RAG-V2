@using FinRiskLensAI.Core.Models.AccountAggregator
@model AaAnalysisResult
@*
    Shared Account Aggregator accounts body — statement overview plus the
    linked accounts as reported by the FIP. Rendered by the customer page
    (/AccountAggregator/AADetails) and the bank portal Customer 360, so both
    surfaces list the same accounts from one code path.

    Extracted from AADetails.cshtml when the bank portal needed the same
    panel; the deep analysis lives in _AaAnalysisBody alongside it.
*@

@functions {
    static string Inr(decimal v)
    {
        var abs = Math.Abs(v);
        if (abs >= 10000000m) return $"₹{v / 10000000m:0.##} Cr";
        if (abs >= 100000m) return $"₹{v / 100000m:0.##} L";
        return $"₹{v:N0}";
    }
}

@{
    // Bank Admin's Customer 360 (Views/BankAdmin/Customer.cshtml) sets this
    // before rendering this partial, since it has no header of its own for
    // the AA pane. The customer-facing page (/AccountAggregator/AADetails)
    // already renders its own header above this partial, so this block must
    // stay out of that path or the header would show twice.
    var isBankPortal = ViewData["IsBankPortal"] as bool? ?? false;
}

@if (!Model.HasData)
{
    <div class="aa-analysis">
        <div class="alert alert-warning rounded-4 mb-0">
            <i class="bi bi-info-circle me-2"></i>
            @(Model.LoadError ?? "No Account Aggregator statement is available.")
        </div>
    </div>
    return;
}

@if (isBankPortal)
{
    <div class="aa-page-head d-flex flex-column flex-lg-row align-items-lg-center mb-4 gap-3">
        <div class="d-flex flex-column align-items-center gap-2 flex-shrink-0">
            <div class="aa-ring">
                <svg viewBox="0 0 120 120">
                    <circle class="track" cx="60" cy="60" r="52"></circle>
                    <circle class="prog" cx="60" cy="60" r="52"
                            stroke="#4caf50"
                            style="stroke-dasharray:327; stroke-dashoffset:@(327 - 327 * Math.Max(0, Math.Min(100, Model.HealthScore)) / 100);"></circle>
                </svg>
                <div class="center">
                    <span class="num">@Model.HealthScore</span>
                    <span class="den">/ 100</span>
                </div>
            </div>
            <span class="aa-grade grade-@Model.RiskGrade.ToLowerInvariant()">Risk Grade: @Model.RiskGrade</span>
        </div>
        <div class="flex-grow-1">
            <div class="aa-eyebrow" style="color:#fff;">
                <span style="font-size:12px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; opacity:0.7;">
                    <i class="bi bi-bank2 me-1"></i>Account Aggregator · Statement Linked
                </span>
            </div>
            <h3 class="fhc-title mb-1">Account Aggregator Details</h3>
            <p class="fhc-sub mb-0">Bank account information received through the AA consent journey.</p>
        </div>
    </div>
}
<div class="aa-analysis">
    <!-- Statement overview -->
    <div class="aa-card">
        <div class="aa-card-head">
            <h6><i class="bi bi-file-earmark-text"></i>Statement Overview</h6>
            <p class="aa-sub">@Model.AnalysisPeriod</p>
        </div>
        <div class="aa-kpi-grid">
            <div class="aa-kpi"><span class="lbl">Linked Accounts</span><span class="val">@Model.Accounts.Count</span></div>
            <div class="aa-kpi"><span class="lbl">Transactions</span><span class="val">@Model.TransactionCount</span><span class="hint">@Model.MonthsCovered month(s)</span></div>
            <div class="aa-kpi"><span class="lbl">Total Credits</span><span class="val pos">@Inr(Model.TotalCredits)</span></div>
            <div class="aa-kpi"><span class="lbl">Total Debits</span><span class="val neg">@Inr(Model.TotalDebits)</span></div>
            <div class="aa-kpi"><span class="lbl">Net Cash Flow</span><span class="val @(Model.NetCashFlow >= 0 ? "pos" : "neg")">@Inr(Model.NetCashFlow)</span></div>
            <div class="aa-kpi">
                <span class="lbl">Closing Balance</span>
                <span class="val">@(Model.BalanceAvailable && Model.ClosingBalance.HasValue ? Inr(Model.ClosingBalance.Value) : "Not reported")</span>
            </div>
        </div>
    </div>

    <!-- Linked accounts as reported by the FIP -->
    <div class="aa-card">
        <div class="aa-card-head"><h6><i class="bi bi-credit-card-2-front"></i>Linked Accounts</h6></div>
        <div class="aa-table-wrap">
            <table class="aa-table">
                <thead>
                    <tr><th>Account</th><th>FIP</th><th>Type</th><th>Branch</th><th>IFSC</th><th>Status</th><th class="num">Txns</th><th class="num">Reported Balance</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr>
                            <td><strong>@a.MaskedAccountNumber</strong></td>
                            <td>@a.FipName</td>
                            <td><span class="aa-pill">@a.Type</span></td>
                            <td>@a.Branch</td>
                            <td>@a.IfscCode</td>
                            <td>@a.Status</td>
                            <td class="num">@a.TransactionCount</td>
                            <td class="num">@(a.CurrentBalance.HasValue ? Inr(a.CurrentBalance.Value) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
