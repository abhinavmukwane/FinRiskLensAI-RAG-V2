</div>

<script>
    // Hand this screen's full analysis to the universal chatbot — sent to the
    // server only once, together with the first question.
    window.frlChatContext = {
        pageKey: 'MCADetails',
        pageName: 'Corporate Affairs (MCA) — Corporate Intelligence Report page',
        context: @Html.Raw(Json.Serialize(Model))
    };
</script>
@* Charge series for the charges chart — small, aggregate-only payload,
   ordered the way the chart reads left to right. *@
<script id="mcaChargeData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charges
        .Where(c => c.Amount > 0)
        .OrderBy(c => c.Year).ThenByDescending(c => c.Amount)
        .Select(c => new {
            year = c.Year,
            amount = c.Amount,
            label = c.AmountShort,
            status = c.Status,
            open = c.IsOpen,
            asset = c.Asset
        })))
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
