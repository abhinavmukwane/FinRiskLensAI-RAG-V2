@model FinRiskLensAI.Core.Models.Mca.McaDetailsViewModel
@*

    Shared MCA "Corporate Intelligence Report" body. Rendered by the customer

    page (Views/Mca/MCADetails) and the bank portal Customer 360.

*@

@*
    Pure presentation view — all data binding and the corporate-credibility
    analysis (score, risk, observations, journey) are computed in
    McaController.BuildAnalysis from the MCA response cached in
    m_StaticResponces.MCAResponce. DIN drill-down loads on director click via
    /Mca/GetDinDetail. Page behavior lives in ~/FRLScripts/Mca/McaDetails.js.
*@

@if (!Model.HasData && !Model.IsApplicable)
{
    @* Not a lookup failure — this constitution is not on the MCA register at all. *@
    var org = string.IsNullOrWhiteSpace(Model.OrganizationType) ? "a non-corporate entity" : Model.OrganizationType;

    @* Scoped to this state and inlined so it travels with the partial — the customer
       page and the bank portal load different stylesheets. *@
    <style>
        .mca-na { background: var(--card-bg, #fff); border: 1px solid var(--card-border, #e6e9ef) !important; }
        .mca-na-icon {
            flex: 0 0 auto; width: 46px; height: 46px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; font-size: 1.35rem;
            background: var(--brand-tint-bg-1, rgba(0, 91, 76, .08));
            color: var(--color-primary, var(--theme-maroon, #005b4c));
        }
        .mca-na-option {
            border: 1px solid var(--card-border, #e6e9ef); border-radius: 14px; padding: 16px;
            color: inherit; transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
        }
        .mca-na-option:hover {
            border-color: var(--color-primary, #005b4c);
            box-shadow: 0 6px 18px rgba(0, 0, 0, .06); transform: translateY(-2px);
        }
        .mca-na-option i { font-size: 1.15rem; color: var(--color-primary, #005b4c); }
        .mca-na-option-name { font-weight: 600; margin-top: 8px; }
        .mca-na-option-desc { font-size: .82rem; color: var(--color-on-surface-variant, #6b7280); margin-top: 2px; }
    </style>

    <div class="container-fluid py-4 udyam-dashboard">
        <div class="mca-na card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="mca-na-icon"><i class="bi bi-building-slash"></i></div>
                    <div>
                        <h5 class="mb-1 fw-bold">MCA registry does not apply to this enterprise</h5>
                        <p class="text-muted mb-0">
                            Registered as <strong>@org</strong>. Only companies and LLPs are
                            incorporated with the Registrar of Companies, so this enterprise holds
                            <strong>no CIN and no DIN</strong> — there is nothing to look up, and
                            nothing missing.
                        </p>
                    </div>
                </div>

                @if (Model.AvailableSources.Any())
                {
                    <hr class="my-4" />
                    <div class="text-uppercase small fw-semibold text-muted mb-3">
                        Verified through these registries instead
                    </div>
                    <div class="row g-3">
                        @foreach (var src in Model.AvailableSources)
                        {
                            <div class="col-12 col-md-6 col-xl-3">
                                <a class="mca-na-option d-block h-100 text-decoration-none" href="@src.Url">
                                    <i class="bi @src.Icon"></i>
                                    <div class="mca-na-option-name">@src.Name</div>
                                    <div class="mca-na-option-desc">@src.Description</div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    return;
}

@if (!Model.HasData)
{
    <div class="container-fluid py-4 udyam-dashboard">
        <div class="alert alert-danger rounded-4">
            @(Model.LoadError ?? "No MCA data is available for your account.")
        </div>
    </div>
    return;
}

@* Design-reference fonts (headings: Outfit, body: Plus Jakarta Sans) *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="container-fluid py-4 udyam-dashboard">

    <!-- ===== HERO BANNER — score + quick stats ===== -->
    <div class="hero-banner d-flex flex-column flex-md-row align-items-center gap-4">
        <div class="hero-score-ring">
            <svg viewBox="0 0 120 120">
                <circle class="gauge-track" cx="60" cy="60" r="54"></circle>
                <circle id="heroGauge" class="gauge-progress" cx="60" cy="60" r="54"
                        style="stroke-dasharray:339; stroke-dashoffset:@(339 - 339 * Model.Score / 100);"></circle>
            </svg>
            <div class="score-value">
                <span>@Model.Score</span>
                <small>/ 100</small>
            </div>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size:12px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; opacity:0.7;">
                    <i class="bi bi-patch-check-fill me-1"></i>MCA Verified &middot; DIN Verified
                </span>
            </div>
            <h2>Corporate Intelligence Report</h2>
            <p>@Model.CompanyName &middot; CIN: @Model.Cin</p>
            <div class="hero-stats">
                <div class="hero-stat-item"><div class="value">@Model.Status</div><div class="label">Company</div></div>
                <div class="hero-stat-item"><div class="value">@Model.Directors.Count</div><div class="label">Directors</div></div>
                <div class="hero-stat-item"><div class="value">@Model.TotalCharges</div><div class="label">Charges</div></div>
                <div class="hero-stat-item"><div class="value">@Model.MaxChargeText</div><div class="label">Max Charge</div></div>
                <div class="hero-stat-item"><div class="value">@Model.OverallRiskLabel</div><div class="label">Risk</div></div>
            </div>
        </div>
        @* <div class="d-flex flex-column gap-2 align-self-start">
            <button id="btnDownloadReport" type="button" class="btn btn-outline-theme" style="border-color:rgba(255,255,255,.3); color:#fff;">
                <i class="bi bi-download me-1"></i> Download
            </button>
            <button id="btnRefreshData" type="button" class="btn" style="background:rgba(255,255,255,.12); color:#fff; border-radius:10px; font-weight:600; padding:9px 18px;">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div> *@
    </div>

    <!-- ===== TABS ===== -->
    <div class="mca2-tabs" role="tablist">
        <button class="mca2-tab active" data-tab="tab-overview"><i class="bi bi-grid-1x2"></i>Overview</button>
        <button class="mca2-tab" data-tab="tab-directors"><i class="bi bi-people"></i>Directors</button>
        <button class="mca2-tab" data-tab="tab-charges"><i class="bi bi-cash-stack"></i>Charges</button>
        <button class="mca2-tab" data-tab="tab-risk"><i class="bi bi-shield-exclamation"></i>Risk Analysis</button>
    </div>

    <!-- ===================== TAB 1: OVERVIEW ===================== -->
    <div class="tab-panel active" id="tab-overview">

        <div class="row g-4 mb-4">
            <!-- Split panel: capital/compliance + corporate profile -->
            <div class="col-12 col-lg-7">
                <div class="split-panel h-100">
                    <div class="split-left d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="card-label">Capital Structure</h6>
                            <ul class="mini-list">
                                <li><span>Authorized</span><strong>@Model.AuthorizedCapitalText</strong></li>
                                <li><span>Paid Up</span><strong>@Model.PaidUpCapitalText</strong></li>
                                <li><span>Members</span><strong>@Model.Members</strong></li>
                            </ul>
                        </div>
                        <div class="mt-4">
                            <h6 class="card-label">Compliance</h6>
                            <ul class="mini-list">
                                <li><span>AGM</span><strong>@Model.LastAgmDate</strong></li>
                                <li><span>Balance Sheet</span><strong>@Model.LastBsDate</strong></li>
                                <li><span>CIRP</span><strong>@Model.CirpText</strong></li>
                            </ul>
                        </div>
                    </div>
                    <div class="split-right">
                        <h6 class="card-heading"><i class="bi bi-building me-2"></i>Corporate Profile</h6>
                        <ul class="profile-list list-unstyled mb-0">
                            <li><span>Company Name</span><strong>@Model.CompanyName</strong></li>
                            <li><span>CIN</span><strong style="font-size:12px;">@Model.Cin</strong></li>
                            <li><span>Type</span><strong>@Model.CompanyClass Company</strong></li>
                            <li><span>Category</span><strong>@Model.Category</strong></li>
                            <li>
                                <span>Status</span>
                                @if (Model.IsActive)
                                {
                                    <strong class="status-active"><i class="bi bi-dot"></i>@Model.Status</strong>
                                }
                                else
                                {
                                    <strong style="color:var(--danger-red);">@Model.Status</strong>
                                }
                            </li>
                            <li><span>Listed</span><strong>@Model.Listed</strong></li>
                            <li><span>Incorporated</span><strong>@Model.IncorporationDateText</strong></li>
                            <li class="no-border"><span>ROC</span><strong>@Model.RocCode</strong></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- AI Observations -->
            <div class="col-12 col-lg-5">
                <div class="dash-card h-100">
                    <h6 class="card-heading"><i class="bi bi-stars me-2"></i>AI Observations</h6>
                    <ul class="signal-list list-unstyled mb-0">
                        @foreach (var o in Model.Observations)
                        {
                            <li class="@o.CssClass">
                                <i class="bi @o.Icon"></i>
                                <div><p class="signal-title mb-0">@o.Text</p></div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Incorporation Journey -->
            <div class="col-12 col-md-5">
                <div class="dash-card h-100">
                    <h6 class="card-heading"><i class="bi bi-calendar3 me-2"></i>Incorporation Journey</h6>
                    <div class="v-stepper">
                        @foreach (var step in Model.JourneySteps)
                        {
                            <div class="v-step">
                                <div class="v-step-dot @step.DotCss"><i class="bi @step.Icon"></i></div>
                                <div class="v-step-title">@step.Title</div>
                                <div class="v-step-sub">@step.Sub</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick risk indicators -->
            <div class="col-12 col-md-7">
                <div class="dash-card glass-card h-100">
                    <h6 class="card-heading mb-3"><i class="bi bi-shield-exclamation me-2"></i>Quick Risk Indicators</h6>
                    <div class="row g-3">
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">Company</div>
                                <div class="risk-indicator-value"><span class="status-dot @(Model.IsActive ? "green" : "red")"></span> @Model.Status</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">Listed</div>
                                <div class="risk-indicator-value"><span class="status-dot grey"></span> @Model.Listed</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">CIRP</div>
                                <div class="risk-indicator-value"><span class="status-dot @(Model.HasCirp ? "red" : "green")"></span> @(Model.HasCirp ? "Yes" : "No")</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">Suspended</div>
                                <div class="risk-indicator-value"><span class="status-dot @(Model.SuspendedText == "No" ? "green" : "red")"></span> @Model.SuspendedText</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">Open Charges</div>
                                <div class="risk-indicator-value"><span class="status-dot @(Model.OpenChargeCount == 0 ? "green" : "orange")"></span> @Model.OpenChargeCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-4">
                            <div class="risk-indicator-card">
                                <div class="risk-indicator-label">Directors</div>
                                <div class="risk-indicator-value"><span class="status-dot @(Model.Directors.Count > 0 ? "green" : "red")"></span> @(Model.Directors.Count > 0 ? "Stable" : "None")</div>
                            </div>
                        </div>
                    </div>

                    <div class="score-observations mt-4">
                        <p class="observations-text mb-0">
                            Corporate credibility is <strong>@Model.RiskLabel.Replace(" Risk", "" ) (@Model.Score/100)</strong>.
                            @(Model.IsActive ? "Active company" : "Company status needs review") with @Model.Directors.Count verified director@(Model.Directors.Count == 1 ? "" : "s")
                            and @(Model.OpenChargeCount > 0 ? $"secured financial charges ({Model.TotalOpenAmountText} open)" : "no open financial charges").
                            Suitable for further GST and Banking assessment.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== TAB 2: DIRECTORS ===================== -->
    <div class="tab-panel" id="tab-directors">

        <h6 class="card-heading mb-3"><i class="bi bi-people-fill me-2"></i>Board of Directors</h6>
        @* Three-up grid rather than a horizontal scroll strip, so the whole
           board is visible without scrolling sideways. Bootstrap's grid already
           lays out the stat rows on this page, so no new layout CSS is needed. *@
        <div class="row g-3 mb-4">
            @foreach (var d in Model.Directors)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="director-strip-card h-100 d-flex flex-column" data-din="@d.Din" data-name="@d.Name">
                        <div class="expand-hint"><i class="bi bi-arrows-fullscreen"></i></div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="director-avatar">@d.Initials</div>
                            <div>
                                <h6 class="director-name">@d.Name</h6>
                                <p class="director-meta">@(d.IsActive ? "Active Director" : "Former Director")</p>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="din-badge">DIN: @d.Din</span>
                            <span class="pill-type"><i class="bi bi-patch-check-fill me-1"></i>DIN Verified</span>
                        </div>
                        @* Facts as a dotted bullet list in the reference card's
                           format, rather than the ruled label/value rows this card
                           used before. The dots reuse the existing .status-dot
                           swatches, so the colour already means the same thing here
                           as everywhere else on the page. *@
                        <ul class="director-facts list-unstyled mb-0">
                            <li><span class="status-dot green"></span>Appointed<strong>@d.AppointedText</strong></li>
                            <li>
                                <span class="status-dot @(d.IsActive ? "green" : "grey")"></span>
                                Status<strong>@(d.IsActive ? "Active" : "Ceased")</strong>
                            </li>
                            <li><span class="status-dot green"></span>DIN verified with MCA</li>
                            <li><span class="status-dot orange"></span>Click card for full profile</li>
                        </ul>

                        @* Screening actions, footed like the stat row in the reference
                           card: ruled off and pushed to the bottom (mt-auto) so every
                           card in a row ends level. The card itself opens the DIN
                           profile, so these buttons stop the click in McaDetails.js. *@
                        <div class="director-screen mt-auto">
                            <span class="lbl">Board Screening</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="screen-btn" data-screen="ofac" data-din="@d.Din" data-name="@d.Name">
                                    <i class="bi bi-globe2"></i>OFAC
                                </button>
                                <button type="button" class="screen-btn" data-screen="aml" data-din="@d.Din" data-name="@d.Name">
                                    <i class="bi bi-shield-check"></i>AML
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="dash-card mb-4">
            <h6 class="card-heading"><i class="bi bi-card-checklist me-2"></i>Director Verification Matrix</h6>
            <div class="verif-grid">
                @foreach (var item in Model.VerificationItems)
                {
                    <div class="verif-item" style="@(item.Pass ? "" : "border-color:var(--danger-red-soft);")">
                        <i class="bi @(item.Pass ? "bi-check-circle-fill pass" : "bi-x-circle-fill fail")"></i> @item.Label
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ===================== TAB 3: CHARGES ===================== -->
    <div class="tab-panel" id="tab-charges">

        <div class="row g-3 mb-4">
            <div class="col-6 col-md">
                <div class="stat-card"><div class="stat-value">@Model.TotalCharges</div><div class="stat-label">Total Charges</div></div>
            </div>
            <div class="col-6 col-md">
                <div class="stat-card"><div class="stat-value" style="color:var(--warning-orange);">@Model.OpenChargeCount</div><div class="stat-label">Open Charges</div></div>
            </div>
            <div class="col-6 col-md">
                <div class="stat-card"><div class="stat-value">@Model.MaxChargeText</div><div class="stat-label">Largest Charge</div></div>
            </div>
            <div class="col-6 col-md">
                <div class="stat-card"><div class="stat-value">@Model.OldestChargeYear</div><div class="stat-label">Oldest</div></div>
            </div>
            <div class="col-6 col-md">
                <div class="stat-card"><div class="stat-value">@Model.LatestChargeYear</div><div class="stat-label">Latest</div></div>
            </div>
        </div>

        @* Charge amounts by year. Same Chart.js + .aa-chart-wrap contract as
           the Deep Analysis charts, so the sizing and styling match the rest
           of the app. The value axis is logarithmic because amounts span four
           orders of magnitude (₹10L … ₹185Cr) — on a linear axis every charge
           but the largest collapses onto the baseline. *@
        <div class="dash-card mb-4">
            <h6 class="card-heading"><i class="bi bi-bar-chart-line me-2"></i>Charge Timeline</h6>
            @* Swatches rather than colour names: "open" follows the theme accent,
               which is orange on Theme 1 and gold on Theme 2. *@
            <p class="mca2-chart-legend">
                Bar height = charge amount on a log scale
                <span><i class="mca2-swatch open"></i>Open</span>
                <span><i class="mca2-swatch satisfied"></i>Satisfied</span>
            </p>

            @if (Model.Charges.Any(c => c.Amount > 0))
            {
                <div class="aa-chart-wrap"><canvas id="mcaChargeChart"></canvas></div>
            }
            else
            {
                <p class="text-muted mb-0" style="font-size:13px;">No charges to plot.</p>
            }
        </div>

        <div class="dash-card mb-4">
            <h6 class="card-heading mb-3"><i class="bi bi-list-columns-reverse me-2"></i>Charge Details</h6>

            @if (Model.Charges.Count == 0)
            {
                <p class="text-muted mb-0" style="font-size:13px;">No charges registered against this company.</p>
            }
            @foreach (var c in Model.Charges)
            {
                <div class="mca2-accordion-item">
                    <button type="button" class="mca2-accordion-header">
                        <span><i class="bi bi-cash me-2 @c.IconCss"></i>@c.AmountText &middot; <span class="pill-warning ms-2">@c.Status</span></span>
                        <i class="bi bi-chevron-down acc-icon"></i>
                    </button>
                    <div class="mca2-accordion-body">
                        <ul class="profile-list list-unstyled mb-0" style="font-size:13px;">
                            <li><span>Asset Under Charge</span><strong>@c.Asset</strong></li>
                            <li><span>Created On</span><strong>@c.CreatedText</strong></li>
                            <li><span>Modified On</span><strong>@c.ModifiedText</strong></li>
                            <li><span>Security</span><strong>Secured</strong></li>
                            <li class="no-border"><span>Status</span><strong style="color:var(--warning-orange);">@c.Status / Active</strong></li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===================== TAB 4: RISK ANALYSIS ===================== -->
    <div class="tab-panel" id="tab-risk">

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-5">
                <div class="dash-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <h6 class="card-heading w-100"><i class="bi bi-bullseye me-2"></i>Risk Radar</h6>
                    <div class="radar-wrap my-3">
                        <div class="radar-bg"></div>
                        <div class="radar-bg inner"></div>
                        <div class="radar-center">@Model.OverallRiskLabel</div>
                        <div class="radar-label top">Legal</div>
                        <div class="radar-label right">Charges</div>
                        <div class="radar-label bottom">Compliance</div>
                        <div class="radar-label left">Governance</div>
                        <div class="radar-dot" style="@Model.LegalDotStyle"></div>
                        <div class="radar-dot" style="@Model.ChargesDotStyle"></div>
                        <div class="radar-dot" style="@Model.ComplianceDotStyle"></div>
                        <div class="radar-dot" style="@Model.GovernanceDotStyle"></div>
                    </div>
                    <div class="d-flex gap-3 flex-wrap justify-content-center mt-2" style="font-size:11px;">
                        <span><span class="status-dot green"></span> Low Risk</span>
                        <span><span class="status-dot orange"></span> Moderate</span>
                        <span><span class="status-dot red"></span> High Risk</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="dash-card h-100">
                    <h6 class="card-heading"><i class="bi bi-speedometer me-2"></i>Risk Breakdown</h6>

                    <div class="d-flex flex-wrap gap-4 justify-content-center mb-4 pb-3" style="border-bottom:1px solid var(--brand-tint-bg-2);">
                        @foreach (var (label, pct) in new[] { ("Legal", Model.LegalPct), ("Governance", Model.GovernancePct), ("Charges", Model.ChargesPct), ("Compliance", Model.CompliancePct) })
                        {
                            var stroke = pct >= 80 ? "var(--success-green)" : pct >= 60 ? "var(--warning-orange)" : "var(--danger-red)";
                            <div class="text-center">
                                <div class="mini-donut mx-auto">
                                    <svg viewBox="0 0 80 80">
                                        <circle class="track" cx="40" cy="40" r="32"></circle>
                                        <circle class="fill" cx="40" cy="40" r="32" stroke="@stroke"
                                                stroke-dasharray="201" stroke-dashoffset="@(201 - 201 * pct / 100)"></circle>
                                    </svg>
                                    <div class="center-text">@pct%</div>
                                </div>
                                <div style="font-size:11px; font-weight:700; color:var(--text-muted-2); margin-top:6px;">@label</div>
                            </div>
                        }
                    </div>

                    @foreach (var (label, pct) in new[] { ("Legal", Model.LegalPct), ("Governance", Model.GovernancePct), ("Charges", Model.ChargesPct), ("Compliance", Model.CompliancePct) })
                    {
                        var bar = pct >= 80 ? "bar-green" : pct >= 60 ? "bar-orange" : "bar-red";
                        <div class="risk-meter-row">
                            <span class="risk-meter-label">@label</span>
                            <div class="risk-meter-bar-bg"><div class="risk-meter-bar-fill @bar" style="width:@(pct)%;"></div></div>
                        </div>
                    }

                    <div class="text-center mt-4 pt-3" style="border-top:1px solid var(--brand-tint-bg-2);">
                        <div class="risk-overall-badge"><i class="bi bi-shield-check"></i> Overall: @Model.OverallRiskLabel</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-card mb-4">
            <h6 class="card-heading"><i class="bi bi-stars me-2"></i>AI Corporate Insights</h6>
            <div class="score-observations">
                <ul class="list-unstyled mb-0" style="font-size:13px; line-height:1.8; color:#4a4a4a;">
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Corporate credibility is <strong>@Model.RiskLabel.Replace(" Risk", "")</strong> (@Model.Score/100).</li>
                    <li class="mb-2"><i class="bi @(Model.IsActive ? "bi-check2 text-success" : "bi-exclamation-triangle text-danger") me-2"></i>The company is @Model.Status and legally registered.</li>
                    <li class="mb-2"><i class="bi @(Model.HasCirp ? "bi-exclamation-triangle text-danger" : "bi-check2 text-success") me-2"></i>@(Model.HasCirp ? "CIRP proceedings detected." : "No insolvency records detected.")</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>All directors appear active.</li>
                    @if (Model.OpenChargeCount > 0)
                    {
                        <li class="mb-2"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Company currently carries <strong>secured financial charges</strong> (@Model.TotalOpenAmountText open).</li>
                    }
                    <li><i class="bi bi-arrow-right-circle text-primary me-2"></i>Suitable for further <strong>GST and Banking</strong> assessment.</li>
                </ul>
            </div>
        </div>
    </div>

</div>

<!-- ===== DIRECTOR DIN DETAIL MODAL (populated via /Mca/GetDinDetail) ===== -->
