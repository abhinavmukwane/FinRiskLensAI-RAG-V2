            <h6 class="drawer-section-title">Contact Information</h6>
            <ul class="drawer-detail-list">
                <li><span>Email</span><strong id="dinEmail">—</strong></li>
                <li><span>Present Address</span><strong id="dinPresentAddress">—</strong></li>
                <li><span>Permanent Address</span><strong id="dinPermanentAddress">—</strong></li>
            </ul>
            <h6 class="drawer-section-title">Directorship Details</h6>
            <ul class="drawer-detail-list">
                <li><span>DIN</span><strong id="dinDinValue">—</strong></li>
                <li><span>Appointed On</span><strong id="dinAppointedOn">—</strong></li>
                <li><span>Director Since</span><strong id="dinDirectorSince">—</strong></li>
                <li><span>Companies</span><strong id="dinCompanies">—</strong></li>
